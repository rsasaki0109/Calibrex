                    "current": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "prior",
                    "current"
                  ],
                  "additionalProperties": false
                },
                "write": {
                  "type": "object",
                  "properties": {
                    "prior": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "current": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "prior",
                    "current"
                  ],
                  "additionalProperties": false
                },
                "atomic": {
                  "type": "object",
                  "properties": {
                    "prior": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "current": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "prior",
                    "current"
                  ],
                  "additionalProperties": false
