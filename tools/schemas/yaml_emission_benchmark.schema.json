            "verified_workers": {
              "type": "integer",
              "minimum": 4
            },
            "full_exports": {
              "type": "integer",
              "minimum": 8
            },
            "complete_values_types_order_exact": {
              "const": true
            },
            "runtime_source_changes": {
              "const": [
                "calibrex/core/io.py"
              ]
            }
          },
          "required": [
            "seconds_median",
            "speedup",
            "verified_workers",
            "full_exports",
            "complete_values_types_order_exact",
            "runtime_source_changes"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "protocol_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "attempts_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "protocol_sha256",
            "attempts_sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "payload",
        "provenance"
      ],
      "additionalProperties": false
    }
  ]
