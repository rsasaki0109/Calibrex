{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calibrex.dev/tools/schemas/yaml_emission_benchmark.schema.json",
  "title": "Complete safe YAML export of the public TUM result",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "slac.yaml_emission_benchmark/v0.1"
        },
        "record_type": {
          "const": "protocol"
        },
        "payload": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string"
            },
            "commits": {
              "type": "object",
              "properties": {
                "prior": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "current": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                }
              },
              "required": [
                "prior",
                "current"
              ],
              "additionalProperties": false
            },
            "repetitions": {
              "type": "integer",
              "minimum": 2
            },
            "environment": {
              "type": "object",
              "properties": {
                "python": {
                  "type": "string"
                },
                "pyyaml": {
                  "type": "string"
                },
                "libyaml": {
                  "const": true
                }
              },
              "required": [
                "python",
                "pyyaml",
                "libyaml"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "scope",
            "commits",
            "repetitions",
            "environment"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "files": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "required": [
            "files"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "payload",
        "provenance"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "slac.yaml_emission_benchmark/v0.1"
        },
        "record_type": {
          "const": "worker"
        },
        "payload": {
          "type": "object",
          "properties": {
            "methods": {
              "type": "object",
              "properties": {
                "write": {
                  "type": "object",
                  "properties": {
                    "seconds": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "size_bytes": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "seconds",
                    "sha256",
                    "size_bytes"
                  ],
                  "additionalProperties": false
                },
                "atomic": {
                  "type": "object",
                  "properties": {
                    "seconds": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "size_bytes": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "seconds",
                    "sha256",
                    "size_bytes"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "write",
                "atomic"
              ],
              "additionalProperties": false
            },
            "native_emissions": {
              "type": "integer",
              "minimum": 0
            },
            "input_fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "imports": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              }
            },
            "environment": {
              "type": "object",
              "properties": {
                "python": {
                  "type": "string"
                },
                "pyyaml": {
                  "type": "string"
                },
                "libyaml": {
                  "const": true
                }
              },
              "required": [
                "python",
                "pyyaml",
                "libyaml"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "methods",
            "native_emissions",
            "input_fingerprint",
            "imports",
            "environment"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "protocol_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "git_commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "variant": {
              "enum": [
                "prior",
                "current"
              ]
            },
            "pid": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "protocol_sha256",
            "git_commit",
            "variant",
            "pid"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "payload",
        "provenance"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "slac.yaml_emission_benchmark/v0.1"
        },
        "record_type": {
          "const": "attempts"
        },
        "payload": {
          "type": "object",
          "properties": {
            "attempts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "folder": {
                    "type": "string"
                  },
                  "variant": {
                    "enum": [
                      "prior",
                      "current"
                    ]
                  },
                  "seconds": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "exit_code": {
                    "type": "integer"
                  }
                },
                "required": [
                  "folder",
                  "variant",
                  "seconds",
                  "exit_code"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "attempts"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "protocol_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "protocol_sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "payload",
        "provenance"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "slac.yaml_emission_benchmark/v0.1"
        },
