            "speedup": {
              "type": "object",
              "properties": {
                "whole": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "write": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "atomic": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "whole",
                "write",
                "atomic"
              ],
              "additionalProperties": false
