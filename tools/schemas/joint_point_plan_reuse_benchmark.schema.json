{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calibrex.dev/tools/schemas/joint_point_plan_reuse_benchmark.schema.json",
  "title": "Complete public Livox guarded point-plan reuse benchmark",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "slac.joint_point_plan_reuse_benchmark/v0.1"
        },
        "record_type": {
          "const": "protocol"
        },
        "payload": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string"
            },
            "commits": {
              "type": "object",
              "properties": {
                "prior": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "current": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                }
              },
              "required": [
                "prior",
                "current"
              ],
              "additionalProperties": false
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "size_bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "point_count": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "name",
                  "sha256",
                  "size_bytes",
                  "point_count"
                ],
                "additionalProperties": false
              }
            },
            "repetitions": {
              "type": "integer",
              "minimum": 2
            },
            "blas_threads": {
              "const": 1
            },
            "environment": {
              "type": "object",
              "properties": {
                "python": {
                  "type": "string"
                },
                "packages": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "python",
                "packages"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "scope",
            "commits",
            "inputs",
            "repetitions",
            "blas_threads",
            "environment"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "files": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "required": [
            "files"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "payload",
        "provenance"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "slac.joint_point_plan_reuse_benchmark/v0.1"
        },
        "record_type": {
          "const": "attempts"
        },
        "payload": {
          "type": "object",
          "properties": {
            "attempts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "folder": {
                    "type": "string"
                  },
                  "variant": {
                    "enum": [
                      "prior",
                      "current"
                    ]
                  },
                  "seconds": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "exit_code": {
                    "type": "integer"
                  }
                },
                "required": [
                  "folder",
                  "variant",
                  "seconds",
                  "exit_code"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "attempts"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "protocol_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "protocol_sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "payload",
        "provenance"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "slac.joint_point_plan_reuse_benchmark/v0.1"
        },
        "record_type": {
          "const": "measurement"
        },
        "payload": {
          "type": "object",
          "properties": {
            "api_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "imports": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              }
            },
            "result_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "history_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "iterations": {
              "type": "integer",
              "minimum": 0
            },
            "observation_count": {
              "type": "integer",
              "minimum": 0
            },
            "status": {
              "type": "string"
            },
            "preparation_calls": {
              "type": "integer",
              "minimum": 1
            },
            "plan_builds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "api_seconds",
            "imports",
            "result_sha256",
            "history_sha256",
            "iterations",
            "observation_count",
            "status",
            "preparation_calls",
            "plan_builds"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "protocol_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "git_commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "git_commit_short": {
              "type": "string",
              "pattern": "^[a-f0-9]{4,40}$"
            }
          },
          "required": [
            "protocol_sha256",
            "git_commit",
            "git_commit_short"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "payload",
        "provenance"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "slac.joint_point_plan_reuse_benchmark/v0.1"
        },
        "record_type": {
          "const": "history"
        },
        "payload": {
          "type": "object",
          "properties": {
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "linearize",
                      "residuals"
                    ]
                  },
                  "factor_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "values": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "factor_ids_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "residual": {
                    "type": "object",
                    "properties": {
                      "shape": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "shape",
                      "sha256"
                    ],
                    "additionalProperties": false
                  },
                  "jacobian": {
                    "type": "object",
                    "properties": {
                      "shape": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "shape",
                      "sha256"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "kind",
                  "factor_count",
                  "values",
                  "factor_ids_sha256",
                  "residual"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "linearize"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "jacobian"
                      ]
                    },
                    "else": {
                      "not": {
                        "required": [
                          "jacobian"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          },
          "required": [
            "events"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "protocol_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "git_commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "git_commit_short": {
              "type": "string",
              "pattern": "^[a-f0-9]{4,40}$"
            }
          },
          "required": [
            "protocol_sha256",
            "git_commit",
            "git_commit_short"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "payload",
        "provenance"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "slac.joint_point_plan_reuse_benchmark/v0.1"
        },
        "record_type": {
          "const": "report"
        },
        "payload": {
          "type": "object",
          "properties": {
            "whole_seconds_median": {
              "type": "object",
              "properties": {
                "prior": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "current": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "prior",
                "current"
              ],
              "additionalProperties": false
            },
            "api_seconds_median": {
              "type": "object",
              "properties": {
                "prior": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "current": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "prior",
                "current"
              ],
              "additionalProperties": false
            },
            "whole_speedup": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "api_speedup": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "verified_runs": {
              "type": "integer",
              "minimum": 0
            },
            "observations": {
              "type": "integer",
              "minimum": 0
            },
            "joint_iterations": {
              "type": "integer",
              "minimum": 0
            },
            "jacobian_calls": {
              "type": "integer",
              "minimum": 0
            },
            "residual_calls": {
              "type": "integer",
              "minimum": 0
            },
            "complete_results_exact": {
              "const": true
            },
            "all_array_digests_exact": {
              "const": true
            },
            "runtime_source_changes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "preparation_calls_per_run": {
              "const": 106
            },
            "plan_builds_per_run": {
              "const": {
                "prior": 106,
                "current": 2
              }
            }
          },
          "required": [
            "whole_seconds_median",
            "api_seconds_median",
            "whole_speedup",
            "api_speedup",
            "verified_runs",
            "observations",
            "joint_iterations",
            "jacobian_calls",
            "residual_calls",
            "complete_results_exact",
            "all_array_digests_exact",
            "runtime_source_changes",
            "preparation_calls_per_run",
            "plan_builds_per_run"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "protocol_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "attempts_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "protocol_sha256",
            "attempts_sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "payload",
        "provenance"
      ],
      "additionalProperties": false
    }
  ]
}
