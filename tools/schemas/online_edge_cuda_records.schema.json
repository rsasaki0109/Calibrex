        "result_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "imported_source_sha256": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "image_kernel_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "software": {
          "type": "object",
          "required": [
            "python",
            "numpy"
          ],
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "cuda_cache_empty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "cuda_driver_cache_disabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "provenance": {
          "type": "object",
          "properties": {
            "created_at": {
              "type": "string",
              "minLength": 1
            },
            "source_commit": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "base_git_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "source_kind": {
              "enum": [
                "git-commit",
                "working-copy"
              ]
            }
          },
          "required": [
            "created_at",
            "source_commit",
            "base_git_commit",
            "source_kind"
          ],
          "additionalProperties": true,
          "allOf": [
            {
              "if": {
                "properties": {
                  "source_kind": {
                    "const": "git-commit"
                  }
                }
