{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen online edge performance records",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "protocol"
        },
        "source_commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "toolchain_sha256": {
          "type": "object",
          "minProperties": 7,
          "maxProperties": 7,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "order": {
          "const": [
            "numpy",
            "fused",
            "cuda",
            "cuda",
            "fused",
            "numpy"
          ]
        },
        "blas_threads": {
          "const": 1
        },
        "warmups": {
          "const": 0
        },
        "host_reserved": {
          "const": false
        },
        "whole_worker_gate": {
          "const": 2.0
        },
        "provenance": {
          "type": "object",
          "properties": {
            "created_at": {
              "type": "string",
              "minLength": 1
            },
            "source_commit": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "base_git_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "source_kind": {
              "enum": [
                "git-commit",
                "working-copy"
              ]
            }
          },
          "required": [
            "created_at",
            "source_commit",
            "base_git_commit",
            "source_kind"
          ],
          "additionalProperties": true,
          "allOf": [
            {
              "if": {
                "properties": {
                  "source_kind": {
                    "const": "git-commit"
                  }
                }
              },
              "then": {
                "properties": {
                  "source_commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "source_kind": {
                    "const": "working-copy"
                  }
                }
              },
              "then": {
                "properties": {
                  "source_commit": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "preparation_workers": {
          "const": 3
        },
        "base_git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_kind": {
          "enum": [
            "git-commit",
            "working-copy"
          ]
        }
      },
      "required": [
        "kind",
        "source_commit",
        "source_manifest_sha256",
        "toolchain_sha256",
        "receipt_sha256",
        "order",
        "blas_threads",
        "warmups",
        "host_reserved",
        "whole_worker_gate",
        "provenance",
        "preparation_workers",
        "base_git_commit",
        "source_kind"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "git-commit"
              }
            }
          },
          "then": {
            "properties": {
              "source_commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "working-copy"
              }
            }
          },
          "then": {
            "properties": {
              "source_commit": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "attempts"
        },
        "observations": {
          "type": "array",
