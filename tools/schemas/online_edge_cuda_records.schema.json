              "then": {
                "properties": {
                  "source_commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "source_kind": {
                    "const": "working-copy"
                  }
                }
              },
              "then": {
