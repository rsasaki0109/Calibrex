            "type": "object",
            "properties": {
              "variant": {
                "enum": [
                  "numpy",
                  "fused",
                  "cuda"
                ]
              },
              "worker": {
                "type": "string",
                "minLength": 1
              },
              "seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "exit_code": {
                "type": "integer"
              }
            },
            "required": [
              "variant",
              "worker",
              "seconds",
              "exit_code"
            ],
            "additionalProperties": false
          }
        },
        "provenance": {
          "type": "object",
          "properties": {
            "created_at": {
              "type": "string",
              "minLength": 1
            },
            "source_commit": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "base_git_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "source_kind": {
              "enum": [
                "git-commit",
                "working-copy"
              ]
            }
          },
          "required": [
            "created_at",
            "source_commit",
            "base_git_commit",
            "source_kind"
          ],
          "additionalProperties": true,
          "allOf": [
            {
              "if": {
                "properties": {
                  "source_kind": {
                    "const": "git-commit"
                  }
                }
              },
              "then": {
                "properties": {
                  "source_commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "source_kind": {
                    "const": "working-copy"
                  }
                }
              },
              "then": {
                "properties": {
                  "source_commit": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "kind",
        "observations",
        "provenance"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "comparison"
        },
        "complete_results_exact": {
          "const": true
