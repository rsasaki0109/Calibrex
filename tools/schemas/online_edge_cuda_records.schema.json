            "numpy": {
              "type": "number",
              "minimum": 0
            },
            "fused": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "numpy",
            "fused"
          ],
          "additionalProperties": false
        },
        "passes_gate": {
          "type": "boolean"
        },
        "source_binding_git_verified": {
          "type": "boolean"
        },
        "result_sha256": {
          "type": "object",
          "minProperties": 12,
          "maxProperties": 12,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "provenance": {
          "type": "object",
          "properties": {
            "created_at": {
              "type": "string",
              "minLength": 1
            },
            "source_commit": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "base_git_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "source_kind": {
              "enum": [
                "git-commit",
                "working-copy"
              ]
            }
          },
          "required": [
            "created_at",
            "source_commit",
            "base_git_commit",
            "source_kind"
          ],
          "additionalProperties": true,
          "allOf": [
            {
              "if": {
                "properties": {
                  "source_kind": {
                    "const": "git-commit"
                  }
                }
              },
              "then": {
                "properties": {
                  "source_commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "source_kind": {
                    "const": "working-copy"
                  }
                }
              },
              "then": {
                "properties": {
                  "source_commit": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "kind",
        "complete_results_exact",
        "prepared_snapshots_exact",
        "observation_count",
        "whole_worker_median_seconds",
        "ratios",
        "passes_gate",
        "source_binding_git_verified",
        "result_sha256",
        "provenance"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "preparation_seconds": {
          "type": "number",
          "minimum": 0
        },
        "solve_and_save_seconds": {
          "type": "number",
          "minimum": 0
        },
        "frame_points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "frame_id": {
                "type": "string",
                "minLength": 1
              },
              "points": {
                "const": 2000
              },
              "rings": {
                "type": "integer",
                "minimum": 0
              },
              "fraction_on_ring": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "frame_id",
              "points",
              "rings",
              "fraction_on_ring"
            ],
            "additionalProperties": false
          },
          "minItems": 48,
          "maxItems": 48
        },
        "evaluations": {
          "type": "integer",
          "minimum": 0
        },
        "point_rows": {
          "type": "integer",
          "minimum": 0
        },
        "timeline_steps": {
          "const": 30
        },
        "functions": {
          "const": []
