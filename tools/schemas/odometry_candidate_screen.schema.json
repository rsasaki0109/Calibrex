{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rejected CUDA odometry candidate screening evidence",
  "type": "object",
  "required": ["schema_version", "decision", "source_commit", "bag_sha256", "observations", "cohorts", "comparisons", "provenance"],
  "properties": {
    "schema_version": {"const": "slac.odometry_candidate_screen/v0.1"},
    "decision": {"const": "no_candidate_adopted"},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "bag_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observations": {"const": 744},
    "provenance": {
      "type": "object",
      "required": ["source_manifest_sha256", "publisher_sha256", "profile_parent_sha256"],
      "properties": {
        "source_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "publisher_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "profile_parent_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "cohorts": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["name", "cases", "variants", "repeats", "scopes", "quality"],
        "properties": {
          "name": {"enum": ["voxels", "layout", "radix", "ordering", "batching"]},
          "cases": {"type": "array", "minItems": 8, "maxItems": 16, "uniqueItems": true, "items": {"type": ["integer", "string"]}},
          "variants": {"type": "array", "minItems": 2, "maxItems": 4, "uniqueItems": true, "items": {"type": "string"}},
          "repeats": {"enum": [5, 7]},
          "quality": {"enum": ["exact", "numeric"]},
          "scopes": {
            "type": "array", "minItems": 1, "maxItems": 2,
            "items": {
              "type": "object", "required": ["name", "first_repeat"],
              "properties": {
                "name": {"enum": ["raw", "processed", "target_and_registration"]},
                "first_repeat": {"enum": [0, 1]},
                "case_prefix": {"enum": ["raw", "processed"]}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "comparisons": {
      "type": "array", "minItems": 11, "maxItems": 11,
      "items": {
        "type": "object",
        "required": ["cohort", "scope", "variant", "prior_seconds", "candidate_seconds", "speedup"],
        "properties": {
          "cohort": {"type": "string"},
          "scope": {"enum": ["raw", "processed", "target_and_registration"]},
          "variant": {"type": "string"},
          "prior_seconds": {"type": "number", "exclusiveMinimum": 0},
          "candidate_seconds": {"type": "number", "exclusiveMinimum": 0},
          "speedup": {"type": "number", "exclusiveMinimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
