{
  "$defs": {
    "CalibrationFixtureProvenance": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "calibrex.browser_webgpu_calibration_fixture/v0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "source_head": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Head",
          "type": "string"
        },
        "generator": {
          "title": "Generator",
          "type": "string"
        },
        "sources": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Sources",
          "type": "object"
        },
        "accuracy_claim": {
          "const": false,
          "title": "Accuracy Claim",
          "type": "boolean"
        },
        "origin": {
          "additionalProperties": true,
          "title": "Origin",
          "type": "object"
        },
        "frames": {
          "maximum": 48,
          "minimum": 1,
          "title": "Frames",
          "type": "integer"
        },
        "estimate_translation": {
          "title": "Estimate Translation",
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "created_at",
        "source_head",
        "generator",
        "sources",
        "accuracy_claim",
        "origin",
        "frames",
        "estimate_translation"
      ],
      "title": "CalibrationFixtureProvenance",
      "type": "object"
    },
    "CameraLidarEdgeArtifact": {
      "additionalProperties": false,
      "description": "Evidence for one targetless camera-LiDAR extrinsic estimate.",
      "properties": {
        "schema_version": {
          "const": "slac.camera_lidar_edge/v0.1",
          "default": "slac.camera_lidar_edge/v0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "method": {
          "const": "edge_alignment/v0.1",
          "default": "edge_alignment/v0.1",
          "title": "Method",
          "type": "string"
        },
        "solver_status": {
          "enum": [
            "converged",
            "max_iterations",
            "insufficient_samples"
          ],
          "title": "Solver Status",
          "type": "string"
        },
        "policy_status": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "inconclusive"
          ],
          "title": "Policy Status",
          "type": "string"
        },
        "policy_reasons": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Policy Reasons",
          "type": "array"
        },
        "calibrated_dofs": {
          "items": {
            "enum": [
              "roll",
              "pitch",
              "yaw",
              "x",
              "y",
              "z"
            ],
            "type": "string"
          },
          "title": "Calibrated Dofs",
          "type": "array"
        },
        "transform": {
          "anyOf": [
            {
              "$ref": "#/$defs/CameraLidarEdgeTransform"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "start_transform": {
          "anyOf": [
            {
              "$ref": "#/$defs/CameraLidarEdgeTransform"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dofs": {
          "items": {
            "$ref": "#/$defs/CameraLidarEdgeDofRecord"
          },
          "title": "Dofs",
          "type": "array"
        },
        "objective": {
          "anyOf": [
            {
              "$ref": "#/$defs/CameraLidarEdgeObjective"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "samples": {
          "$ref": "#/$defs/CameraLidarEdgeSamples"
        },
        "motion_compensation": {
          "anyOf": [
            {
              "$ref": "#/$defs/CameraLidarEdgeMotion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "jackknife_fits": {
          "minimum": 0,
          "title": "Jackknife Fits",
          "type": "integer"
        },
        "camera": {
          "additionalProperties": true,
          "title": "Camera",
          "type": "object"
        },
        "options": {
          "additionalProperties": true,
          "title": "Options",
          "type": "object"
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/CameraLidarEdgeProvenance"
        },
        "start_disagreement_deg": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "propertyNames": {
                "enum": [
                  "roll",
                  "pitch",
                  "yaw",
                  "x",
                  "y",
                  "z"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "rotation DoFs withheld by the opt-in cross-start agreement rule, with the largest difference (deg) between the final optimum and another evidenced optimum; absent when the rule is off or nothing was withheld",
          "title": "Start Disagreement Deg"
        }
      },
      "required": [
        "solver_status",
        "policy_status",
        "policy_reasons",
        "calibrated_dofs",
        "dofs",
        "samples",
        "jackknife_fits",
        "options",
        "provenance"
      ],
      "title": "CameraLidarEdgeArtifact",
      "type": "object"
    },
    "CameraLidarEdgeControl": {
      "additionalProperties": false,
      "description": "Held-out objective drop after shifting one DoF of the fit in both directions.",
      "properties": {
        "amount": {
          "title": "Amount",
          "type": "number"
        },
        "unit": {
          "enum": [
            "deg",
            "m"
          ],
          "title": "Unit",
          "type": "string"
        },
        "held_out_blocks": {
          "minimum": 0,
          "title": "Held Out Blocks",
          "type": "integer"
        },
        "detected_blocks": {
          "minimum": 0,
          "title": "Detected Blocks",
          "type": "integer"
        },
        "mean_objective_drop": {
          "title": "Mean Objective Drop",
          "type": "number"
        },
        "min_t_statistic": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "smaller of the two directions' one-sided t statistics of the per-block objective drops",
          "title": "Min T Statistic"
        },
        "detected": {
          "title": "Detected",
          "type": "boolean"
        }
      },
      "required": [
        "amount",
        "unit",
        "held_out_blocks",
        "detected_blocks",
        "mean_objective_drop",
        "detected"
      ],
      "title": "CameraLidarEdgeControl",
      "type": "object"
    },
    "CameraLidarEdgeDofRecord": {
      "additionalProperties": false,
      "description": "One DoF of ``T_camera_lidar`` with its uncertainty and evidence.",
      "properties": {
        "name": {
          "enum": [
            "roll",
            "pitch",
            "yaw",
            "x",
            "y",
            "z"
          ],
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "enum": [
            "deg",
            "m"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "delta_from_start": {
          "description": "estimate minus the start (candidate) in the DoF's unit; rotation DoFs are the rotation vector of the left correction in the camera frame",
          "title": "Delta From Start",
          "type": "number"
        },
        "std_jackknife": {
          "minimum": 0.0,
          "title": "Std Jackknife",
          "type": "number"
        },
        "std_reported": {
          "minimum": 0.0,
          "title": "Std Reported",
          "type": "number"
        },
        "status": {
          "enum": [
            "estimated",
            "unobservable"
          ],
          "title": "Status",
          "type": "string"
        },
        "at_search_bound": {
          "default": false,
          "title": "At Search Bound",
          "type": "boolean"
        },
        "reference_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Value"
        },
        "error_to_reference": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error To Reference"
        },
        "known_bad_control": {
          "anyOf": [
            {
              "$ref": "#/$defs/CameraLidarEdgeControl"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "unit",
        "value",
        "delta_from_start",
        "std_jackknife",
        "std_reported",
        "status"
      ],
      "title": "CameraLidarEdgeDofRecord",
      "type": "object"
    },
    "CameraLidarEdgeMotion": {
      "additionalProperties": false,
      "description": "How the LiDAR points were moved to the image time with the rig's measured motion.",
      "properties": {
        "source_topic": {
          "title": "Source Topic",
          "type": "string"
        },
        "kind": {
          "description": "twist: an odometry or twist topic (rotation and translation); gyro: an IMU (rotation only)",
          "enum": [
            "twist",
            "gyro"
          ],
          "title": "Kind",
          "type": "string"
        },
        "per_point_time": {
          "description": "whether each point was moved by its own measurement time (otherwise by the scan's reference time)",
          "title": "Per Point Time",
          "type": "boolean"
        },
        "frames_moved": {
          "minimum": 0,
          "title": "Frames Moved",
          "type": "integer"
        },
        "frames_without_motion": {
          "description": "frames kept as recorded because no motion sample was near",
          "minimum": 0,
          "title": "Frames Without Motion",
          "type": "integer"
        },
        "median_rotation_deg": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "rotation applied at the scan's reference time",
          "title": "Median Rotation Deg"
        },
        "max_rotation_deg": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Rotation Deg"
        },
        "median_translation_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "translation applied at the scan's reference time",
          "title": "Median Translation M"
        },
        "max_translation_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Translation M"
        }
      },
      "required": [
        "source_topic",
        "kind",
        "per_point_time",
        "frames_moved",
        "frames_without_motion"
      ],
      "title": "CameraLidarEdgeMotion",
      "type": "object"
    },
    "CameraLidarEdgeObjective": {
      "additionalProperties": false,
      "description": "The edge-alignment objective at the start and at the estimate.",
      "properties": {
        "start": {
          "title": "Start",
          "type": "number"
        },
        "estimate": {
          "title": "Estimate",
          "type": "number"
        },
        "gain": {
          "title": "Gain",
          "type": "number"
        }
      },
      "required": [
        "start",
        "estimate",
        "gain"
      ],
      "title": "CameraLidarEdgeObjective",
      "type": "object"
    },
    "CameraLidarEdgeProvenance": {
      "additionalProperties": false,
      "description": "Inputs and generator lineage.",
      "properties": {
        "generator": {
          "title": "Generator",
          "type": "string"
        },
        "generator_version": {
          "title": "Generator Version",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "dataset_family": {
          "title": "Dataset Family",
          "type": "string"
        },
        "sequence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Sequence Ids",
          "type": "array"
        },
        "image_topic": {
          "title": "Image Topic",
          "type": "string"
        },
        "lidar_topic": {
          "title": "Lidar Topic",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "input_digest_scope": {
          "title": "Input Digest Scope",
          "type": "string"
        },
        "dataset_license": {
          "title": "Dataset License",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "generator",
        "generator_version",
        "dataset_family",
        "sequence_ids",
        "image_topic",
        "lidar_topic",
        "input_sha256",
        "input_digest_scope",
        "dataset_license"
      ],
      "title": "CameraLidarEdgeProvenance",
      "type": "object"
    },
    "CameraLidarEdgeSamples": {
      "additionalProperties": false,
      "description": "The synchronized frames the estimate rests on.",
      "properties": {
        "frames": {
          "minimum": 0,
          "title": "Frames",
          "type": "integer"
        },
        "edge_points": {
          "minimum": 0,
          "title": "Edge Points",
          "type": "integer"
        },
        "blocks": {
          "minimum": 0,
          "title": "Blocks",
          "type": "integer"
        },
        "median_abs_time_gap_s": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median Abs Time Gap S"
        },
        "max_abs_time_gap_s": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Abs Time Gap S"
        },
        "first_frame_time_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Frame Time S"
        },
        "last_frame_time_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Frame Time S"
        },
        "median_rings": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median Rings"
        }
      },
      "required": [
        "frames",
        "edge_points",
        "blocks"
      ],
      "title": "CameraLidarEdgeSamples",
      "type": "object"
    },
    "CameraLidarEdgeTransform": {
      "additionalProperties": false,
      "description": "``T_camera_lidar`` as translation and quaternion.",
      "properties": {
        "parent_frame": {
          "title": "Parent Frame",
          "type": "string"
        },
        "child_frame": {
          "title": "Child Frame",
          "type": "string"
        },
        "translation_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Translation M",
          "type": "array"
        },
        "rotation_quat_xyzw": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Rotation Quat Xyzw",
          "type": "array"
        }
      },
      "required": [
        "parent_frame",
        "child_frame",
        "translation_m",
        "rotation_quat_xyzw"
      ],
      "title": "CameraLidarEdgeTransform",
      "type": "object"
    },
    "_Attempt": {
      "additionalProperties": false,
      "properties": {
        "repetition": {
          "minimum": 0,
          "title": "Repetition",
          "type": "integer"
        },
        "order": {
          "items": {
            "enum": [
              "cpu",
              "gpu"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Order",
          "type": "array"
        },
        "cpu": {
          "$ref": "#/$defs/_BackendRun"
        },
        "gpu": {
          "$ref": "#/$defs/_BackendRun"
        },
        "comparison": {
          "$ref": "#/$defs/_Comparison"
        },
        "ratio": {
          "exclusiveMinimum": 0,
          "title": "Ratio",
          "type": "number"
        },
        "untraced_ratio": {
          "exclusiveMinimum": 0,
          "title": "Untraced Ratio",
          "type": "number"
        }
      },
      "required": [
        "repetition",
        "order",
        "cpu",
        "gpu",
        "comparison",
        "ratio",
        "untraced_ratio"
      ],
      "title": "_Attempt",
      "type": "object"
    },
    "_BackendRun": {
      "additionalProperties": false,
      "properties": {
        "seconds": {
          "exclusiveMinimum": 0,
          "title": "Seconds",
          "type": "number"
        },
        "artifact": {
          "$ref": "#/$defs/CameraLidarEdgeArtifact"
        },
        "trace": {
          "$ref": "#/$defs/_TraceSummary"
        },
        "untraced_seconds": {
          "exclusiveMinimum": 0,
          "title": "Untraced Seconds",
          "type": "number"
        },
        "untraced_artifact": {
          "$ref": "#/$defs/CameraLidarEdgeArtifact"
        }
      },
      "required": [
        "seconds",
        "artifact",
        "trace",
        "untraced_seconds",
        "untraced_artifact"
      ],
      "title": "_BackendRun",
      "type": "object"
    },
    "_BenchmarkProvenance": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Command",
          "type": "array"
        },
        "source_head": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Head",
          "type": "string"
        },
        "source_worktree_dirty": {
          "title": "Source Worktree Dirty",
          "type": "boolean"
        },
        "sources": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Sources",
          "type": "object"
        },
        "pyodide_version": {
          "const": "0.27.2",
          "title": "Pyodide Version",
          "type": "string"
        },
        "whole_calibration_claim": {
          "const": false,
          "title": "Whole Calibration Claim",
          "type": "boolean"
        },
        "browser_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Browser Version"
        }
      },
      "required": [
        "created_at",
        "command",
        "source_head",
        "source_worktree_dirty",
        "sources",
        "pyodide_version",
        "whole_calibration_claim"
      ],
      "title": "_BenchmarkProvenance",
      "type": "object"
    },
    "_CalibrationRun": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL"
          ],
          "title": "Status",
          "type": "string"
        },
        "fixture_provenance": {
          "$ref": "#/$defs/CalibrationFixtureProvenance"
        },
        "frames": {
          "maximum": 48,
          "minimum": 1,
          "title": "Frames",
          "type": "integer"
        },
        "raw_points": {
          "minimum": 1,
          "title": "Raw Points",
          "type": "integer"
        },
        "estimate_translation": {
          "title": "Estimate Translation",
          "type": "boolean"
        },
        "input_load_seconds": {
          "minimum": 0,
          "title": "Input Load Seconds",
          "type": "number"
        },
        "cpu_first": {
          "$ref": "#/$defs/_BackendRun"
        },
        "gpu_first": {
          "$ref": "#/$defs/_BackendRun"
        },
        "first_comparison": {
          "$ref": "#/$defs/_Comparison"
        },
        "attempts": {
          "items": {
            "$ref": "#/$defs/_Attempt"
          },
          "minItems": 3,
          "title": "Attempts",
          "type": "array"
        },
        "first_estimator_ratio": {
          "exclusiveMinimum": 0,
          "title": "First Estimator Ratio",
          "type": "number"
        },
        "paired_median_ratio": {
          "exclusiveMinimum": 0,
          "title": "Paired Median Ratio",
          "type": "number"
        },
        "first_untraced_estimator_ratio": {
          "exclusiveMinimum": 0,
          "title": "First Untraced Estimator Ratio",
          "type": "number"
        },
        "paired_median_untraced_ratio": {
          "exclusiveMinimum": 0,
          "title": "Paired Median Untraced Ratio",
          "type": "number"
        },
        "first_traces": {
          "$ref": "#/$defs/_FirstTraces"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "fixture_index": {
          "minimum": 0,
          "title": "Fixture Index",
          "type": "integer"
        },
        "fixture": {
          "title": "Fixture",
          "type": "string"
        }
      },
      "required": [
        "status",
        "fixture_provenance",
        "frames",
        "raw_points",
        "estimate_translation",
        "input_load_seconds",
        "cpu_first",
        "gpu_first",
        "first_comparison",
        "attempts",
        "first_estimator_ratio",
        "paired_median_ratio",
        "first_untraced_estimator_ratio",
        "paired_median_untraced_ratio",
        "first_traces",
        "scope",
        "fixture_index",
