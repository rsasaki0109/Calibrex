{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "provenance", "files"],
  "properties": {
    "schema_version": {"const": "slac.cuda_spatial_candidates_publication/v0.1"},
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["measurement_sha256"],
      "properties": {"measurement_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    },
    "files": {
      "type": "object", "minProperties": 8,
      "propertyNames": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]+$"},
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }
  }
}
