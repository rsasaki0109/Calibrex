{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "files",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "calibrex.kitti360_readiness_publication/v0.1"
    },
    "files": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "source_commit",
        "generator_sha256",
        "policy"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_commit": {
          "const": "036c67ba7dc9eaba878d734430fbea6b8d70abbf"
        },
        "generator_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy": {
          "const": "Unmodified reports and exact producer bytes. Sensor payloads, bags and external scripts stay private; no new accuracy claim."
        }
      }
    }
  }
}
