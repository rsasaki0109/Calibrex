{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Complete CPU spline plane fit publication index",
  "type": "object",
  "required": ["schema_version", "files", "provenance"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "slac.bspline_plane_fit_publication/v0.1"},
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "provenance": {
      "type": "object",
      "required": ["generator", "source_commit", "protocol_sha256", "publisher_sha256", "scope"],
      "additionalProperties": false,
      "properties": {
        "generator": {"type": "string"},
        "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "protocol_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "publisher_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "scope": {"type": "string"}
      }
    }
  }
}
