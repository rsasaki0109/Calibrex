{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Complete fixed-input spline plane fit benchmark",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "slac.bspline_plane_fit_benchmark/v0.1"
    },
    "record_type": {
      "enum": [
        "protocol",
        "worker",
        "attempts",
        "summary"
      ]
    },
    "provenance": {
      "type": "object",
      "minProperties": 1
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "provenance"
  ],
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "record_type": {
          "const": "protocol"
        },
        "repeats": {
          "type": "integer",
          "minimum": 1
        },
        "workers": {
          "type": "integer",
          "minimum": 1
        },
        "quality_tolerances": {
          "type": "object",
          "properties": {
            "rtol": {
              "type": "number"
            },
            "atol": {
              "type": "number"
            }
          },
          "required": [
            "rtol",
            "atol"
          ],
          "additionalProperties": false
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "npz_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "metadata_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "name",
              "npz_sha256",
              "metadata_sha256"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "record_type",
        "repeats",
        "workers",
        "quality_tolerances",
        "inputs"
      ]
    },
    {
      "type": "object",
      "properties": {
        "record_type": {
          "const": "worker"
        },
        "variant": {
          "enum": [
            "numpy",
            "numba_cpu"
          ]
        },
        "runs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "phase": {
                "enum": [
                  "first_use",
                  "warm"
                ]
              },
              "seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "results": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "enum": [
                        "converged",
                        "max_iterations",
                        "singular_system"
                      ]
                    },
                    "iterations": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "initial_cost": {
                      "type": "number"
                    },
                    "final_cost": {
                      "type": "number"
                    },
                    "residual_variance": {
                      "type": "number"
                    },
                    "residual_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "parameter_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "calibration_parameter_names": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "trajectory_rotations": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        }
                      }
                    },
                    "trajectory_positions": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      }
                    },
                    "calibration_covariance": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      }
                    },
                    "execution_backend": {
                      "type": "string"
                    },
                    "calibration": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "imu_rotation": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 3,
                          "maxItems": 3
                        },
                        "gyro_bias": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 3,
                          "maxItems": 3
                        },
                        "lever_arm": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 3,
                          "maxItems": 3
                        },
                        "imu_clock_offset": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 1,
                          "maxItems": 1
                        },
                        "accel_bias": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 3,
                          "maxItems": 3
                        },
                        "gravity": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 3,
                          "maxItems": 3
                        }
                      },
                      "required": [
                        "imu_rotation",
                        "gyro_bias",
                        "lever_arm",
                        "imu_clock_offset",
                        "accel_bias",
                        "gravity"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "iterations",
                    "initial_cost",
                    "final_cost",
                    "residual_variance",
                    "residual_count",
                    "parameter_count",
                    "calibration_parameter_names",
                    "trajectory_rotations",
                    "trajectory_positions",
                    "calibration_covariance",
                    "execution_backend",
                    "calibration"
                  ]
                }
              }
            },
            "required": [
              "phase",
              "seconds",
              "results"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "record_type",
        "variant",
        "runs"
      ]
    },
    {
      "type": "object",
      "properties": {
        "record_type": {
          "const": "attempts"
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repeat": {
                "type": "integer",
                "minimum": 0
              },
              "variant": {
                "enum": [
                  "numpy",
                  "numba_cpu"
                ]
              },
              "worker": {
                "type": "string"
              },
              "whole_seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "exit_code": {
                "type": "integer"
              }
            },
            "required": [
              "repeat",
              "variant",
              "worker",
              "whole_seconds",
              "exit_code"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "record_type",
        "attempts"
      ]
    },
    {
      "type": "object",
      "properties": {
        "record_type": {
          "const": "summary"
        },
        "medians": {
          "type": "object"
        },
        "speedups": {
          "type": "object"
        },
        "quality_passed": {
          "type": "boolean"
        },
        "quality": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "passed": {
                "type": "boolean"
              },
              "exact_decisions": {
                "type": "boolean"
              },
              "max_absolute_errors": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            },
            "required": [
              "passed",
              "exact_decisions",
              "max_absolute_errors"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "record_type",
        "medians",
        "speedups",
        "quality_passed",
        "quality"
      ]
    }
  ]
}
