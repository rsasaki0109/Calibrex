{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "calibrex.readme_gif_gallery/v0.3",
  "title": "Calibrex README GIF gallery manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assets",
    "dimensions",
    "fallback_metadata_allowed",
    "generator",
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": "calibrex.readme_gif_gallery/v0.3"
    },
    "generator": {
      "const": "tools/generate_calibration_evidence_gif.py"
    },
    "fallback_metadata_allowed": {
      "type": "boolean"
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fps", "frames", "height", "width"],
      "properties": {
        "fps": {
          "type": "integer",
          "minimum": 1
        },
        "frames": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metadata_source",
          "output",
          "public_inputs",
          "sensor_pair",
          "sha256",
          "size_bytes",
          "source",
          "source_label",
          "target_label",
          "uses_builtin_metadata_fallback",
          "visual"
        ],
        "properties": {
          "output": {
            "type": "string",
            "pattern": "^docs/assets/[^/]+\\.gif$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "source": {
            "enum": ["a2d2", "livox-horizon-horizon"]
          },
          "visual": {
            "enum": ["evidence", "online"]
          },
          "sensor_pair": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target"],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "source_lidar_id": {
                "type": "integer",
                "minimum": 0
              },
              "target_lidar_id": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "source_label": {
            "type": "string",
            "minLength": 1
          },
          "target_label": {
            "type": "string",
            "minLength": 1
          },
          "metadata_source": {
            "type": "string",
            "minLength": 1
          },
          "uses_builtin_metadata_fallback": {
            "type": "boolean"
          },
          "pipeline": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "source"],
            "properties": {
              "mode": {
                "const": "real_online"
              },
              "source": {
                "const": "calibrex calibrate --online"
              },
              "timeline_schema_version": {
                "const": "calibrex.online_timeline/v0.1"
              }
            }
          },
          "online_run": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "accepted_batch_count",
              "batch_count",
              "final_gate_status",
              "gate_thresholds",
              "inconclusive_batch_count",
              "rejected_batch_count"
            ],
            "properties": {
              "batch_count": {
                "type": "integer",
                "minimum": 0
              },
              "accepted_batch_count": {
                "type": "integer",
                "minimum": 0
              },
              "rejected_batch_count": {
                "type": "integer",
                "minimum": 0
              },
              "inconclusive_batch_count": {
                "type": "integer",
                "minimum": 0
              },
              "final_gate_status": {
                "enum": ["pass", "fail", "inconclusive"]
              },
              "gate_thresholds": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "max_holdout_rmse_m",
                  "max_rolling_regression_m",
                  "min_rank"
                ],
                "properties": {
                  "min_rank": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "max_holdout_rmse_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "max_rolling_regression_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          },
          "public_inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "url"],
              "properties": {
                "kind": {
                  "enum": ["npz_range_from_tar", "pcd_tar_gz", "sensor_metadata_json"]
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "selected_member": {
                  "type": "string",
                  "minLength": 1
                },
                "byte_range": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          }
        }
      }
    }
  }
}
