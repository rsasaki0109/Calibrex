{
  "$id": "https://calibrex.dev/schemas/slac.readme_gif_gallery/v0.3",
  "title": "Calibrex README GIF gallery manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assets",
    "dimensions",
    "fallback_metadata_allowed",
    "generator",
    "schema_version"
  ],
  "$defs": {
    "se3_transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rotation_quat_xyzw", "translation_m"],
      "properties": {
        "translation_m": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "rotation_quat_xyzw": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "slac.readme_gif_gallery/v0.3"
    },
    "generator": {
      "const": "tools/generate_calibration_evidence_gif.py"
    },
    "fallback_metadata_allowed": {
      "type": "boolean"
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fps", "frames", "height", "width"],
      "properties": {
        "fps": {
          "type": "integer",
          "minimum": 1
        },
        "frames": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metadata_source",
          "output",
          "public_inputs",
          "sensor_pair",
          "sha256",
          "size_bytes",
          "source",
          "source_label",
          "target_label",
          "uses_builtin_metadata_fallback",
          "visual"
        ],
        "properties": {
          "output": {
            "type": "string",
            "pattern": "^docs/assets/[^/]+\\.gif$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "source": {
            "enum": ["a2d2", "livox-horizon-horizon", "tiers-lidars-cali", "tiers-indoor02-kissicp"]
          },
          "visual": {
            "enum": ["evidence", "online", "motion", "camera_lidar", "before_after", "time_sweep"]
          },
          "readme_role": {
            "enum": ["hero", "gallery"]
          },
          "sensor_pair": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target"],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "source_lidar_id": {
                "type": "integer",
                "minimum": 0
              },
              "target_lidar_id": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "source_label": {
            "type": "string",
            "minLength": 1
          },
          "target_label": {
            "type": "string",
            "minLength": 1
          },
          "metadata_source": {
            "type": "string",
            "minLength": 1
          },
          "uses_builtin_metadata_fallback": {
            "type": "boolean"
          },
          "pipeline": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "source"],
            "properties": {
              "mode": {
                "const": "real_online"
              },
              "source": {
                "const": "calibrex calibrate --online"
              },
              "timeline_schema_version": {
                "enum": [
                  "slac.online_timeline/v0.2",
                  "slac.online_timeline/v0.3"
                ]
              },
              "config_path": {
                "type": "string",
                "minLength": 1
              },
              "generation_command": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "calibration_replay": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "config_path",
              "initial_transform",
              "limitation",
              "mode",
              "refined_transform",
              "source",
              "transform_convention"
            ],
            "properties": {
              "mode": {
                "const": "algorithmic_refinement_replay"
              },
              "source": {
                "const": "calibrex calibrate"
              },
              "config_path": {
                "type": "string",
                "minLength": 1
              },
              "transform_convention": {
                "type": "string",
                "minLength": 1
              },
              "initial_transform": {
                "$ref": "#/$defs/se3_transform"
              },
              "refined_transform": {
                "$ref": "#/$defs/se3_transform"
              },
              "limitation": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "time_offset_sweep": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "config_path",
              "config_sha256",
              "curve_semantics",
              "dataset_path",
              "dataset_sha256",
              "estimated_offset_s",
              "final_holdout_rmse_m",
              "final_train_rmse_m",
              "initial_offset_s",
              "initial_train_rmse_m",
              "initial_transform",
              "limitation",
              "mode",
              "probes",
              "refined_transform",
              "source",
              "source_sensor",
              "target_sensor",
              "transform_convention"
            ],
            "properties": {
              "mode": {
                "const": "real_solver_candidate_probe"
              },
              "source": {
                "const": "calibrex continuous-time lidar pair"
              },
              "config_path": {
                "type": "string",
                "minLength": 1
              },
              "config_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "dataset_path": {
                "type": "string",
                "minLength": 1
              },
              "dataset_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "source_sensor": {
                "type": "string",
                "minLength": 1
              },
              "target_sensor": {
                "type": "string",
                "minLength": 1
              },
              "transform_convention": {
                "type": "string",
                "minLength": 1
              },
              "initial_offset_s": {
                "type": "number"
              },
              "estimated_offset_s": {
                "type": "number"
              },
              "initial_train_rmse_m": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "final_train_rmse_m": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "final_holdout_rmse_m": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "initial_transform": {
                "$ref": "#/$defs/se3_transform"
              },
              "refined_transform": {
                "$ref": "#/$defs/se3_transform"
              },
              "curve_semantics": {
                "type": "string",
                "minLength": 1
              },
              "limitation": {
                "type": "string",
                "minLength": 1
              },
              "probes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "accepted",
                    "holdout_rmse_m",
                    "iteration",
                    "offset_s",
                    "train_rmse_m"
                  ],
                  "properties": {
                    "offset_s": {
                      "type": "number"
                    },
                    "train_rmse_m": {
                      "type": ["number", "null"],
                      "minimum": 0
                    },
                    "holdout_rmse_m": {
                      "type": ["number", "null"],
                      "minimum": 0
                    },
                    "iteration": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "accepted": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "animation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fps", "frames", "height", "width"],
            "properties": {
              "fps": {
                "type": "integer",
                "minimum": 1
              },
              "frames": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "map_view": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scan_count",
                  "scans_per_animation_frame",
                  "trajectory_bbox_m",
                  "view_window_m"
                ],
                "properties": {
                  "scan_count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "scans_per_animation_frame": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "trajectory_bbox_m": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["x_max", "x_min", "y_max", "y_min"],
                    "properties": {
                      "x_min": { "type": "number" },
                      "x_max": { "type": "number" },
                      "y_min": { "type": "number" },
                      "y_max": { "type": "number" }
                    }
                  },
                  "view_window_m": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["x_max", "x_min", "y_max", "y_min"],
                    "properties": {
                      "x_min": { "type": "number" },
                      "x_max": { "type": "number" },
                      "y_min": { "type": "number" },
                      "y_max": { "type": "number" }
                    }
                  }
                }
              }
            }
          },
          "online_run": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "accepted_batch_count",
              "batch_count",
              "final_gate_status",
              "gate_thresholds",
              "inconclusive_batch_count",
              "rejected_batch_count"
            ],
            "properties": {
              "batch_count": {
                "type": "integer",
                "minimum": 0
              },
              "accepted_batch_count": {
                "type": "integer",
                "minimum": 0
              },
              "rejected_batch_count": {
                "type": "integer",
                "minimum": 0
              },
              "inconclusive_batch_count": {
                "type": "integer",
                "minimum": 0
              },
              "final_gate_status": {
                "enum": ["pass", "fail", "inconclusive"]
              },
              "gate_thresholds": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "max_holdout_rmse_m",
                  "max_rolling_regression_m",
                  "min_rank"
                ],
                "properties": {
                  "min_rank": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "max_holdout_rmse_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "max_rolling_regression_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          },
          "public_inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "url"],
                  "properties": {
                    "kind": {
                      "enum": [
                        "camera_png_from_tar",
                        "npz_range_from_tar",
                        "pcd_tar_gz",
                        "sensor_metadata_json"
                      ]
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "selected_member": {
                      "type": "string",
                      "minLength": 1
                    },
                    "byte_range": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "integer",
                          "minimum": 0
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "url", "bag_file", "replay_budgets"],
                  "properties": {
                    "kind": {
                      "const": "rosbag1_local_dataset"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "bag_file": {
                      "type": "string",
                      "minLength": 1
                    },
                    "size_bytes": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "sha256_first_mib": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "replay_budgets": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "batch_size",
                        "holdout_ratio",
                        "max_replay_duration_s",
                        "max_source_messages",
                        "max_source_points",
                        "max_target_messages",
                        "max_target_points",
                        "rolling_window"
                      ],
                      "properties": {
                        "max_source_messages": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "max_source_points": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "max_target_messages": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "max_target_points": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "max_replay_duration_s": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "batch_size": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "holdout_ratio": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "rolling_window": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "bag_dir", "storage_file", "replay_budgets"],
                  "properties": {
                    "kind": {
                      "const": "rosbag2_local_dataset"
                    },
                    "bag_dir": {
                      "type": "string",
                      "minLength": 1
                    },
                    "storage_file": {
                      "type": "string",
                      "minLength": 1
                    },
                    "size_bytes": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "sha256_first_mib": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "replay_budgets": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["calibration_run", "map_view"],
                      "properties": {
                        "map_view": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "max_replay_duration_s",
                            "max_source_messages",
                            "max_source_points",
                            "subsample_seed"
                          ],
                          "properties": {
                            "max_source_messages": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "max_source_points": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "max_replay_duration_s": {
                              "type": "number",
                              "exclusiveMinimum": 0
                            },
                            "subsample_seed": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
                        "calibration_run": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "batch_size",
                            "holdout_ratio",
                            "max_replay_duration_s",
                            "max_target_messages",
                            "max_target_points",
                            "rolling_window"
                          ],
                          "properties": {
                            "max_target_messages": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "max_target_points": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "max_replay_duration_s": {
                              "type": "number",
                              "exclusiveMinimum": 0
                            },
                            "batch_size": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "holdout_ratio": {
                              "type": "number",
                              "exclusiveMinimum": 0
                            },
                            "rolling_window": {
                              "type": "integer",
                              "minimum": 1
                            }
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
