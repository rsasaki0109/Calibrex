{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slac.readme_gif_gallery/v0.3",
  "title": "slac README GIF gallery manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assets",
    "dimensions",
    "fallback_metadata_allowed",
    "generator",
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": "slac.readme_gif_gallery/v0.3"
    },
    "generator": {
      "const": "tools/generate_calibration_evidence_gif.py"
    },
    "fallback_metadata_allowed": {
      "type": "boolean"
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fps", "frames", "height", "width"],
      "properties": {
        "fps": {
          "type": "integer",
          "minimum": 1
        },
        "frames": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metadata_source",
          "output",
          "public_inputs",
          "sensor_pair",
          "sha256",
          "size_bytes",
          "source",
          "source_label",
          "target_label",
          "uses_builtin_metadata_fallback",
          "visual"
        ],
        "properties": {
          "output": {
            "type": "string",
            "pattern": "^docs/assets/[^/]+\\.gif$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "source": {
            "enum": ["a2d2", "livox-horizon-horizon", "tiers-lidars-cali", "tiers-indoor02-kissicp"]
          },
          "visual": {
            "enum": ["evidence", "online", "motion"]
          },
          "readme_role": {
            "enum": ["hero", "gallery"]
          },
          "sensor_pair": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target"],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "source_lidar_id": {
                "type": "integer",
                "minimum": 0
              },
              "target_lidar_id": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "source_label": {
            "type": "string",
            "minLength": 1
          },
          "target_label": {
            "type": "string",
            "minLength": 1
          },
          "metadata_source": {
            "type": "string",
            "minLength": 1
          },
          "uses_builtin_metadata_fallback": {
            "type": "boolean"
          },
          "pipeline": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "source"],
            "properties": {
              "mode": {
                "const": "real_online"
              },
              "source": {
                "const": "slac calibrate --online"
              },
              "timeline_schema_version": {
                "enum": [
                  "slac.online_timeline/v0.2",
                  "slac.online_timeline/v0.3"
                ]
              },
              "config_path": {
                "type": "string",
                "minLength": 1
              },
              "generation_command": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "animation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fps", "frames", "height", "width"],
            "properties": {
              "fps": {
                "type": "integer",
                "minimum": 1
              },
              "frames": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "width": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "online_run": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "accepted_batch_count",
              "batch_count",
              "final_gate_status",
              "gate_thresholds",
              "inconclusive_batch_count",
              "rejected_batch_count"
            ],
            "properties": {
              "batch_count": {
                "type": "integer",
                "minimum": 0
              },
              "accepted_batch_count": {
                "type": "integer",
                "minimum": 0
              },
              "rejected_batch_count": {
                "type": "integer",
                "minimum": 0
              },
              "inconclusive_batch_count": {
                "type": "integer",
                "minimum": 0
              },
              "final_gate_status": {
                "enum": ["pass", "fail", "inconclusive"]
              },
              "gate_thresholds": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "max_holdout_rmse_m",
                  "max_rolling_regression_m",
                  "min_rank"
                ],
                "properties": {
                  "min_rank": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "max_holdout_rmse_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "max_rolling_regression_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          },
          "public_inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "url"],
                  "properties": {
                    "kind": {
                      "enum": ["npz_range_from_tar", "pcd_tar_gz", "sensor_metadata_json"]
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "selected_member": {
                      "type": "string",
                      "minLength": 1
                    },
                    "byte_range": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "integer",
                          "minimum": 0
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "url", "bag_file", "replay_budgets"],
                  "properties": {
                    "kind": {
                      "const": "rosbag1_local_dataset"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "bag_file": {
                      "type": "string",
                      "minLength": 1
                    },
                    "size_bytes": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "sha256_first_mib": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "replay_budgets": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "batch_size",
                        "holdout_ratio",
                        "max_replay_duration_s",
                        "max_source_messages",
                        "max_source_points",
                        "max_target_messages",
                        "max_target_points",
                        "rolling_window"
                      ],
                      "properties": {
                        "max_source_messages": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "max_source_points": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "max_target_messages": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "max_target_points": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "max_replay_duration_s": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "batch_size": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "holdout_ratio": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "rolling_window": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "bag_dir", "storage_file", "replay_budgets"],
                  "properties": {
                    "kind": {
                      "const": "rosbag2_local_dataset"
                    },
                    "bag_dir": {
                      "type": "string",
                      "minLength": 1
                    },
                    "storage_file": {
                      "type": "string",
                      "minLength": 1
                    },
                    "size_bytes": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "sha256_first_mib": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "replay_budgets": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "batch_size",
                        "holdout_ratio",
                        "max_replay_duration_s",
                        "max_source_messages",
                        "max_source_points",
                        "max_target_messages",
                        "max_target_points",
                        "rolling_window"
                      ],
                      "properties": {
                        "max_source_messages": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "max_source_points": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "max_target_messages": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "max_target_points": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "max_replay_duration_s": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "batch_size": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "holdout_ratio": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "rolling_window": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
