      ]
    },
    {
      "id": "crop_and_intrinsics",
      "status": "checkpoint_unverified",
      "statement": "CoFi KITTI loader consumes img_P2/img_P3 and K_P2/K_P3 NPYs, with no top crop in __getitem__, then nominal .5 K scaling. The options top-crop value alone does not establish upstream data production.",
      "sources": [
        "CoFiI2P/data/kitti.py:126-135",
        "CoFiI2P/data/kitti.py:267-318"
      ]
    },
