{
  "$defs": {
    "AxisExcitation": {
      "additionalProperties": false,
      "description": "Why one translation axis is (un)observable on this recording and what would change it.\n\n``cause`` is ``observable`` (the reported std is within the bound),\n``insufficient_duration`` (the motion excites the axis, but the recording is\ntoo short: ``needed_duration_s`` of the same motion would reach the bound),\n``no_excitation`` (repeating this motion would take more than an hour, so\ndifferent motion is needed: ``missing_rotation_axes``), ``model_limited``\n(the data-only std is within the bound but the reported std, which also\ncovers modelling error, is not) or ``unsolved``.\n\n``predicted_std_m`` is the data-only (analytic) std, from the information\nmatrix and the residual noise level.  The std scales as 1/sqrt(time) for the\nsame motion, so ``needed_duration_s = recording_s * (std / bound)^2`` with\n``scaling_std_m``, the larger of the analytic and jackknife std.  Rotation is in the\nsensor frame of the lever arm (the LiDAR frame).",
      "properties": {
        "bound_std_m": {
          "exclusiveMinimum": 0.0,
          "title": "Bound Std M",
          "type": "number"
        },
        "cause": {
          "enum": [
            "observable",
            "insufficient_duration",
            "no_excitation",
            "model_limited",
            "unsolved"
          ],
          "title": "Cause",
          "type": "string"
        },
        "fit_windows": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "odometry windows the fit used; the duration extrapolation is indicative only below about a dozen",
          "title": "Fit Windows"
        },
        "information_efficiency": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "share of the rotation-implied information that survives the nuisance parameters (gravity, velocity, accelerometer bias; the per-window map alignment)",
          "title": "Information Efficiency"
        },
        "missing_rotation_axes": {
          "items": {
            "enum": [
              "x",
              "y",
              "z"
            ],
            "type": "string"
          },
          "title": "Missing Rotation Axes",
          "type": "array"
        },
        "name": {
          "enum": [
            "x",
            "y",
            "z"
          ],
          "title": "Name",
          "type": "string"
        },
        "needed_duration_s": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "recording time of the same motion that would reach the bound; absent when the std is not finite",
          "title": "Needed Duration S"
        },
        "perpendicular_rotation_rms_deg": {
          "description": "RMS rotation about the two axes perpendicular to this one",
          "minimum": 0.0,
          "title": "Perpendicular Rotation Rms Deg",
          "type": "number"
        },
        "predicted_std_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicted Std M"
        },
        "recommendation": {
          "title": "Recommendation",
          "type": "string"
        },
        "recording_s": {
          "minimum": 0.0,
          "title": "Recording S",
          "type": "number"
        },
        "rotation_rms_deg": {
          "description": "RMS rotation between the paired poses about the sensor x, y, z axes",
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Rotation Rms Deg",
          "type": "array"
        },
        "scaling_std_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the larger of the analytic and jackknife std: the one that shrinks with more data and that needed_duration_s extrapolates (the analytic std alone is optimistic on real data because the odometry residuals are correlated)",
          "title": "Scaling Std M"
        }
      },
      "required": [
        "name",
        "cause",
        "bound_std_m",
        "rotation_rms_deg",
        "perpendicular_rotation_rms_deg",
        "recording_s",
        "recommendation"
      ],
      "title": "AxisExcitation",
      "type": "object"
    },
    "GnssLidarDofRecord": {
      "additionalProperties": false,
      "description": "One estimated quantity with its uncertainty and evidence.",
      "properties": {
        "error_to_reference": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error To Reference"
        },
        "excitation": {
          "anyOf": [
            {
              "$ref": "#/$defs/AxisExcitation"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "translation axes only: why it is (un)observable and what would change it"
        },
        "known_bad_control": {
          "anyOf": [
            {
              "$ref": "#/$defs/GnssLidarKnownBadControl"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "enum": [
            "x",
            "y",
            "z",
            "time_offset"
          ],
          "title": "Name",
          "type": "string"
        },
        "reference_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Value"
        },
        "status": {
          "enum": [
            "estimated",
            "unobservable"
          ],
          "title": "Status",
          "type": "string"
        },
        "std_analytic": {
          "minimum": 0.0,
          "title": "Std Analytic",
          "type": "number"
        },
        "std_jackknife": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Std Jackknife"
        },
        "std_reported": {
          "minimum": 0.0,
          "title": "Std Reported",
          "type": "number"
        },
        "unit": {
          "enum": [
            "m",
            "s"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "unit",
        "value",
        "std_analytic",
        "std_reported",
        "status"
      ],
      "title": "GnssLidarDofRecord",
      "type": "object"
    },
    "GnssLidarKnownBadControl": {
      "additionalProperties": false,
      "description": "Held-out chi-square increase after shifting one quantity.",
      "properties": {
        "amount": {
          "title": "Amount",
          "type": "number"
        },
        "detected": {
          "title": "Detected",
          "type": "boolean"
        },
        "holdout_delta_chi2": {
          "title": "Holdout Delta Chi2",
          "type": "number"
        },
        "unit": {
          "enum": [
            "m",
            "s"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "unit",
        "holdout_delta_chi2",
        "detected"
      ],
      "title": "GnssLidarKnownBadControl",
      "type": "object"
    },
    "GnssLidarLeverArmProvenance": {
      "additionalProperties": false,
      "description": "Inputs and generator lineage.",
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "dataset_family": {
          "title": "Dataset Family",
          "type": "string"
        },
        "dataset_license": {
          "title": "Dataset License",
          "type": "string"
        },
        "generator": {
          "title": "Generator",
          "type": "string"
        },
        "generator_version": {
          "title": "Generator Version",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "input_digest_scope": {
          "title": "Input Digest Scope",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "sequence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Sequence Ids",
          "type": "array"
        }
      },
      "required": [
        "generator",
        "generator_version",
        "dataset_family",
        "sequence_ids",
        "input_sha256",
        "input_digest_scope",
        "dataset_license"
      ],
      "title": "GnssLidarLeverArmProvenance",
      "type": "object"
    },
    "GnssLidarSegmentSummary": {
      "additionalProperties": false,
      "description": "How the LiDAR stream was cut into reliable, GNSS-covered windows.",
      "properties": {
        "gnss_epochs_rejected": {
          "minimum": 0,
          "title": "Gnss Epochs Rejected",
          "type": "integer"
        },
        "gnss_epochs_used": {
          "minimum": 0,
          "title": "Gnss Epochs Used",
          "type": "integer"
        },
        "odometry_segments": {
          "minimum": 0,
          "title": "Odometry Segments",
          "type": "integer"
        },
        "scans_in_gnss_coverage": {
          "minimum": 0,
          "title": "Scans In Gnss Coverage",
          "type": "integer"
        },
        "scans_read": {
          "minimum": 0,
          "title": "Scans Read",
          "type": "integer"
        },
        "unreliable_registrations": {
          "minimum": 0,
          "title": "Unreliable Registrations",
          "type": "integer"
        },
        "windows": {
          "minimum": 0,
          "title": "Windows",
          "type": "integer"
        }
      },
      "required": [
        "scans_read",
        "scans_in_gnss_coverage",
        "odometry_segments",
        "unreliable_registrations",
        "windows",
        "gnss_epochs_used",
        "gnss_epochs_rejected"
      ],
      "title": "GnssLidarSegmentSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Evidence for one GNSS-LiDAR lever-arm calibration run.",
  "properties": {
    "calibrated_dofs": {
      "items": {
        "enum": [
          "x",
          "y",
          "z",
          "time_offset"
        ],
        "type": "string"
      },
      "title": "Calibrated Dofs",
      "type": "array"
    },
    "dofs": {
      "items": {
        "$ref": "#/$defs/GnssLidarDofRecord"
      },
      "title": "Dofs",
      "type": "array"
    },
    "holdout_median_residual_m": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Holdout Median Residual M"
    },
    "holdout_windows": {
      "minimum": 0,
      "title": "Holdout Windows",
      "type": "integer"
    },
    "jackknife_fits": {
      "minimum": 0,
      "title": "Jackknife Fits",
      "type": "integer"
    },
    "lever_arm_frame": {
      "title": "Lever Arm Frame",
      "type": "string"
    },
    "lever_arm_m": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lever Arm M"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "method": {
      "const": "windowed_variable_projection/v0.1",
      "default": "windowed_variable_projection/v0.1",
      "title": "Method",
      "type": "string"
    },
    "options": {
      "additionalProperties": true,
      "title": "Options",
      "type": "object"
    },
    "policy_reasons": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Policy Reasons",
      "type": "array"
    },
    "policy_status": {
      "enum": [
        "pass",
        "warn",
        "fail",
        "inconclusive"
      ],
      "title": "Policy Status",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/GnssLidarLeverArmProvenance"
    },
    "reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference"
    },
    "schema_version": {
      "const": "slac.gnss_lidar_lever_arm/v0.1",
      "default": "slac.gnss_lidar_lever_arm/v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "segments": {
      "$ref": "#/$defs/GnssLidarSegmentSummary"
    },
    "solver_status": {
      "enum": [
        "converged",
        "insufficient_windows"
      ],
      "title": "Solver Status",
      "type": "string"
    },
    "time_offset_s": {
      "title": "Time Offset S",
      "type": "number"
    },
    "train_median_residual_m": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Train Median Residual M"
    },
    "train_windows": {
      "minimum": 0,
      "title": "Train Windows",
      "type": "integer"
    }
  },
  "required": [
    "solver_status",
    "policy_status",
    "policy_reasons",
    "calibrated_dofs",
    "lever_arm_frame",
    "time_offset_s",
    "dofs",
    "options",
    "segments",
    "train_windows",
    "holdout_windows",
    "jackknife_fits",
    "provenance"
  ],
  "title": "GnssLidarLeverArmArtifact",
  "type": "object"
}
