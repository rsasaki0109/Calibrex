{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "calibrex.benchmark/v0.1",
  "title": "Calibrex benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "claim",
    "limitations",
    "protocol",
    "provenance",
    "results",
    "schema_version",
    "title"
  ],
  "properties": {
    "schema_version": {"const": "calibrex.benchmark/v0.1"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "scope", "value", "winner"],
      "properties": {
        "metric": {"enum": ["translation_holdout_rmse_m"]},
        "scope": {"type": "string", "minLength": 1},
        "winner": {"type": "string", "minLength": 1},
        "value": {"type": "number", "minimum": 0}
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "dataset_doi",
        "dataset_source_sha256",
        "dataset_tree_sha256",
        "fit_pair_count",
        "holdout_pair_count",
        "known_bad_case_count_per_method",
        "known_bad_detection_gate",
        "rotation_gate_deg",
        "seed",
        "split",
        "translation_gate_m"
      ],
      "properties": {
        "dataset": {"type": "string", "minLength": 1},
        "dataset_doi": {"type": "string", "minLength": 1},
        "dataset_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dataset_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "split": {"type": "string", "minLength": 1},
        "seed": {"type": "integer"},
        "fit_pair_count": {"type": "integer", "minimum": 1},
        "holdout_pair_count": {"type": "integer", "minimum": 1},
        "known_bad_case_count_per_method": {"type": "integer", "minimum": 1},
        "rotation_gate_deg": {"type": "number", "exclusiveMinimum": 0},
        "translation_gate_m": {"type": "number", "exclusiveMinimum": 0},
        "known_bad_detection_gate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "results": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "calibrex_refinement",
          "known_bad_detectable_fraction",
          "label",
          "method_id",
          "paper_doi",
          "rotation_holdout_rmse_deg",
          "translation_holdout_rmse_m"
        ],
        "properties": {
          "method_id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "paper_doi": {"type": "string", "minLength": 1},
          "calibrex_refinement": {"type": "boolean"},
          "rotation_holdout_rmse_deg": {"type": "number", "minimum": 0},
          "translation_holdout_rmse_m": {"type": "number", "minimum": 0},
          "known_bad_detectable_fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_verified",
        "calibrex_git_commit",
        "command",
        "config_path",
        "config_sha256",
        "data_verified",
        "generated_at",
        "metrics_sha256",
        "result_sha256",
        "run_id"
      ],
      "properties": {
        "generated_at": {"type": "string", "format": "date-time"},
        "calibrex_git_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "run_id": {"type": "string", "minLength": 1},
        "config_path": {"type": "string", "minLength": 1},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "metrics_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "command": {"type": "string", "minLength": 1},
        "data_verified": {"const": true},
        "bundle_verified": {"const": true}
      }
    }
  }
}
