{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Complete public A2D2 PNG decoding comparison protocol",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "commits", "repetitions", "fresh_workers", "host_unreserved", "blas_threads", "dataset", "png_inputs", "metadata_commit_injection", "provenance"],
  "properties": {
    "schema_version": {"const": "slac.png_luminance_benchmark/v0.1"},
    "commits": {"$ref": "#/$defs/commits"},
    "repetitions": {"type": "integer", "minimum": 2},
    "fresh_workers": {"const": true},
    "host_unreserved": {"const": true},
    "blas_threads": {"const": 1},
    "dataset": {"type": "string", "minLength": 1},
    "png_inputs": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^[^/\\\\]+[.]png$"}},
    "metadata_commit_injection": {"const": true},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["inputs", "configs", "manifests", "launcher_sha256", "freezer_sha256", "schema_sha256", "python", "versions"],
      "properties": {
        "inputs": {"type": "object", "minProperties": 5, "additionalProperties": {"$ref": "#/$defs/sha"}},
        "configs": {"type": "object", "additionalProperties": false, "required": ["levinson", "pandey"], "properties": {"levinson": {"$ref": "#/$defs/sha"}, "pandey": {"$ref": "#/$defs/sha"}}},
        "manifests": {"$ref": "#/$defs/digests"},
        "launcher_sha256": {"$ref": "#/$defs/sha"},
        "freezer_sha256": {"$ref": "#/$defs/sha"},
        "schema_sha256": {"$ref": "#/$defs/sha"},
        "python": {"type": "string", "minLength": 1},
        "versions": {"type": "object", "additionalProperties": false, "required": ["numpy", "Pillow", "scipy", "pydantic", "PyYAML"], "properties": {"numpy": {"type": "string"}, "Pillow": {"type": "string"}, "scipy": {"type": "string"}, "pydantic": {"type": "string"}, "PyYAML": {"type": "string"}}}
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "commits": {"type": "object", "additionalProperties": false, "required": ["prior", "current"], "properties": {"prior": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "current": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}},
    "digests": {"type": "object", "additionalProperties": false, "required": ["prior", "current"], "properties": {"prior": {"$ref": "#/$defs/sha"}, "current": {"$ref": "#/$defs/sha"}}}
  }
}
