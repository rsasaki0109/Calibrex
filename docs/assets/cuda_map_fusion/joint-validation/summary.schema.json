{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CUDA map warm or shared-path validation",
  "type": "object",
  "required": ["provenance"],
  "properties": {"provenance": {"type": "object", "required": ["scope"]}},
  "oneOf": [
    {
      "required": ["warm_api_median_seconds", "warm_api_speedup", "quality_exact"],
      "properties": {
        "warm_api_median_seconds": {
          "type": "object", "required": ["prior", "current"], "additionalProperties": false,
          "properties": {"prior": {"type": "number", "exclusiveMinimum": 0}, "current": {"type": "number", "exclusiveMinimum": 0}}
        },
        "warm_api_speedup": {"type": "number", "exclusiveMinimum": 0},
        "quality_exact": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "boolean"}}
      }
    },
    {
      "required": ["full_fit_rounds", "signed_controls", "quality_exact"],
      "properties": {"full_fit_rounds": {"const": 4}, "signed_controls": {"const": 32}, "quality_exact": {"type": "boolean"}}
    }
  ]
}
