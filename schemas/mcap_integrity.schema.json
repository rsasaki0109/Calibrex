      ],
      "title": "Summary Crc Status",
      "type": "string"
    },
    "summary_offset_present": {
      "default": false,
      "title": "Summary Offset Present",
      "type": "boolean"
    },
    "summary_offset_status": {
      "default": "unknown",
      "enum": [
        "known",
        "unknown",
        "not_applicable",
        "blocked"
      ],
      "title": "Summary Offset Status",
      "type": "string"
    },
    "summary_present": {
      "default": false,
      "title": "Summary Present",
      "type": "boolean"
    },
    "summary_records_checked": {
      "default": 0,
      "minimum": 0,
      "title": "Summary Records Checked",
      "type": "integer"
    },
    "summary_status": {
      "default": "unknown",
      "enum": [
        "known",
        "unknown",
        "not_applicable",
        "blocked"
      ],
      "title": "Summary Status",
      "type": "string"
    },
    "unsupported_compressions": {
      "items": {
        "maxLength": 128,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Unsupported Compressions",
      "type": "array"
    },
    "warnings": {
      "items": {
        "maxLength": 512,
        "type": "string"
      },
      "maxItems": 32,
