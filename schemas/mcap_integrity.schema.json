        "blocked"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary_crc_encoded": {
      "default": false,
      "title": "Summary Crc Encoded",
      "type": "boolean"
    },
    "summary_crc_status": {
      "default": "unknown",
      "enum": [
        "known",
        "unknown",
        "not_applicable",
