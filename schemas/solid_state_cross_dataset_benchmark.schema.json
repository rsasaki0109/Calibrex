{
  "$defs": {
    "SolidStateCrossDatasetBenchmarkAggregate": {
      "additionalProperties": false,
      "description": "Summary counts retained alongside the per-dataset table.",
      "properties": {
        "adaptive_win_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adaptive Win Rate"
        },
        "adaptive_wins": {
          "minimum": 0,
          "title": "Adaptive Wins",
          "type": "integer"
        },
        "conclusion": {
          "title": "Conclusion",
          "type": "string"
        },
        "dataset_count": {
          "minimum": 0,
          "title": "Dataset Count",
          "type": "integer"
        },
        "failure_categories": {
          "items": {
            "enum": [
              "none",
              "max_iterations",
              "insufficient_constraints",
              "rejected",
              "missing_result",
              "invalid_artifact",
              "rank_deficient",
              "insufficient_holdout",
              "not_run",
              "unknown"
            ],
            "type": "string"
          },
          "title": "Failure Categories",
          "type": "array"
        },
        "holdout_improvement_ci": {
          "anyOf": [
            {
              "$ref": "#/$defs/SolidStateCrossDatasetBenchmarkConfidenceInterval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "inconclusive_dataset_count": {
          "minimum": 0,
          "title": "Inconclusive Dataset Count",
          "type": "integer"
        },
        "mean_holdout_improvement_percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Holdout Improvement Percent"
        },
        "median_holdout_improvement_percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median Holdout Improvement Percent"
        },
        "scored_dataset_count": {
          "minimum": 0,
          "title": "Scored Dataset Count",
          "type": "integer"
        },
        "scored_replicate_count": {
          "default": 0,
          "minimum": 0,
          "title": "Scored Replicate Count",
          "type": "integer"
        },
        "ties": {
          "minimum": 0,
          "title": "Ties",
          "type": "integer"
        },
        "total_replicate_count": {
          "default": 0,
          "minimum": 0,
          "title": "Total Replicate Count",
          "type": "integer"
        },
        "uniform_wins": {
          "minimum": 0,
          "title": "Uniform Wins",
          "type": "integer"
        }
      },
      "required": [
        "dataset_count",
        "scored_dataset_count",
        "inconclusive_dataset_count",
        "adaptive_wins",
        "uniform_wins",
        "ties",
        "conclusion"
      ],
      "title": "SolidStateCrossDatasetBenchmarkAggregate",
      "type": "object"
    },
    "SolidStateCrossDatasetBenchmarkConfidenceInterval": {
      "additionalProperties": false,
      "description": "A deterministic bootstrap interval for a reported benchmark statistic.",
      "properties": {
        "confidence_level": {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Confidence Level",
          "type": "number"
        },
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "statistic": {
          "const": "mean_holdout_improvement_percent",
          "title": "Statistic",
          "type": "string"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "confidence_level",
        "lower",
        "upper",
        "statistic"
      ],
      "title": "SolidStateCrossDatasetBenchmarkConfidenceInterval",
      "type": "object"
    },
    "SolidStateCrossDatasetBenchmarkDataset": {
      "additionalProperties": false,
      "description": "One dataset-level comparison and its evidence classification.",
      "properties": {
        "ablation_manifest_path": {
          "title": "Ablation Manifest Path",
          "type": "string"
        },
        "ablation_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-fA-F]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ablation Manifest Sha256"
        },
        "absolute_extrinsic_ground_truth": {
          "default": false,
          "title": "Absolute Extrinsic Ground Truth",
          "type": "boolean"
        },
        "adaptive_variant_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adaptive Variant Id"
        },
        "adaptive_win_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adaptive Win Rate"
        },
        "comparison_note": {
          "title": "Comparison Note",
          "type": "string"
        },
        "config_path": {
          "title": "Config Path",
          "type": "string"
        },
        "config_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-fA-F]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Sha256"
        },
        "dataset_manifest_path": {
          "title": "Dataset Manifest Path",
          "type": "string"
        },
        "dataset_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-fA-F]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Manifest Sha256"
        },
        "failure_categories": {
          "items": {
            "enum": [
              "none",
              "max_iterations",
              "insufficient_constraints",
              "rejected",
              "missing_result",
              "invalid_artifact",
              "rank_deficient",
              "insufficient_holdout",
              "not_run",
              "unknown"
            ],
            "type": "string"
          },
          "title": "Failure Categories",
          "type": "array"
        },
        "family": {
          "title": "Family",
          "type": "string"
        },
        "holdout_improvement_ci": {
          "anyOf": [
            {
              "$ref": "#/$defs/SolidStateCrossDatasetBenchmarkConfidenceInterval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "holdout_improvement_mean_percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holdout Improvement Mean Percent"
        },
        "holdout_improvement_median_percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holdout Improvement Median Percent"
        },
        "holdout_improvement_percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holdout Improvement Percent"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "identity_control": {
          "default": false,
          "title": "Identity Control",
          "type": "boolean"
        },
        "independent_temporal_holdout": {
          "default": true,
          "title": "Independent Temporal Holdout",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "reference_mode": {
          "enum": [
            "absolute_extrinsic",
            "identity_control",
            "trajectory_only",
            "none"
          ],
          "title": "Reference Mode",
          "type": "string"
        },
        "replicate_count": {
          "default": 0,
          "minimum": 0,
          "title": "Replicate Count",
          "type": "integer"
        },
        "replicates": {
          "items": {
            "$ref": "#/$defs/SolidStateCrossDatasetBenchmarkReplicate"
          },
          "title": "Replicates",
          "type": "array"
        },
        "scored_replicate_count": {
          "default": 0,
          "minimum": 0,
          "title": "Scored Replicate Count",
          "type": "integer"
        },
        "status": {
          "enum": [
            "scored",
            "inconclusive",
            "failed",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "uniform_variant_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uniform Variant Id"
        },
        "variants": {
          "items": {
            "$ref": "#/$defs/SolidStateCrossDatasetBenchmarkVariant"
          },
          "minItems": 1,
          "title": "Variants",
          "type": "array"
        },
        "winner": {
          "default": "inconclusive",
          "enum": [
            "adaptive",
            "uniform",
            "tie",
            "inconclusive"
          ],
          "title": "Winner",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "family",
        "dataset_manifest_path",
        "config_path",
        "ablation_manifest_path",
        "reference_mode",
        "status",
        "variants",
        "comparison_note"
      ],
      "title": "SolidStateCrossDatasetBenchmarkDataset",
      "type": "object"
    },
    "SolidStateCrossDatasetBenchmarkProtocol": {
      "additionalProperties": false,
      "description": "The controls and primary metric shared by each dataset comparison.",
      "properties": {
        "bootstrap_samples": {
          "default": 2000,
          "minimum": 100,
          "title": "Bootstrap Samples",
          "type": "integer"
        },
        "bootstrap_seed": {
          "default": 0,
          "title": "Bootstrap Seed",
          "type": "integer"
        },
        "bounded_replay_allowed": {
          "default": true,
          "title": "Bounded Replay Allowed",
          "type": "boolean"
        },
        "bounded_replay_note": {
          "title": "Bounded Replay Note",
          "type": "string"
        },
        "confidence_level": {
          "default": 0.95,
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Confidence Level",
          "type": "number"
        },
        "holdout_start_fractions": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Holdout Start Fractions",
          "type": "object"
        },
        "lower_is_better": {
          "default": true,
          "title": "Lower Is Better",
          "type": "boolean"
        },
        "minimum_holdout_correspondences": {
          "default": 6,
          "minimum": 1,
          "title": "Minimum Holdout Correspondences",
          "type": "integer"
        },
        "minimum_scored_replicates": {
          "default": 1,
          "minimum": 1,
          "title": "Minimum Scored Replicates",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "primary_metric": {
          "const": "final_holdout_rmse_m",
          "default": "final_holdout_rmse_m",
          "title": "Primary Metric",
          "type": "string"
        },
        "require_converged": {
          "default": false,
          "title": "Require Converged",
          "type": "boolean"
        },
        "same_capture_windows": {
          "default": true,
          "title": "Same Capture Windows",
          "type": "boolean"
        },
        "same_solver_budget": {
          "default": true,
          "title": "Same Solver Budget",
          "type": "boolean"
        },
        "same_temporal_holdout": {
          "default": true,
          "title": "Same Temporal Holdout",
          "type": "boolean"
        },
        "seed_values": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Seed Values",
          "type": "array"
        },
        "solver": {
          "const": "continuous_time_lidar_pair",
          "title": "Solver",
          "type": "string"
        },
        "split_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Split Ids",
          "type": "array"
        },
        "variants": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Variants",
          "type": "array"
        }
      },
      "required": [
        "name",
        "solver",
        "variants",
        "bounded_replay_note"
      ],
      "title": "SolidStateCrossDatasetBenchmarkProtocol",
      "type": "object"
    },
    "SolidStateCrossDatasetBenchmarkProvenance": {
      "additionalProperties": false,
      "description": "Digests for the declarations and evidence manifests used to aggregate.",
      "properties": {
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "source_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Paths",
          "type": "array"
        },
        "source_sha256": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Source Sha256",
          "type": "object"
        },
        "tool_name": {
          "default": "tools/run_solid_state_cross_dataset_benchmark.py",
          "title": "Tool Name",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "source_paths",
        "source_sha256",
        "tool_version"
      ],
      "title": "SolidStateCrossDatasetBenchmarkProvenance",
      "type": "object"
    },
    "SolidStateCrossDatasetBenchmarkReplicate": {
      "additionalProperties": false,
      "description": "One paired split/seed comparison used by the dataset aggregate.",
      "properties": {
        "ablation_manifest_path": {
          "title": "Ablation Manifest Path",
          "type": "string"
        },
        "ablation_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-fA-F]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ablation Manifest Sha256"
        },
        "comparison_note": {
          "title": "Comparison Note",
          "type": "string"
        },
        "failure_categories": {
          "items": {
            "enum": [
              "none",
              "max_iterations",
              "insufficient_constraints",
              "rejected",
              "missing_result",
              "invalid_artifact",
              "rank_deficient",
              "insufficient_holdout",
              "not_run",
              "unknown"
            ],
            "type": "string"
          },
          "title": "Failure Categories",
          "type": "array"
        },
        "holdout_improvement_percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holdout Improvement Percent"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "split_id": {
          "title": "Split Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "scored",
            "inconclusive",
            "failed",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "variants": {
          "items": {
            "$ref": "#/$defs/SolidStateCrossDatasetBenchmarkVariant"
          },
          "minItems": 1,
          "title": "Variants",
          "type": "array"
        },
        "winner": {
          "default": "inconclusive",
          "enum": [
            "adaptive",
            "uniform",
            "tie",
            "inconclusive"
          ],
          "title": "Winner",
          "type": "string"
        }
      },
      "required": [
        "id",
        "split_id",
        "seed",
        "ablation_manifest_path",
        "status",
        "variants",
        "comparison_note"
      ],
      "title": "SolidStateCrossDatasetBenchmarkReplicate",
      "type": "object"
    },
    "SolidStateCrossDatasetBenchmarkVariant": {
      "additionalProperties": false,
      "description": "The comparable metrics copied from one continuous-time artifact.",
      "properties": {
        "estimated_time_offset_sec": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Time Offset Sec"
        },
        "failure_category": {
          "default": "none",
          "enum": [
            "none",
            "max_iterations",
            "insufficient_constraints",
            "rejected",
            "missing_result",
            "invalid_artifact",
            "rank_deficient",
            "insufficient_holdout",
            "not_run",
            "unknown"
          ],
          "title": "Failure Category",
          "type": "string"
        },
        "final_holdout_rmse_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Holdout Rmse M"
        },
        "final_train_rmse_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Train Rmse M"
        },
        "holdout_correspondence_count": {
          "default": 0,
          "minimum": 0,
          "title": "Holdout Correspondence Count",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "observability_rank": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observability Rank"
        },
        "optimization_status": {
          "title": "Optimization Status",
          "type": "string"
        },
        "outlier_policy": {
          "enum": [
            "none",
            "mad"
          ],
          "title": "Outlier Policy",
          "type": "string"
        },
        "outlier_rejected_count": {
          "default": 0,
          "minimum": 0,
          "title": "Outlier Rejected Count",
          "type": "integer"
        },
        "quality_grade": {
          "anyOf": [
            {
              "enum": [
                "pass",
                "warn",
                "fail"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Grade"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "result_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Path"
        },
        "result_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-fA-F]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Sha256"
        },
        "train_correspondence_count": {
          "default": 0,
          "minimum": 0,
          "title": "Train Correspondence Count",
          "type": "integer"
        },
        "voxel_strategy": {
          "enum": [
            "uniform",
            "adaptive"
          ],
          "title": "Voxel Strategy",
          "type": "string"
        }
      },
      "required": [
        "id",
        "voxel_strategy",
        "outlier_policy",
        "optimization_status"
      ],
      "title": "SolidStateCrossDatasetBenchmarkVariant",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Reproducible cross-dataset comparison artifact.",
  "properties": {
    "aggregate": {
      "$ref": "#/$defs/SolidStateCrossDatasetBenchmarkAggregate"
    },
    "datasets": {
      "items": {
        "$ref": "#/$defs/SolidStateCrossDatasetBenchmarkDataset"
      },
      "minItems": 1,
      "title": "Datasets",
      "type": "array"
    },
    "protocol": {
      "$ref": "#/$defs/SolidStateCrossDatasetBenchmarkProtocol"
    },
    "provenance": {
      "$ref": "#/$defs/SolidStateCrossDatasetBenchmarkProvenance"
    },
    "schema_version": {
      "default": "slac.solid_state_cross_dataset_benchmark/v0.2",
      "enum": [
        "slac.solid_state_cross_dataset_benchmark/v0.1",
        "slac.solid_state_cross_dataset_benchmark/v0.2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "spec_path": {
      "title": "Spec Path",
      "type": "string"
    },
    "spec_sha256": {
      "pattern": "^[0-9a-fA-F]{64}$",
      "title": "Spec Sha256",
      "type": "string"
    },
    "tool": {
      "default": "tools/run_solid_state_cross_dataset_benchmark.py",
      "title": "Tool",
      "type": "string"
    },
    "tool_version": {
      "title": "Tool Version",
      "type": "string"
    }
  },
  "required": [
    "tool_version",
    "spec_path",
    "spec_sha256",
    "protocol",
    "datasets",
    "aggregate",
    "provenance"
  ],
  "title": "SolidStateCrossDatasetBenchmarkManifest",
  "type": "object"
}
