{
  "$defs": {
    "CameraLidarArtifactProvenance": {
      "additionalProperties": false,
      "description": "Generator and source digests shared by camera--LiDAR artifacts.",
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "config_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Sha256"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "generator": {
          "title": "Generator",
          "type": "string"
        },
        "generator_version": {
          "title": "Generator Version",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "generator",
        "generator_version",
        "source_sha256"
      ],
      "title": "CameraLidarArtifactProvenance",
      "type": "object"
    },
    "CameraLidarObservationBinding": {
      "additionalProperties": false,
      "description": "Binding between one depth observation and one LiDAR scan.",
      "properties": {
        "depth_observation_frame_id": {
          "title": "Depth Observation Frame Id",
          "type": "string"
        },
        "frame_id": {
          "title": "Frame Id",
          "type": "string"
        },
        "lidar": {
          "$ref": "#/$defs/DepthFileReference"
        },
        "lidar_capture_time_ns": {
          "title": "Lidar Capture Time Ns",
          "type": "integer"
        },
        "split_id": {
          "title": "Split Id",
          "type": "string"
        }
      },
      "required": [
        "frame_id",
        "split_id",
        "depth_observation_frame_id",
        "lidar",
        "lidar_capture_time_ns"
      ],
      "title": "CameraLidarObservationBinding",
      "type": "object"
    },
    "CovarianceInfo": {
      "additionalProperties": false,
      "properties": {
        "matrix": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Matrix",
          "type": "array"
        },
        "order": {
          "items": {
            "type": "string"
          },
          "title": "Order",
          "type": "array"
        }
      },
      "required": [
        "order",
        "matrix"
      ],
      "title": "CovarianceInfo",
      "type": "object"
    },
    "DepthFileReference": {
      "additionalProperties": false,
      "description": "Content-addressed depth-provider input or output file.",
      "properties": {
        "encoding": {
          "title": "Encoding",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "encoding"
      ],
      "title": "DepthFileReference",
      "type": "object"
    },
    "TransformEstimateProvenance": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Version"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "evidence_level": {
          "default": "unknown",
          "enum": [
            "synthetic_truth",
            "independently_measured",
            "dataset_provided",
            "factory_provided",
            "algorithmically_refined",
            "imported_without_documented_derivation",
            "unknown"
          ],
          "title": "Evidence Level",
          "type": "string"
        },
        "execution_mode": {
          "default": "unknown",
          "enum": [
            "offline_batch",
            "sliding_window",
            "online_stream",
            "manual",
            "imported",
            "dataset_reference",
            "unknown"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "license_spdx": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Spdx"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "producer": {
          "default": "unknown",
          "enum": [
            "slac_native",
            "external_tool",
            "human",
            "dataset_provider",
            "factory",
            "unknown"
          ],
          "title": "Producer",
          "type": "string"
        },
        "role_in_comparison": {
          "anyOf": [
            {
              "enum": [
                "initial",
                "candidate",
                "selected_reference",
                "output",
                "comparison_baseline"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role In Comparison"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "source_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Commit"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Path"
        },
        "tool_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Name"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        }
      },
      "title": "TransformEstimateProvenance",
      "type": "object"
    },
    "TransformQuality": {
      "additionalProperties": false,
      "properties": {
        "grade": {
          "default": "warn",
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "title": "Grade",
          "type": "string"
        },
        "std_rotation_deg": {
          "items": {
            "type": "number"
          },
          "title": "Std Rotation Deg",
          "type": "array"
        },
        "std_translation_m": {
          "items": {
            "type": "number"
          },
          "title": "Std Translation M",
          "type": "array"
        }
      },
      "title": "TransformQuality",
      "type": "object"
    },
    "TransformResult": {
      "additionalProperties": false,
      "properties": {
        "child": {
          "title": "Child",
          "type": "string"
        },
        "convention": {
          "const": "T_parent_child",
          "default": "T_parent_child",
          "title": "Convention",
          "type": "string"
        },
        "covariance": {
          "anyOf": [
            {
              "$ref": "#/$defs/CovarianceInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "estimate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimate Id"
        },
        "parent": {
          "title": "Parent",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/TransformEstimateProvenance"
        },
        "quality": {
          "$ref": "#/$defs/TransformQuality"
        },
        "rotation_quat_xyzw": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Rotation Quat Xyzw",
          "type": "array"
        },
        "translation_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Translation M",
          "type": "array"
        }
      },
      "required": [
        "parent",
        "child",
        "translation_m",
        "rotation_quat_xyzw"
      ],
      "title": "TransformResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Digest-pinned solver-neutral camera--LiDAR calibration problem.",
  "properties": {
    "dataset_family": {
      "title": "Dataset Family",
      "type": "string"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "depth_provider_path": {
      "title": "Depth Provider Path",
      "type": "string"
    },
    "depth_provider_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Depth Provider Sha256",
      "type": "string"
    },
    "frame_convention": {
      "const": "T_parent_child",
      "default": "T_parent_child",
      "title": "Frame Convention",
      "type": "string"
    },
    "initial_transform_camera_lidar": {
      "$ref": "#/$defs/TransformResult"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/CameraLidarObservationBinding"
      },
      "minItems": 1,
      "title": "Observations",
      "type": "array"
    },
    "problem_id": {
      "title": "Problem Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/CameraLidarArtifactProvenance"
    },
    "reference_transform_camera_lidar": {
      "$ref": "#/$defs/TransformResult"
    },
    "rotation_bound_deg": {
      "exclusiveMinimum": 0.0,
      "title": "Rotation Bound Deg",
      "type": "number"
    },
    "schema_version": {
      "const": "slac.camera_lidar_problem/v0.1",
      "default": "slac.camera_lidar_problem/v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence_id": {
      "title": "Sequence Id",
      "type": "string"
    },
    "time_convention": {
      "title": "Time Convention",
      "type": "string"
    },
    "translation_bound_m": {
      "minimum": 0.0,
      "title": "Translation Bound M",
      "type": "number"
    }
  },
  "required": [
    "problem_id",
    "dataset_id",
    "dataset_family",
    "sequence_id",
    "depth_provider_path",
    "depth_provider_sha256",
    "observations",
    "reference_transform_camera_lidar",
    "initial_transform_camera_lidar",
    "time_convention",
    "rotation_bound_deg",
    "translation_bound_m",
    "provenance"
  ],
  "title": "CameraLidarCalibrationProblem",
  "type": "object"
}
