{
  "$defs": {
    "ReplayProvenance": {
      "additionalProperties": false,
      "description": "Complete provenance shared by every generated replay artifact.",
      "properties": {
        "artifact_digest_scope": {
          "default": "canonical artifact excluding artifact_sha256 and provenance.artifact_sha256/generated_at",
          "title": "Artifact Digest Scope",
          "type": "string"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "baseline_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Sha256"
        },
        "candidate_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Sha256"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "config_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Sha256"
        },
        "container_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Digest"
        },
        "environment_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Environment Sha256",
          "type": "string"
        },
        "evidence_sha256": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Evidence Sha256",
          "type": "object"
        },
        "generated_at": {
          "title": "Generated At",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "holdout_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holdout Sha256"
        },
        "known_bad_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Bad Sha256"
        },
        "producer": {
          "const": "calibrex",
          "default": "calibrex",
          "title": "Producer",
          "type": "string"
        },
        "source_sha256": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Source Sha256",
          "type": "object"
        },
        "tool_name": {
          "default": "calibrex.raw-replay",
          "title": "Tool Name",
          "type": "string"
        },
        "tool_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tool Sha256",
          "type": "string"
        },
        "tool_version": {
          "default": "0.4.1",
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "environment_sha256",
        "tool_sha256"
      ],
      "title": "ReplayProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One independently verifiable stage output.",
  "properties": {
    "actions": {
      "items": {
        "type": "string"
      },
      "title": "Actions",
      "type": "array"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Sha256",
      "type": "string"
    },
    "checks": {
      "additionalProperties": {
        "enum": [
          "PASS",
          "WARN",
          "FAIL",
          "BLOCKED"
        ],
        "type": "string"
      },
      "title": "Checks",
      "type": "object"
    },
    "observations": {
      "additionalProperties": true,
      "title": "Observations",
      "type": "object"
    },
    "provenance": {
      "$ref": "#/$defs/ReplayProvenance"
    },
    "reason": {
      "default": "",
      "title": "Reason",
      "type": "string"
    },
    "replay_id": {
      "minLength": 1,
      "title": "Replay Id",
      "type": "string"
    },
    "schema_version": {
      "const": "slac.raw_replay_stage/v0.1",
      "default": "slac.raw_replay_stage/v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "stage_id": {
      "minLength": 1,
      "title": "Stage Id",
      "type": "string"
    },
    "stage_kind": {
      "enum": [
        "verify_inputs",
        "readiness",
        "execute_calibration",
        "validate_result",
        "evaluate",
        "compare",
        "lifecycle",
        "autoware_plan",
        "rollback_simulation"
      ],
      "title": "Stage Kind",
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "BLOCKED"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "replay_id",
    "stage_id",
    "stage_kind",
    "status",
    "provenance",
    "artifact_sha256"
  ],
  "title": "ReplayStageArtifact",
  "type": "object"
}
