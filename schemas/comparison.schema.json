        "computed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Computed At"
        },
        "data_verified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Verified"
        },
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "grade": {
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "title": "Grade",
          "type": "string"
        },
        "metrics_origin": {
          "default": "unknown",
          "enum": [
            "recomputed",
            "cached",
            "unknown"
          ],
          "title": "Metrics Origin",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "status",
        "grade",
        "domain"
      ],
      "title": "ComparisonSide",
      "type": "object"
    },
    "ComparisonSummary": {
      "additionalProperties": false,
      "description": "High-level comparison counters.",
      "properties": {
        "left_better_metric_count": {
          "title": "Left Better Metric Count",
          "type": "integer"
        },
        "max_rotation_delta_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Rotation Delta Deg"
        },
        "max_translation_delta_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Translation Delta M"
        },
        "metric_comparison_count": {
          "title": "Metric Comparison Count",
          "type": "integer"
        },
        "not_comparable_metric_count": {
          "title": "Not Comparable Metric Count",
          "type": "integer"
        },
        "right_better_metric_count": {
          "title": "Right Better Metric Count",
          "type": "integer"
        },
        "tied_metric_count": {
          "title": "Tied Metric Count",
          "type": "integer"
        },
        "transform_comparison_count": {
          "title": "Transform Comparison Count",
          "type": "integer"
        }
      },
      "required": [
        "metric_comparison_count",
        "left_better_metric_count",
        "right_better_metric_count",
        "tied_metric_count",
        "not_comparable_metric_count",
        "transform_comparison_count"
      ],
      "title": "ComparisonSummary",
      "type": "object"
    },
    "EvidenceProtocolCompatibility": {
      "additionalProperties": false,
      "description": "Whether two results were evaluated under comparable evidence protocols.",
      "properties": {
        "left_protocols": {
          "items": {
            "$ref": "#/$defs/EvidenceProtocolSide"
