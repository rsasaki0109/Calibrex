        },
        "topic_count": {
          "minimum": 0,
          "title": "Topic Count",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "topic_count",
        "input_sha256",
        "input_digest_scope"
      ],
      "title": "CheckBagInput",
      "type": "object"
    },
