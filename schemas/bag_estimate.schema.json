                "degenerate_frames",
                "no_candidate_calibration",
                "no_vehicle_frame",
                "method_not_wired",
                "not_selected",
                "unsupported_sensor",
                "missing_intrinsics",
                "missing_dependency",
                "estimator_error",
                "estimator_failed",
                "no_judgeable_axes"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "runtime_s": {
          "anyOf": [
            {
              "minimum": 0.0,
