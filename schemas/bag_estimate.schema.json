    "EstimateAxis": {
      "additionalProperties": false,
      "description": "One axis of a pair's estimate.\n\n``value`` is the estimated value (degrees about the parent frame's axes for\na rotation axis, metres for a translation axis); it is absent unless the\nestimator produced one. ``status`` says whether the data observed it:\n``observed``; ``unobservable`` (the data did not constrain it);\n``control_not_detected`` (the estimator's known-bad control on this axis was\nnot detected on held-out data, so the value is not trusted);\n``no_estimate`` (the estimator produced no value); ``not_estimated`` (this\nestimator does not attempt the axis, for example the translation of a\ncamera-IMU rotation estimate).",
      "properties": {
        "excitation": {
          "anyOf": [
            {
              "$ref": "#/$defs/AxisExcitation"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "translation axes of a lever-arm estimate: why the axis is (un)observable on this recording and what motion or duration would make it observable"
        },
        "name": {
          "enum": [
            "roll",
            "pitch",
            "yaw",
            "x",
            "y",
            "z"
          ],
          "title": "Name",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "status": {
          "enum": [
            "observed",
            "unobservable",
            "control_not_detected",
            "no_estimate",
            "not_estimated"
          ],
          "title": "Status",
          "type": "string"
        },
        "std": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Std"
        },
        "unit": {
          "enum": [
            "deg",
            "m"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "name",
        "unit",
        "status"
      ],
      "title": "EstimateAxis",
      "type": "object"
    },
    "EstimateExportFile": {
