{
  "$defs": {
    "KITTIBenchmarkArtifactDigest": {
      "additionalProperties": false,
      "description": "Digest-bound file used or produced by one benchmark trial.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "role",
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "KITTIBenchmarkArtifactDigest",
      "type": "object"
    },
    "KITTIBenchmarkEvidenceCheck": {
      "additionalProperties": false,
      "description": "One LiDAR-camera evidence check of a trial (``evidence.json`` summaries).",
      "properties": {
        "check": {
          "title": "Check",
          "type": "string"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "uses_dataset_reference": {
          "description": "the check compares with the dataset's calibration, not with the data",
          "title": "Uses Dataset Reference",
          "type": "boolean"
        }
      },
      "required": [
        "check",
        "status",
        "evidence",
        "uses_dataset_reference"
      ],
      "title": "KITTIBenchmarkEvidenceCheck",
      "type": "object"
    },
    "KITTIBenchmarkMetric": {
      "additionalProperties": false,
      "description": "One headline metric of a trial, as its ``metrics.json`` records it.",
      "properties": {
        "grade": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grade"
        },
        "holdout": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holdout"
        },
        "metric_id": {
          "title": "Metric Id",
          "type": "string"
        },
        "train": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "metric_id"
      ],
      "title": "KITTIBenchmarkMetric",
      "type": "object"
    },
    "KITTIBenchmarkRule": {
      "additionalProperties": false,
      "description": "One gate of the trial's falsification policy and its outcome.",
      "properties": {
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "status",
        "reason"
      ],
      "title": "KITTIBenchmarkRule",
      "type": "object"
    },
    "KITTIBenchmarkTrial": {
      "additionalProperties": false,
      "description": "One frozen candidate evaluated by the KITTI protocol.",
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/KITTIBenchmarkArtifactDigest"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "assessment_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessment Reason"
        },
        "assessment_status": {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ],
          "title": "Assessment Status",
          "type": "string"
        },
        "bundle_valid": {
          "title": "Bundle Valid",
          "type": "boolean"
        },
        "candidate_id": {
          "enum": [
            "dataset_reference",
            "known_bad"
          ],
          "title": "Candidate Id",
          "type": "string"
        },
        "evidence_checks": {
          "description": "the LiDAR-camera evidence checks behind the decision-boundary gate",
          "items": {
            "$ref": "#/$defs/KITTIBenchmarkEvidenceCheck"
          },
          "title": "Evidence Checks",
          "type": "array"
        },
        "expected_assessment": {
          "enum": [
            "pass",
            "fail"
          ],
          "title": "Expected Assessment",
          "type": "string"
        },
        "metrics": {
          "description": "headline metrics of the trial (see KITTI_HEADLINE_METRICS)",
          "items": {
            "$ref": "#/$defs/KITTIBenchmarkMetric"
          },
          "title": "Metrics",
          "type": "array"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/KITTIBenchmarkRule"
          },
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "candidate_id",
        "expected_assessment",
        "assessment_status",
        "bundle_valid",
        "artifacts"
      ],
      "title": "KITTIBenchmarkTrial",
      "type": "object"
    },
    "KITTIEdgeAxis": {
      "additionalProperties": false,
      "description": "One judged rotation axis: candidate error against the check's tolerance.",
      "properties": {
        "candidate_error_deg": {
          "title": "Candidate Error Deg",
          "type": "number"
        },
        "estimate_std_deg": {
          "title": "Estimate Std Deg",
          "type": "number"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "title": "Status",
          "type": "string"
        },
        "tolerance_deg": {
          "title": "Tolerance Deg",
          "type": "number"
        }
      },
      "required": [
        "name",
        "candidate_error_deg",
        "tolerance_deg",
        "estimate_std_deg",
        "status"
      ],
      "title": "KITTIEdgeAxis",
      "type": "object"
    },
    "KITTIEdgeDecision": {
      "additionalProperties": false,
      "description": "Data-only decision over one frame selection.",
      "properties": {
        "frame_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Frame Ids",
          "type": "array"
        },
        "frame_selection": {
          "description": "spread: frames evenly over the drive (the check's policy); first: the protocol's first frames",
          "enum": [
            "spread",
            "first"
          ],
          "title": "Frame Selection",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "method": {
          "const": "edge_alignment/v0.1 with the calibrex check per-axis rule",
          "default": "edge_alignment/v0.1 with the calibrex check per-axis rule",
          "title": "Method",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ],
          "title": "Status",
          "type": "string"
        },
        "trials": {
          "items": {
            "$ref": "#/$defs/KITTIEdgeTrial"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Trials",
          "type": "array"
        }
      },
      "required": [
        "frame_selection",
        "frame_ids",
        "status",
        "reason",
        "trials"
      ],
      "title": "KITTIEdgeDecision",
      "type": "object"
    },
    "KITTIEdgeTrial": {
      "additionalProperties": false,
      "description": "The edge-alignment verdict for one candidate.",
      "properties": {
        "axes": {
          "items": {
            "$ref": "#/$defs/KITTIEdgeAxis"
          },
          "title": "Axes",
          "type": "array"
        },
        "candidate_id": {
          "enum": [
            "dataset_reference",
            "known_bad"
          ],
          "title": "Candidate Id",
          "type": "string"
        },
        "edge_points": {
          "minimum": 0,
          "title": "Edge Points",
          "type": "integer"
        },
        "frames": {
          "minimum": 0,
          "title": "Frames",
          "type": "integer"
        },
        "unchecked_rotation_axes": {
          "items": {
            "type": "string"
          },
          "title": "Unchecked Rotation Axes",
          "type": "array"
        },
        "verdict": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "inconclusive"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "verdict",
        "frames",
        "edge_points"
      ],
      "title": "KITTIEdgeTrial",
      "type": "object"
    },
    "KITTIFalsificationProvenance": {
      "additionalProperties": false,
      "description": "Benchmark generation lineage.",
      "properties": {
        "calibrex_version": {
          "title": "Calibrex Version",
          "type": "string"
        },
        "generated_at": {
          "title": "Generated At",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "producer": {
          "const": "calibrex",
          "default": "calibrex",
          "title": "Producer",
          "type": "string"
        },
        "source_config": {
          "title": "Source Config",
          "type": "string"
        },
        "source_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Config Sha256",
          "type": "string"
        }
      },
      "required": [
        "calibrex_version",
        "source_config",
        "source_config_sha256"
      ],
      "title": "KITTIFalsificationProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Decision artifact for the full-scale KITTI falsification run.",
  "properties": {
    "benchmark_id": {
      "const": "kitti_raw_2011_09_26_drive_0005_camera_lidar",
      "default": "kitti_raw_2011_09_26_drive_0005_camera_lidar",
      "title": "Benchmark Id",
      "type": "string"
    },
    "data_only": {
      "description": "data-only decisions: the spread selection first, then sensitivity rows",
      "items": {
        "$ref": "#/$defs/KITTIEdgeDecision"
      },
      "title": "Data Only",
      "type": "array"
    },
    "data_only_status": {
      "anyOf": [
        {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the decision of the images and scans alone (edge alignment with the calibrex check rule, frames spread over the drive); status above also counts the comparison with the dataset's calibration",
      "title": "Data Only Status"
    },
    "dataset_path": {
      "title": "Dataset Path",
      "type": "string"
    },
    "dataset_sequence": {
      "const": "2011_09_26_drive_0005_sync",
      "default": "2011_09_26_drive_0005_sync",
      "title": "Dataset Sequence",
      "type": "string"
    },
    "holdout_ratio": {
      "exclusiveMaximum": 1.0,
      "exclusiveMinimum": 0.0,
      "title": "Holdout Ratio",
      "type": "number"
    },
    "input_artifacts": {
      "items": {
        "$ref": "#/$defs/KITTIBenchmarkArtifactDigest"
      },
      "minItems": 2,
      "title": "Input Artifacts",
      "type": "array"
    },
    "known_bad_declaration": {
      "title": "Known Bad Declaration",
      "type": "string"
    },
    "known_bad_transform_camera_lidar": {
      "additionalProperties": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "title": "Known Bad Transform Camera Lidar",
      "type": "object"
    },
    "projection_sample_points": {
      "exclusiveMinimum": 0,
      "title": "Projection Sample Points",
      "type": "integer"
    },
    "protocol_id": {
      "title": "Protocol Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/KITTIFalsificationProvenance"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "schema_version": {
      "const": "slac.kitti_lidar_camera_falsification/v0.1",
      "default": "slac.kitti_lidar_camera_falsification/v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_frame_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "title": "Selected Frame Ids",
      "type": "array"
    },
    "source_note": {
      "title": "Source Note",
      "type": "string"
    },
    "source_url": {
      "title": "Source Url",
      "type": "string"
    },
    "split_seed": {
      "title": "Split Seed",
      "type": "integer"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "inconclusive"
      ],
      "title": "Status",
      "type": "string"
    },
    "trials": {
      "items": {
        "$ref": "#/$defs/KITTIBenchmarkTrial"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Trials",
      "type": "array"
    }
  },
  "required": [
    "dataset_path",
    "source_url",
    "source_note",
    "selected_frame_ids",
    "split_seed",
    "holdout_ratio",
    "projection_sample_points",
    "protocol_id",
    "known_bad_declaration",
    "known_bad_transform_camera_lidar",
    "status",
    "reason",
    "trials",
    "input_artifacts",
    "provenance"
  ],
  "title": "KITTIFalsificationBenchmarkArtifact",
  "type": "object"
}
