{
  "$defs": {
    "AssessmentPolicy": {
      "additionalProperties": false,
      "description": "Versioned policy metadata used to assess an evidence artifact.",
      "properties": {
        "parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Parameters",
          "type": "object"
        },
        "policy_id": {
          "default": "calibrex.falsification.lidar_pair/v0.1",
          "title": "Policy Id",
          "type": "string"
        },
        "status_semantics": {
          "default": "pass means all required gates passed; fail means at least one gate rejected the candidate; inconclusive means the evidence cannot support or reject the candidate under this policy",
          "title": "Status Semantics",
          "type": "string"
        }
      },
      "title": "AssessmentPolicy",
      "type": "object"
    },
    "AssessmentRuleResult": {
      "additionalProperties": false,
      "description": "One policy gate applied to an evidence artifact.",
      "properties": {
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "metric_ids": {
          "items": {
            "type": "string"
          },
          "title": "Metric Ids",
          "type": "array"
        },
        "observed": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Observed",
          "type": "object"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ],
          "title": "Status",
          "type": "string"
        },
        "thresholds": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Thresholds",
          "type": "object"
        }
      },
      "required": [
        "rule_id",
        "status",
        "reason"
      ],
      "title": "AssessmentRuleResult",
      "type": "object"
    },
    "AssessmentSourceEvidence": {
      "additionalProperties": false,
      "description": "Evidence artifact assessed by a policy.",
      "properties": {
        "data_verified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Verified"
        },
        "metrics_origin": {
          "title": "Metrics Origin",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "metrics_origin"
      ],
      "title": "AssessmentSourceEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Machine-readable falsification assessment.",
  "properties": {
    "policy": {
      "$ref": "#/$defs/AssessmentPolicy"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/AssessmentRuleResult"
      },
      "title": "Rules",
      "type": "array"
    },
    "schema_version": {
      "const": "calibrex.assessment/v0.1",
      "default": "calibrex.assessment/v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_evidence": {
      "$ref": "#/$defs/AssessmentSourceEvidence"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "inconclusive"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "source_evidence",
    "status",
    "reason"
  ],
  "title": "AssessmentArtifact",
  "type": "object"
}
