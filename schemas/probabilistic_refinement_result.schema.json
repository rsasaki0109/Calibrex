{
  "$defs": {
    "CorrespondenceProviderIdentity": {
      "additionalProperties": false,
      "description": "Identity and redistribution boundary of the external provider.",
      "properties": {
        "checkpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/DepthFileReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "checkpoint_redistribution": {
          "title": "Checkpoint Redistribution",
          "type": "string"
        },
        "license_spdx": {
          "title": "License Spdx",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "source_commit": {
          "title": "Source Commit",
          "type": "string"
        },
        "source_repository": {
          "title": "Source Repository",
          "type": "string"
        },
        "training": {
          "anyOf": [
            {
              "$ref": "#/$defs/CorrespondenceTrainingDeclaration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "version",
        "source_repository",
        "source_commit",
        "license_spdx",
        "checkpoint_redistribution"
      ],
      "title": "CorrespondenceProviderIdentity",
      "type": "object"
    },
    "CorrespondenceTrainingDeclaration": {
      "additionalProperties": false,
      "description": "Training-corpus relationship for a learned correspondence provider.",
      "properties": {
        "evaluation_overlap": {
          "enum": [
            "none",
            "possible",
            "confirmed",
            "unknown"
          ],
          "title": "Evaluation Overlap",
          "type": "string"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        },
        "test_data_used_for_online_refinement": {
          "title": "Test Data Used For Online Refinement",
          "type": "boolean"
        },
        "training_datasets": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Training Datasets",
          "type": "array"
        }
      },
      "required": [
        "training_datasets",
        "evaluation_overlap",
        "test_data_used_for_online_refinement",
        "evidence"
      ],
      "title": "CorrespondenceTrainingDeclaration",
      "type": "object"
    },
    "CovarianceInfo": {
      "additionalProperties": false,
      "properties": {
        "matrix": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Matrix",
          "type": "array"
        },
        "order": {
          "items": {
            "type": "string"
          },
          "title": "Order",
          "type": "array"
        }
      },
      "required": [
        "order",
        "matrix"
      ],
      "title": "CovarianceInfo",
      "type": "object"
    },
    "DepthFileReference": {
      "additionalProperties": false,
      "description": "Content-addressed depth-provider input or output file.",
      "properties": {
        "encoding": {
          "title": "Encoding",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "encoding"
      ],
      "title": "DepthFileReference",
      "type": "object"
    },
    "ProbabilisticRefinementEvaluationArtifact": {
      "additionalProperties": false,
      "description": "Schema-valid robust multi-frame reprojection evidence.",
      "properties": {
        "mean_mahalanobis_error": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Mahalanobis Error"
        },
        "objective": {
          "title": "Objective",
          "type": "number"
        },
        "skipped_correspondence_count": {
          "minimum": 0,
          "title": "Skipped Correspondence Count",
          "type": "integer"
        },
        "valid_correspondence_count": {
          "minimum": 0,
          "title": "Valid Correspondence Count",
          "type": "integer"
        },
        "weighted_reprojection_rmse_px": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weighted Reprojection Rmse Px"
        }
      },
      "required": [
        "objective",
        "valid_correspondence_count",
        "skipped_correspondence_count"
      ],
      "title": "ProbabilisticRefinementEvaluationArtifact",
      "type": "object"
    },
    "ProbabilisticRefinementIterationArtifact": {
      "additionalProperties": false,
      "description": "One retained bounded pose candidate.",
      "properties": {
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "delta_rotation_deg_xyz": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Delta Rotation Deg Xyz",
          "type": "array"
        },
        "delta_translation_m_xyz": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Delta Translation M Xyz",
          "type": "array"
        },
        "evaluation": {
          "exclusiveMinimum": 0,
          "title": "Evaluation",
          "type": "integer"
        },
        "objective": {
          "title": "Objective",
          "type": "number"
        }
      },
      "required": [
        "evaluation",
        "delta_rotation_deg_xyz",
        "delta_translation_m_xyz",
        "objective",
        "accepted"
      ],
      "title": "ProbabilisticRefinementIterationArtifact",
      "type": "object"
    },
    "ProbabilisticRefinementProvenance": {
      "additionalProperties": false,
      "description": "D2D initializer and learned correspondence lineage.",
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "correspondence_artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Correspondence Artifact Sha256",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "generator": {
          "title": "Generator",
          "type": "string"
        },
        "generator_version": {
          "title": "Generator Version",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "initialization_problem_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Initialization Problem Sha256",
          "type": "string"
        },
        "initialization_trace_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initialization Trace Sha256"
        }
      },
      "required": [
        "generator",
        "generator_version",
        "correspondence_artifact_sha256",
        "initialization_problem_sha256"
      ],
      "title": "ProbabilisticRefinementProvenance",
      "type": "object"
    },
    "TransformEstimateProvenance": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Version"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "evidence_level": {
          "default": "unknown",
          "enum": [
            "synthetic_truth",
            "independently_measured",
            "dataset_provided",
            "factory_provided",
            "algorithmically_refined",
            "imported_without_documented_derivation",
            "unknown"
          ],
          "title": "Evidence Level",
          "type": "string"
        },
        "execution_mode": {
          "default": "unknown",
          "enum": [
            "offline_batch",
            "sliding_window",
            "online_stream",
            "manual",
            "imported",
            "dataset_reference",
            "unknown"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "license_spdx": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Spdx"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "producer": {
          "default": "unknown",
          "enum": [
            "slac_native",
            "external_tool",
            "human",
            "dataset_provider",
            "factory",
            "unknown"
          ],
          "title": "Producer",
          "type": "string"
        },
        "role_in_comparison": {
          "anyOf": [
            {
              "enum": [
                "initial",
                "candidate",
                "selected_reference",
                "output",
                "comparison_baseline"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role In Comparison"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "source_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Commit"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Path"
        },
        "tool_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Name"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        }
      },
      "title": "TransformEstimateProvenance",
      "type": "object"
    },
    "TransformQuality": {
      "additionalProperties": false,
      "properties": {
        "grade": {
          "default": "warn",
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "title": "Grade",
          "type": "string"
        },
        "std_rotation_deg": {
          "items": {
            "type": "number"
          },
          "title": "Std Rotation Deg",
          "type": "array"
        },
        "std_translation_m": {
          "items": {
            "type": "number"
          },
          "title": "Std Translation M",
          "type": "array"
        }
      },
      "title": "TransformQuality",
      "type": "object"
    },
    "TransformResult": {
      "additionalProperties": false,
      "properties": {
        "child": {
          "title": "Child",
          "type": "string"
        },
        "convention": {
          "const": "T_parent_child",
          "default": "T_parent_child",
          "title": "Convention",
          "type": "string"
        },
        "covariance": {
          "anyOf": [
            {
              "$ref": "#/$defs/CovarianceInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "estimate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimate Id"
        },
        "parent": {
          "title": "Parent",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/TransformEstimateProvenance"
        },
        "quality": {
          "$ref": "#/$defs/TransformQuality"
        },
        "rotation_quat_xyzw": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Rotation Quat Xyzw",
          "type": "array"
        },
        "translation_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Translation M",
          "type": "array"
        }
      },
      "required": [
        "parent",
        "child",
        "translation_m",
        "rotation_quat_xyzw"
      ],
      "title": "TransformResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema-valid multi-frame refinement with explicit initialization.",
  "properties": {
    "correspondence_artifact_id": {
      "title": "Correspondence Artifact Id",
      "type": "string"
    },
    "final_holdout_evaluation": {
      "$ref": "#/$defs/ProbabilisticRefinementEvaluationArtifact"
    },
    "final_rotation_error_deg": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Rotation Error Deg"
    },
    "final_train_evaluation": {
      "$ref": "#/$defs/ProbabilisticRefinementEvaluationArtifact"
    },
    "final_translation_error_m": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Translation Error M"
    },
    "holdout_frame_ids": {
      "items": {
        "type": "string"
      },
      "title": "Holdout Frame Ids",
      "type": "array"
    },
    "initial_holdout_evaluation": {
      "$ref": "#/$defs/ProbabilisticRefinementEvaluationArtifact"
    },
    "initial_rotation_error_deg": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initial Rotation Error Deg"
    },
    "initial_train_evaluation": {
      "$ref": "#/$defs/ProbabilisticRefinementEvaluationArtifact"
    },
    "initial_transform_camera_lidar": {
      "$ref": "#/$defs/TransformResult"
    },
    "initial_translation_error_m": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initial Translation Error M"
    },
    "initialization_problem_id": {
      "title": "Initialization Problem Id",
      "type": "string"
    },
    "initialization_source": {
      "default": "problem_initial_transform",
      "enum": [
        "problem_initial_transform",
        "d2d_candidate_trace"
      ],
      "title": "Initialization Source",
      "type": "string"
    },
    "initialization_trace_hit": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initialization Trace Hit"
    },
    "initialization_trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initialization Trace Id"
    },
    "initialization_trace_status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initialization Trace Status"
    },
    "method": {
      "default": "probabilistic_multiframe_refinement/v0.2",
      "enum": [
        "d2d_initialized_probabilistic_multiframe_refinement/v0.1",
        "probabilistic_multiframe_refinement/v0.2"
      ],
      "title": "Method",
      "type": "string"
    },
    "options": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "title": "Options",
      "type": "object"
    },
    "provenance": {
      "$ref": "#/$defs/ProbabilisticRefinementProvenance"
    },
    "provider": {
      "$ref": "#/$defs/CorrespondenceProviderIdentity"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "reference_transform_camera_lidar": {
      "anyOf": [
        {
          "$ref": "#/$defs/TransformResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "result_id": {
      "title": "Result Id",
      "type": "string"
    },
    "schema_version": {
      "const": "slac.probabilistic_refinement_result/v0.1",
      "default": "slac.probabilistic_refinement_result/v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "converged",
        "max_evaluations",
        "insufficient_correspondences",
        "missing_holdout",
        "at_bound"
      ],
      "title": "Status",
      "type": "string"
    },
    "trace": {
      "items": {
        "$ref": "#/$defs/ProbabilisticRefinementIterationArtifact"
      },
      "title": "Trace",
      "type": "array"
    },
    "train_frame_ids": {
      "items": {
        "type": "string"
      },
      "title": "Train Frame Ids",
      "type": "array"
    },
    "transform_camera_lidar": {
      "$ref": "#/$defs/TransformResult"
    }
  },
  "required": [
    "result_id",
    "status",
    "reason",
    "correspondence_artifact_id",
    "initialization_problem_id",
    "provider",
    "initial_transform_camera_lidar",
    "transform_camera_lidar",
    "train_frame_ids",
    "holdout_frame_ids",
    "initial_train_evaluation",
    "final_train_evaluation",
    "initial_holdout_evaluation",
    "final_holdout_evaluation",
    "trace",
    "options",
    "provenance"
  ],
  "title": "ProbabilisticRefinementResultArtifact",
  "type": "object"
}
