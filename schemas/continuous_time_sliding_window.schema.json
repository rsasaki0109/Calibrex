{
  "$defs": {
    "ClockDomainEvidence": {
      "additionalProperties": false,
      "description": "Bounds and rejected candidates; not a constrained-optimality certificate.",
      "properties": {
        "derivative_step_sec": {
          "title": "Derivative Step Sec",
          "type": "number"
        },
        "lower_sec": {
          "title": "Lower Sec",
          "type": "number"
        },
        "opposite_gradient_norm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opposite Gradient Norm"
        },
        "rejected_steps": {
          "minimum": 0,
          "title": "Rejected Steps",
          "type": "integer"
        },
        "upper_sec": {
          "title": "Upper Sec",
          "type": "number"
        }
      },
      "required": [
        "lower_sec",
        "upper_sec",
        "rejected_steps",
        "derivative_step_sec"
      ],
      "title": "ClockDomainEvidence",
      "type": "object"
    },
    "ContinuousTimeSlidingWindowProvenance": {
      "additionalProperties": false,
      "description": "Seeded synthetic recovery lineage.",
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "generator": {
          "title": "Generator",
          "type": "string"
        },
        "generator_version": {
          "title": "Generator Version",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "generator",
        "generator_version",
        "seed"
      ],
      "title": "ContinuousTimeSlidingWindowProvenance",
      "type": "object"
    },
    "FitDiagnostics": {
      "additionalProperties": false,
      "description": "Final-state evidence, not an observability or accuracy certificate.\n\nThe gradient is divided by each weighted Jacobian column norm and by\nmax(1, ||weighted residual||). This is invariant to independent linear\nchanges of parameter units, without adding information in weak directions.\nZero columns contribute zero (and must be assessed for observability\nseparately). The stationarity threshold is recorded with the measurement.",
      "properties": {
        "clock_domain": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClockDomainEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gradient_tolerance": {
          "exclusiveMinimum": 0,
          "title": "Gradient Tolerance",
          "type": "number"
        },
        "normalized_gradient_norm": {
          "minimum": 0,
          "title": "Normalized Gradient Norm",
          "type": "number"
        },
        "stationary": {
          "title": "Stationary",
          "type": "boolean"
        },
        "termination_reason": {
          "enum": [
            "gradient_tolerance",
            "stationarity_not_confirmed",
            "small_step",
            "small_cost_change",
            "damping_limit",
            "clock_domain_limit",
            "iteration_limit",
            "singular_system"
          ],
          "title": "Termination Reason",
          "type": "string"
        }
      },
      "required": [
        "termination_reason",
        "normalized_gradient_norm",
        "gradient_tolerance",
        "stationary"
      ],
      "title": "FitDiagnostics",
      "type": "object"
    },
    "KnotInformationEvidence": {
      "additionalProperties": false,
      "description": "Numerical rank at a fixed linearization, not a global observability proof.",
      "properties": {
        "eigenvalue_threshold": {
          "minimum": 0,
          "title": "Eigenvalue Threshold",
          "type": "number"
        },
        "nullspace_participation": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Nullspace Participation",
          "type": "object"
        },
        "numerical_nullity": {
          "minimum": 0,
          "title": "Numerical Nullity",
          "type": "integer"
        },
        "numerical_rank": {
          "minimum": 0,
          "title": "Numerical Rank",
          "type": "integer"
        },
        "parameter_count": {
          "minimum": 1,
          "title": "Parameter Count",
          "type": "integer"
        },
        "relative_eigenvalue_tolerance": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Relative Eigenvalue Tolerance",
          "type": "number"
        },
        "scaled_eigenvalues": {
          "items": {
            "type": "number"
          },
          "title": "Scaled Eigenvalues",
          "type": "array"
        },
        "zero_information_parameters": {
          "items": {
            "type": "string"
          },
          "title": "Zero Information Parameters",
          "type": "array"
        }
      },
      "required": [
        "parameter_count",
        "numerical_rank",
        "numerical_nullity",
        "relative_eigenvalue_tolerance",
        "eigenvalue_threshold",
        "scaled_eigenvalues",
        "zero_information_parameters",
        "nullspace_participation"
      ],
      "title": "KnotInformationEvidence",
      "type": "object"
    },
    "SchurEliminationEvidence": {
      "additionalProperties": false,
      "description": "Numerical elimination rank and range checks in diagonally scaled coordinates.",
      "properties": {
        "coupled_nullity": {
          "minimum": 0,
          "title": "Coupled Nullity",
          "type": "integer"
        },
        "eigenvalue_threshold": {
          "minimum": 0,
          "title": "Eigenvalue Threshold",
          "type": "number"
        },
        "eliminated_dimension": {
          "minimum": 0,
          "title": "Eliminated Dimension",
          "type": "integer"
        },
        "max_relative_range_error": {
          "minimum": 0,
          "title": "Max Relative Range Error",
          "type": "number"
        },
        "numerical_rank": {
          "minimum": 0,
          "title": "Numerical Rank",
          "type": "integer"
        },
        "relative_range_tolerance": {
          "exclusiveMinimum": 0,
          "title": "Relative Range Tolerance",
          "type": "number"
        },
        "zero_information_dimension": {
          "minimum": 0,
          "title": "Zero Information Dimension",
          "type": "integer"
        }
      },
      "required": [
        "eliminated_dimension",
        "numerical_rank",
        "zero_information_dimension",
        "coupled_nullity",
        "eigenvalue_threshold",
        "relative_range_tolerance",
        "max_relative_range_error"
      ],
      "title": "SchurEliminationEvidence",
      "type": "object"
    },
    "WindowObservabilityEvidence": {
      "additionalProperties": false,
      "description": "Separate measurement information from information inherited through priors.",
      "properties": {
        "elimination": {
          "anyOf": [
            {
              "$ref": "#/$defs/SchurEliminationEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "frozen_parameters": {
          "items": {
            "type": "string"
          },
          "title": "Frozen Parameters",
          "type": "array"
        },
        "global_knot_indices": {
          "items": {
            "type": "integer"
          },
          "title": "Global Knot Indices",
          "type": "array"
        },
        "measurements": {
          "$ref": "#/$defs/KnotInformationEvidence"
        },
        "window_index": {
          "minimum": 0,
          "title": "Window Index",
          "type": "integer"
        },
        "with_marginal_prior": {
          "$ref": "#/$defs/KnotInformationEvidence"
        }
      },
      "required": [
        "window_index",
        "global_knot_indices",
        "measurements",
        "with_marginal_prior"
      ],
      "title": "WindowObservabilityEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Holdout and known-bad evidence for sliding-window marginalization.",
  "properties": {
    "batch_fit_status": {
      "enum": [
        "converged",
        "max_iterations",
        "singular_system",
        "stalled"
      ],
      "title": "Batch Fit Status",
      "type": "string"
    },
    "batch_holdout_rmse_m": {
      "minimum": 0.0,
      "title": "Batch Holdout Rmse M",
      "type": "number"
    },
    "holdout_measurement_count": {
      "minimum": 1,
      "title": "Holdout Measurement Count",
      "type": "integer"
    },
    "interpolation": {
      "const": "screw_linear",
      "title": "Interpolation",
      "type": "string"
    },
    "knot_count": {
      "minimum": 2,
      "title": "Knot Count",
      "type": "integer"
    },
    "known_bad_overlap_translation_error_m": {
      "minimum": 0.0,
      "title": "Known Bad Overlap Translation Error M",
      "type": "number"
    },
    "known_bad_rmse_delta_m": {
      "title": "Known Bad Rmse Delta M",
      "type": "number"
    },
    "known_bad_skip_marginalization": {
      "title": "Known Bad Skip Marginalization",
      "type": "boolean"
    },
    "max_overlap_rotation_error_rad": {
      "minimum": 0.0,
      "title": "Max Overlap Rotation Error Rad",
      "type": "number"
    },
    "max_overlap_translation_error_m": {
      "minimum": 0.0,
      "title": "Max Overlap Translation Error M",
      "type": "number"
    },
    "overlap_knot_count": {
      "minimum": 1,
      "title": "Overlap Knot Count",
      "type": "integer"
    },
    "policy_reason": {
      "title": "Policy Reason",
      "type": "string"
    },
    "policy_status": {
      "enum": [
        "pass",
        "fail"
      ],
      "title": "Policy Status",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/ContinuousTimeSlidingWindowProvenance"
    },
    "recovery_id": {
      "title": "Recovery Id",
      "type": "string"
    },
    "schema_version": {
      "const": "slac.continuous_time_sliding_window/v0.1",
      "default": "slac.continuous_time_sliding_window/v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "sliding_fit_diagnostics": {
      "anyOf": [
        {
          "$ref": "#/$defs/FitDiagnostics"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sliding_fit_status": {
      "enum": [
        "converged",
        "max_iterations",
        "singular_system",
        "stalled"
      ],
      "title": "Sliding Fit Status",
      "type": "string"
    },
    "sliding_holdout_rmse_m": {
      "minimum": 0.0,
      "title": "Sliding Holdout Rmse M",
      "type": "number"
    },
    "train_measurement_count": {
      "minimum": 1,
      "title": "Train Measurement Count",
      "type": "integer"
    },
    "window_count": {
      "minimum": 2,
      "title": "Window Count",
      "type": "integer"
    },
    "window_fit_statuses": {
      "items": {
        "enum": [
          "converged",
          "max_iterations",
          "singular_system",
          "stalled"
        ],
        "type": "string"
      },
      "title": "Window Fit Statuses",
      "type": "array"
    },
    "window_observability": {
      "items": {
        "$ref": "#/$defs/WindowObservabilityEvidence"
      },
      "title": "Window Observability",
      "type": "array"
    }
  },
  "required": [
    "recovery_id",
    "interpolation",
    "seed",
    "knot_count",
    "window_count",
    "overlap_knot_count",
    "train_measurement_count",
    "holdout_measurement_count",
    "batch_fit_status",
    "sliding_fit_status",
    "max_overlap_translation_error_m",
    "max_overlap_rotation_error_rad",
    "batch_holdout_rmse_m",
    "sliding_holdout_rmse_m",
    "known_bad_overlap_translation_error_m",
    "known_bad_rmse_delta_m",
    "known_bad_skip_marginalization",
    "policy_status",
    "policy_reason",
    "provenance"
  ],
  "title": "ContinuousTimeSlidingWindowArtifact",
  "type": "object"
}
