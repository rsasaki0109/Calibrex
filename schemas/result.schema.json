        "domain": {
          "default": "robotics",
          "title": "Domain",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "provenance": {
          "description": "Versioned provenance for new results. Legacy v0.1 maps are readable but are not production-admissible.",
          "oneOf": [
            {
              "$ref": "#/$defs/ResultProvenance"
            },
            {
              "additionalProperties": true,
              "minProperties": 1,
              "not": {
                "required": [
                  "provenance_version"
                ]
              },
              "type": "object"
            }
          ]
        },
        "slac_version": {
          "title": "Slac Version",
          "type": "string"
        },
        "status": {
          "default": "success",
          "enum": [
            "success",
            "warning",
            "failed",
            "dry_run"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "slac_version"
      ],
      "title": "RunInfo",
      "type": "object"
    },
