          "minItems": 1,
          "title": "Seed Results",
          "type": "array"
        }
      },
      "required": [
        "candidate_id",
        "minimum_confidence",
        "ransac_reprojection_threshold_px",
        "seed_results",
        "all_seeds_converged",
        "minimum_selected_frame_count",
        "minimum_selected_correspondence_count",
        "minimum_ransac_inlier_count",
        "gate_pass"
      ],
      "title": "CameraLidarInitializerCalibrationCandidate",
      "type": "object"
    },
    "CameraLidarInitializerCalibrationProvenance": {
