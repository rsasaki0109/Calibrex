      "type": "object"
    },
    "CameraLidarInitializerSeedResult": {
      "additionalProperties": false,
      "description": "One deterministic OpenCV seed outcome for a grid candidate.",
      "properties": {
        "random_seed": {
          "title": "Random Seed",
          "type": "integer"
        },
        "ransac_inlier_count": {
          "minimum": 0,
          "title": "Ransac Inlier Count",
          "type": "integer"
        },
        "ransac_inlier_reprojection_rmse_px": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ransac Inlier Reprojection Rmse Px"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "rotation_error_deg": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rotation Error Deg"
        },
        "selected_correspondence_count": {
          "minimum": 0,
          "title": "Selected Correspondence Count",
          "type": "integer"
        },
        "source_frame_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Frame Ids",
          "type": "array"
