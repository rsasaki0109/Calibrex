        "frame_selection_rule_id": {
          "const": "minimum_effective_confidence_and_frame_correspondence_support/v0.1",
          "default": "minimum_effective_confidence_and_frame_correspondence_support/v0.1",
          "title": "Frame Selection Rule Id",
          "type": "string"
        },
        "initialization_source": {
          "const": "none",
          "default": "none",
          "title": "Initialization Source",
          "type": "string"
        },
        "mahalanobis_inlier_threshold": {
          "exclusiveMinimum": 0.0,
          "title": "Mahalanobis Inlier Threshold",
          "type": "number"
        },
        "method": {
          "const": "opencv_probabilistic_aggregate_pnp_ransac/v0.3",
          "default": "opencv_probabilistic_aggregate_pnp_ransac/v0.3",
          "title": "Method",
          "type": "string"
        },
        "minimum_confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Minimum Confidence",
          "type": "number"
        },
        "minimum_correspondences": {
          "minimum": 4,
          "title": "Minimum Correspondences",
          "type": "integer"
        },
        "minimum_frame_correspondences": {
          "minimum": 4,
          "title": "Minimum Frame Correspondences",
          "type": "integer"
        },
        "minimum_frames": {
          "minimum": 1,
          "title": "Minimum Frames",
          "type": "integer"
        },
        "opencv_version": {
          "title": "Opencv Version",
          "type": "string"
        },
        "ransac_confidence": {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Ransac Confidence",
          "type": "number"
        },
        "ransac_iterations": {
          "minimum": 1,
          "title": "Ransac Iterations",
          "type": "integer"
        },
        "ransac_reprojection_threshold_px": {
          "exclusiveMinimum": 0.0,
          "title": "Ransac Reprojection Threshold Px",
          "type": "number"
        }
      },
      "required": [
        "adapter_version",
        "opencv_version",
        "minimum_confidence",
        "minimum_correspondences",
        "minimum_frame_correspondences",
        "minimum_frames",
        "ransac_reprojection_threshold_px",
        "ransac_confidence",
        "ransac_iterations",
        "mahalanobis_inlier_threshold",
        "evaluation_random_seeds"
      ],
      "title": "CameraLidarLockedInitializerOptions",
      "type": "object"
