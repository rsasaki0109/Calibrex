          },
          "title": "Gate Reasons",
          "type": "array"
        },
        "maximum_pairwise_seed_rotation_delta_deg": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Pairwise Seed Rotation Delta Deg"
        },
        "maximum_pairwise_seed_translation_delta_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Pairwise Seed Translation Delta M"
        },
        "maximum_ransac_inlier_reprojection_rmse_px": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Ransac Inlier Reprojection Rmse Px"
        },
        "maximum_rotation_error_deg": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Rotation Error Deg"
        },
        "maximum_translation_error_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Translation Error M"
        },
        "minimum_confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Minimum Confidence",
          "type": "number"
        },
        "minimum_ransac_inlier_count": {
          "minimum": 0,
          "title": "Minimum Ransac Inlier Count",
          "type": "integer"
        },
        "minimum_selected_correspondence_count": {
          "minimum": 0,
          "title": "Minimum Selected Correspondence Count",
          "type": "integer"
        },
        "minimum_selected_frame_count": {
          "minimum": 0,
          "title": "Minimum Selected Frame Count",
          "type": "integer"
        },
        "ransac_reprojection_threshold_px": {
          "exclusiveMinimum": 0.0,
          "title": "Ransac Reprojection Threshold Px",
          "type": "number"
        },
        "seed_results": {
          "items": {
            "$ref": "#/$defs/CameraLidarInitializerSeedResult"
