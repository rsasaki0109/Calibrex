        },
        "minimum_selected_correspondence_count": {
          "minimum": 4,
          "title": "Minimum Selected Correspondence Count",
          "type": "integer"
        },
        "minimum_selected_frame_count": {
          "minimum": 1,
          "title": "Minimum Selected Frame Count",
          "type": "integer"
        },
        "rotation_error_max_deg": {
          "exclusiveMinimum": 0.0,
          "title": "Rotation Error Max Deg",
