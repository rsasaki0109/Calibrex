        "random_seed",
        "status",
        "selected_correspondence_count",
        "ransac_inlier_count",
        "reason"
      ],
      "title": "CameraLidarInitializerSeedResult",
      "type": "object"
    },
    "CameraLidarLockedInitializerOptions": {
      "additionalProperties": false,
      "description": "Exact provider-independent aggregate PnP options frozen on development.",
      "properties": {
        "adapter_version": {
          "title": "Adapter Version",
          "type": "string"
        },
        "evaluation_random_seeds": {
          "items": {
            "type": "integer"
