{
  "$defs": {
    "ContinuousTimeLidarPairIterationArtifact": {
      "additionalProperties": false,
      "description": "One recorded clock-profile iteration.",
      "properties": {
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "candidate_holdout_rmse_m": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Candidate Holdout Rmse M",
          "type": "array"
        },
        "candidate_offsets_sec": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Candidate Offsets Sec",
          "type": "array"
        },
        "candidate_train_rmse_m": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Candidate Train Rmse M",
          "type": "array"
        },
        "holdout_rmse_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holdout Rmse M"
        },
        "iteration": {
          "minimum": 1,
          "title": "Iteration",
          "type": "integer"
        },
        "selected_offset_sec": {
          "title": "Selected Offset Sec",
          "type": "number"
        },
        "train_rmse_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train Rmse M"
        }
      },
      "required": [
        "iteration",
        "candidate_offsets_sec",
        "selected_offset_sec",
        "accepted"
      ],
      "title": "ContinuousTimeLidarPairIterationArtifact",
      "type": "object"
    },
    "ContinuousTimeLidarPairObservability": {
      "additionalProperties": false,
      "description": "Local six-DoF evidence at the selected profile solution.",
      "properties": {
        "condition_number": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition Number"
        },
        "rank": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "residual_count": {
          "default": 0,
          "minimum": 0,
          "title": "Residual Count",
          "type": "integer"
        },
        "weak_directions": {
          "items": {
            "type": "string"
          },
          "title": "Weak Directions",
          "type": "array"
        }
      },
      "title": "ContinuousTimeLidarPairObservability",
      "type": "object"
    },
    "ContinuousTimeLidarPairOptionsArtifact": {
      "additionalProperties": false,
      "description": "Profile and fixed-extrinsic solver settings recorded in the result.",
      "properties": {
        "adaptive_max_voxel_size_m": {
          "exclusiveMinimum": 0.0,
          "title": "Adaptive Max Voxel Size M",
          "type": "number"
        },
        "adaptive_min_points_per_voxel": {
          "minimum": 1,
          "title": "Adaptive Min Points Per Voxel",
          "type": "integer"
        },
        "adaptive_min_voxel_size_m": {
          "exclusiveMinimum": 0.0,
          "title": "Adaptive Min Voxel Size M",
          "type": "number"
        },
        "adaptive_range_exponent": {
          "minimum": 0.0,
          "title": "Adaptive Range Exponent",
          "type": "number"
        },
        "adaptive_range_reference_m": {
          "exclusiveMinimum": 0.0,
          "title": "Adaptive Range Reference M",
          "type": "number"
        },
        "adaptive_use_uniform_fallback": {
          "default": true,
          "title": "Adaptive Use Uniform Fallback",
          "type": "boolean"
        },
        "correspondence_refinement_iterations": {
          "minimum": 0,
          "title": "Correspondence Refinement Iterations",
          "type": "integer"
        },
        "fixed_extrinsic_max_iterations": {
          "minimum": 0,
          "title": "Fixed Extrinsic Max Iterations",
          "type": "integer"
        },
        "fixed_extrinsic_robust_loss": {
          "enum": [
            "none",
            "huber"
          ],
          "title": "Fixed Extrinsic Robust Loss",
          "type": "string"
        },
        "holdout_start_fraction": {
          "default": 0.8,
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Holdout Start Fraction",
          "type": "number"
        },
        "initial_time_offset_sec": {
          "title": "Initial Time Offset Sec",
          "type": "number"
        },
        "initial_time_step_sec": {
          "exclusiveMinimum": 0.0,
          "title": "Initial Time Step Sec",
          "type": "number"
        },
        "max_abs_time_offset_sec": {
          "minimum": 0.0,
          "title": "Max Abs Time Offset Sec",
          "type": "number"
        },
        "max_iterations": {
          "minimum": 1,
          "title": "Max Iterations",
          "type": "integer"
        },
        "max_odometry_extrapolation_s": {
          "minimum": 0.0,
          "title": "Max Odometry Extrapolation S",
          "type": "number"
        },
        "max_source_records": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Source Records"
        },
        "max_target_points_per_split": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Target Points Per Split"
        },
        "min_correspondences": {
          "minimum": 1,
          "title": "Min Correspondences",
          "type": "integer"
        },
        "minimum_time_step_sec": {
          "exclusiveMinimum": 0.0,
          "title": "Minimum Time Step Sec",
          "type": "number"
        },
        "outlier_mad_scale": {
          "minimum": 0.0,
          "title": "Outlier Mad Scale",
          "type": "number"
        },
        "outlier_min_inlier_fraction": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Outlier Min Inlier Fraction",
          "type": "number"
        },
        "outlier_min_threshold_m": {
          "minimum": 0.0,
          "title": "Outlier Min Threshold M",
          "type": "number"
        },
        "outlier_policy": {
          "enum": [
            "none",
            "mad"
          ],
          "title": "Outlier Policy",
          "type": "string"
        },
        "sampling_seed": {
          "default": 0,
          "title": "Sampling Seed",
          "type": "integer"
        },
        "voxel_strategy": {
          "enum": [
            "uniform",
            "adaptive"
          ],
          "title": "Voxel Strategy",
          "type": "string"
        }
      },
      "required": [
        "initial_time_offset_sec",
        "max_abs_time_offset_sec",
        "initial_time_step_sec",
        "minimum_time_step_sec",
        "max_iterations",
        "min_correspondences",
        "max_odometry_extrapolation_s",
        "outlier_policy",
        "outlier_mad_scale",
        "outlier_min_threshold_m",
        "outlier_min_inlier_fraction",
        "voxel_strategy",
        "adaptive_range_reference_m",
        "adaptive_range_exponent",
        "adaptive_min_voxel_size_m",
        "adaptive_max_voxel_size_m",
        "adaptive_min_points_per_voxel",
        "correspondence_refinement_iterations",
        "fixed_extrinsic_max_iterations",
        "fixed_extrinsic_robust_loss"
      ],
      "title": "ContinuousTimeLidarPairOptionsArtifact",
      "type": "object"
    },
    "ContinuousTimeLidarPairProvenance": {
      "additionalProperties": false,
      "description": "Input digests and generation metadata.",
      "properties": {
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "source_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Source Paths",
          "type": "array"
        },
        "source_sha256": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 2,
          "title": "Source Sha256",
          "type": "object"
        },
        "tool_name": {
          "default": "calibrex",
          "title": "Tool Name",
          "type": "string"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        }
      },
      "required": [
        "source_paths",
        "source_sha256"
      ],
      "title": "ContinuousTimeLidarPairProvenance",
      "type": "object"
    },
    "ContinuousTimeLidarTrainDiagnostics": {
      "additionalProperties": false,
      "description": "Detailed evidence that is safe to use for train-only solver decisions.",
      "properties": {
        "final_residuals": {
          "$ref": "#/$defs/ContinuousTimeLidarTrainResidualSummary"
        },
        "holdout_used_for_selection": {
          "const": false,
          "default": false,
          "title": "Holdout Used For Selection",
          "type": "boolean"
        },
        "profile": {
          "items": {
            "$ref": "#/$defs/ContinuousTimeLidarTrainProfilePoint"
          },
          "title": "Profile",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/ContinuousTimeLidarTrainDiagnosticsProvenance"
        },
        "range_bins": {
          "items": {
            "$ref": "#/$defs/ContinuousTimeLidarTrainRangeBin"
          },
          "minItems": 1,
          "title": "Range Bins",
          "type": "array"
        },
        "sampled_source_record_count": {
          "minimum": 0,
          "title": "Sampled Source Record Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "slac.continuous_time_lidar_train_diagnostics/v0.1",
          "default": "slac.continuous_time_lidar_train_diagnostics/v0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_time_offset_sec": {
          "title": "Selected Time Offset Sec",
          "type": "number"
        },
        "selection_metric": {
          "const": "train_rmse_m",
          "default": "train_rmse_m",
          "title": "Selection Metric",
          "type": "string"
        },
        "train_candidate_correspondence_count": {
          "minimum": 0,
          "title": "Train Candidate Correspondence Count",
          "type": "integer"
        },
        "train_correspondence_count": {
          "minimum": 0,
          "title": "Train Correspondence Count",
          "type": "integer"
        },
        "train_outlier_rejected_count": {
          "minimum": 0,
          "title": "Train Outlier Rejected Count",
          "type": "integer"
        },
        "train_outlier_rejection_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Train Outlier Rejection Rate",
          "type": "number"
        },
        "train_target_point_count": {
          "minimum": 0,
          "title": "Train Target Point Count",
          "type": "integer"
        }
      },
      "required": [
        "sampled_source_record_count",
        "train_target_point_count",
        "train_candidate_correspondence_count",
        "train_correspondence_count",
        "train_outlier_rejected_count",
        "train_outlier_rejection_rate",
        "selected_time_offset_sec",
        "final_residuals",
        "range_bins",
        "provenance"
      ],
      "title": "ContinuousTimeLidarTrainDiagnostics",
      "type": "object"
    },
    "ContinuousTimeLidarTrainDiagnosticsProvenance": {
      "additionalProperties": false,
      "description": "Input digests and generation metadata for train diagnostics.",
      "properties": {
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "source_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Source Paths",
          "type": "array"
        },
        "source_sha256": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 2,
          "title": "Source Sha256",
          "type": "object"
        },
        "tool_name": {
          "default": "calibrex",
          "title": "Tool Name",
          "type": "string"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        }
      },
      "required": [
        "source_paths",
        "source_sha256"
      ],
      "title": "ContinuousTimeLidarTrainDiagnosticsProvenance",
      "type": "object"
    },
    "ContinuousTimeLidarTrainProfilePoint": {
      "additionalProperties": false,
      "description": "One clock-profile step with train-only candidate evidence.",
      "properties": {
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "candidate_offsets_sec": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Candidate Offsets Sec",
          "type": "array"
        },
        "candidate_train_rmse_m": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "minItems": 1,
          "title": "Candidate Train Rmse M",
          "type": "array"
        },
        "iteration": {
          "minimum": 1,
          "title": "Iteration",
          "type": "integer"
        },
        "selected_offset_sec": {
          "title": "Selected Offset Sec",
          "type": "number"
        },
        "train_correspondence_count": {
          "minimum": 0,
          "title": "Train Correspondence Count",
          "type": "integer"
        },
        "train_outlier_rejected_count": {
          "minimum": 0,
          "title": "Train Outlier Rejected Count",
          "type": "integer"
        },
        "train_rmse_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train Rmse M"
        }
      },
      "required": [
        "iteration",
        "candidate_offsets_sec",
        "candidate_train_rmse_m",
        "selected_offset_sec",
        "train_correspondence_count",
        "train_outlier_rejected_count",
        "accepted"
      ],
      "title": "ContinuousTimeLidarTrainProfilePoint",
      "type": "object"
    },
    "ContinuousTimeLidarTrainRangeBin": {
      "additionalProperties": false,
      "description": "Residual summary for one deterministic LiDAR-range interval.",
      "properties": {
        "correspondence_count": {
          "minimum": 0,
          "title": "Correspondence Count",
          "type": "integer"
        },
        "lower_bound_m": {
          "minimum": 0.0,
          "title": "Lower Bound M",
          "type": "number"
        },
        "residuals": {
          "$ref": "#/$defs/ContinuousTimeLidarTrainResidualSummary"
        },
        "upper_bound_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper Bound M"
        }
      },
      "required": [
        "lower_bound_m",
        "correspondence_count",
        "residuals"
      ],
      "title": "ContinuousTimeLidarTrainRangeBin",
      "type": "object"
    },
    "ContinuousTimeLidarTrainResidualSummary": {
      "additionalProperties": false,
      "description": "Distribution summary of residuals from the final train factor.",
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "max_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max M"
        },
        "mean_abs_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Abs M"
        },
        "mean_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean M"
        },
        "median_abs_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median Abs M"
        },
        "min_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min M"
        },
        "p95_abs_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P95 Abs M"
        },
        "p99_abs_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P99 Abs M"
        },
        "rmse_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rmse M"
        }
      },
      "required": [
        "count"
      ],
      "title": "ContinuousTimeLidarTrainResidualSummary",
      "type": "object"
    },
    "CovarianceInfo": {
      "additionalProperties": false,
      "properties": {
        "matrix": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Matrix",
          "type": "array"
        },
        "order": {
          "items": {
            "type": "string"
          },
          "title": "Order",
          "type": "array"
        }
      },
      "required": [
        "order",
        "matrix"
      ],
      "title": "CovarianceInfo",
      "type": "object"
    },
    "TransformEstimateProvenance": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Version"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "evidence_level": {
          "default": "unknown",
          "enum": [
            "synthetic_truth",
            "independently_measured",
            "dataset_provided",
            "factory_provided",
            "algorithmically_refined",
            "imported_without_documented_derivation",
            "unknown"
          ],
          "title": "Evidence Level",
          "type": "string"
        },
        "execution_mode": {
          "default": "unknown",
          "enum": [
            "offline_batch",
            "sliding_window",
            "online_stream",
            "manual",
            "imported",
            "dataset_reference",
            "unknown"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "license_spdx": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Spdx"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "producer": {
          "default": "unknown",
          "enum": [
            "slac_native",
            "external_tool",
            "human",
            "dataset_provider",
            "factory",
            "unknown"
          ],
          "title": "Producer",
          "type": "string"
        },
        "role_in_comparison": {
          "anyOf": [
            {
              "enum": [
                "initial",
                "candidate",
                "selected_reference",
                "output",
                "comparison_baseline"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role In Comparison"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "source_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Commit"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Path"
        },
        "tool_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Name"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        }
      },
      "title": "TransformEstimateProvenance",
      "type": "object"
    },
    "TransformQuality": {
      "additionalProperties": false,
      "properties": {
        "grade": {
          "default": "warn",
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "title": "Grade",
          "type": "string"
        },
        "std_rotation_deg": {
          "items": {
            "type": "number"
          },
          "title": "Std Rotation Deg",
          "type": "array"
        },
        "std_translation_m": {
          "items": {
            "type": "number"
          },
          "title": "Std Translation M",
          "type": "array"
        }
      },
      "title": "TransformQuality",
      "type": "object"
