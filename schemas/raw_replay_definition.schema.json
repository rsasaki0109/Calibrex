{
  "$defs": {
    "ReplayAutowareRequest": {
      "additionalProperties": false,
      "description": "Read-only package plan request; apply is deliberately not represented.",
      "properties": {
        "baseline_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Manifest Sha256"
        },
        "candidate_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Path"
        },
        "output_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Path"
        },
        "package_root": {
          "minLength": 1,
          "title": "Package Root",
          "type": "string"
        },
        "sensor_kit_id": {
          "minLength": 1,
          "title": "Sensor Kit Id",
          "type": "string"
        },
        "vehicle_id": {
          "minLength": 1,
          "title": "Vehicle Id",
          "type": "string"
        },
        "workspace_root": {
          "minLength": 1,
          "title": "Workspace Root",
          "type": "string"
        }
      },
      "required": [
        "workspace_root",
        "package_root",
        "vehicle_id",
        "sensor_kit_id"
      ],
      "title": "ReplayAutowareRequest",
      "type": "object"
    },
    "ReplayBudgets": {
      "additionalProperties": false,
      "description": "Metric and transform acceptance budgets frozen before execution.",
      "properties": {
        "holdout_field": {
          "default": "value",
          "enum": [
            "value",
            "holdout",
            "train"
          ],
          "title": "Holdout Field",
          "type": "string"
        },
        "holdout_metric": {
          "default": "holdout_rmse",
          "title": "Holdout Metric",
          "type": "string"
        },
        "known_bad_field": {
          "default": "value",
          "enum": [
            "value",
            "holdout",
            "train"
          ],
          "title": "Known Bad Field",
          "type": "string"
        },
        "known_bad_metric": {
          "default": "holdout_rmse",
          "title": "Known Bad Metric",
          "type": "string"
        },
        "max_holdout_value": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Holdout Value"
        },
        "max_transform_rotation_delta_deg": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Transform Rotation Delta Deg"
        },
        "max_transform_translation_delta_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Transform Translation Delta M"
        },
        "min_known_bad_delta": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Known Bad Delta"
        },
        "min_observability_rank": {
          "default": 1,
          "maximum": 6,
          "minimum": 0,
          "title": "Min Observability Rank",
          "type": "integer"
        },
        "require_candidate_quality_pass": {
          "default": true,
          "title": "Require Candidate Quality Pass",
          "type": "boolean"
        }
      },
      "title": "ReplayBudgets",
      "type": "object"
    },
    "ReplayEnvironment": {
      "additionalProperties": false,
      "description": "Execution environment identity; no ambient state is trusted silently.",
      "properties": {
        "calibrex_version": {
          "default": "0.4.1",
          "title": "Calibrex Version",
          "type": "string"
        },
        "container_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Digest"
        },
        "container_image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Image"
        },
        "environment_id": {
          "default": "local",
          "minLength": 1,
          "title": "Environment Id",
          "type": "string"
        },
        "environment_inputs": {
          "items": {
            "type": "string"
          },
          "title": "Environment Inputs",
          "type": "array"
        },
        "environment_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Environment Sha256",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "network": {
          "default": "none",
          "enum": [
            "none",
            "host"
          ],
          "title": "Network",
          "type": "string"
        },
        "platform": {
          "title": "Platform",
          "type": "string"
        },
        "python_version": {
          "title": "Python Version",
          "type": "string"
        }
      },
      "required": [
        "environment_sha256"
      ],
      "title": "ReplayEnvironment",
      "type": "object"
    },
    "ReplayInput": {
      "additionalProperties": false,
      "description": "One immutable file bound to a replay definition.",
      "properties": {
        "input_id": {
          "minLength": 1,
          "title": "Input Id",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "role": {
          "enum": [
            "capture_manifest",
            "source",
            "config",
            "baseline",
            "candidate",
            "holdout",
            "known_bad",
            "environment",
            "tool",
            "container",
            "promotion",
            "smoke"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Version"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "input_id",
        "role",
        "path",
        "sha256"
      ],
      "title": "ReplayInput",
      "type": "object"
    },
    "ReplayProtocol": {
      "additionalProperties": false,
      "description": "Frozen split, seed, provider, and stage protocol.",
      "properties": {
        "allow_autoware_plan": {
          "default": false,
          "title": "Allow Autoware Plan",
          "type": "boolean"
        },
        "deterministic_seed": {
          "default": 0,
          "title": "Deterministic Seed",
          "type": "integer"
        },
        "execution_mode": {
          "default": "precomputed",
          "enum": [
            "in_process",
            "argv",
            "precomputed"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "holdout_ratio": {
          "default": 0.2,
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Holdout Ratio",
          "type": "number"
        },
        "mutate_autoware": {
          "default": false,
          "title": "Mutate Autoware",
          "type": "boolean"
        },
        "protocol_id": {
          "minLength": 1,
          "title": "Protocol Id",
          "type": "string"
        },
        "protocol_version": {
          "default": "v0.1",
          "title": "Protocol Version",
          "type": "string"
        },
        "provider": {
          "default": "calibrex.native",
          "title": "Provider",
          "type": "string"
        },
        "require_independent_holdout": {
          "default": true,
          "title": "Require Independent Holdout",
          "type": "boolean"
        },
        "require_known_bad": {
          "default": true,
          "title": "Require Known Bad",
          "type": "boolean"
        },
        "require_observability": {
          "default": true,
          "title": "Require Observability",
          "type": "boolean"
        },
        "split_seed": {
          "default": 0,
          "title": "Split Seed",
          "type": "integer"
        },
        "stage_timeout_seconds": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Stage Timeout Seconds",
          "type": "object"
        },
        "stages": {
          "items": {
            "enum": [
              "verify_inputs",
              "readiness",
              "execute_calibration",
              "validate_result",
              "evaluate",
              "compare",
              "lifecycle",
              "autoware_plan",
              "rollback_simulation"
            ],
            "type": "string"
          },
          "title": "Stages",
          "type": "array"
        }
      },
      "required": [
        "protocol_id"
      ],
      "title": "ReplayProtocol",
      "type": "object"
    },
    "ReplayProvenance": {
      "additionalProperties": false,
      "description": "Complete provenance shared by every generated replay artifact.",
      "properties": {
        "artifact_digest_scope": {
          "default": "canonical artifact excluding artifact_sha256 and provenance.artifact_sha256/generated_at",
          "title": "Artifact Digest Scope",
          "type": "string"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "baseline_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Sha256"
        },
        "candidate_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Sha256"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "config_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Sha256"
        },
        "container_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Digest"
        },
        "environment_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Environment Sha256",
          "type": "string"
        },
        "evidence_sha256": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Evidence Sha256",
          "type": "object"
        },
        "generated_at": {
          "title": "Generated At",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Git Commit"
        },
        "holdout_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holdout Sha256"
        },
        "known_bad_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Bad Sha256"
        },
        "producer": {
          "const": "calibrex",
          "default": "calibrex",
          "title": "Producer",
          "type": "string"
        },
        "source_sha256": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Source Sha256",
          "type": "object"
        },
        "tool_name": {
          "default": "calibrex.raw-replay",
          "title": "Tool Name",
          "type": "string"
        },
        "tool_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tool Sha256",
          "type": "string"
        },
        "tool_version": {
          "default": "0.4.1",
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "environment_sha256",
        "tool_sha256"
      ],
      "title": "ReplayProvenance",
      "type": "object"
    },
    "ReplayRegistryRequest": {
      "additionalProperties": false,
      "description": "Optional field-pilot lifecycle scope.",
      "properties": {
        "child_frame": {
          "minLength": 1,
          "title": "Child Frame",
          "type": "string"
        },
        "edge_id": {
          "minLength": 1,
          "title": "Edge Id",
          "type": "string"
        },
        "firmware": {
          "minLength": 1,
          "title": "Firmware",
          "type": "string"
        },
        "frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "mount": {
          "minLength": 1,
          "title": "Mount",
          "type": "string"
        },
        "operator": {
          "default": "ci",
          "title": "Operator",
          "type": "string"
        },
        "parent_frame": {
          "minLength": 1,
          "title": "Parent Frame",
          "type": "string"
        },
        "registry_root": {
          "minLength": 1,
          "title": "Registry Root",
          "type": "string"
        },
        "replacement_mount": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replacement Mount"
        },
        "replacement_sensor_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replacement Sensor Id"
        },
        "replacement_serial": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replacement Serial"
        },
        "sensor_id": {
          "minLength": 1,
          "title": "Sensor Id",
          "type": "string"
        },
        "sensor_kit_id": {
          "minLength": 1,
          "title": "Sensor Kit Id",
          "type": "string"
        },
        "serial": {
          "minLength": 1,
          "title": "Serial",
          "type": "string"
        },
        "simulate_rollback": {
          "default": true,
          "title": "Simulate Rollback",
          "type": "boolean"
        },
        "vehicle_id": {
          "minLength": 1,
          "title": "Vehicle Id",
          "type": "string"
        }
      },
      "required": [
        "registry_root",
        "vehicle_id",
        "sensor_kit_id",
        "edge_id",
        "parent_frame",
        "child_frame",
        "sensor_id",
        "serial",
        "model",
        "firmware",
        "mount"
      ],
      "title": "ReplayRegistryRequest",
      "type": "object"
    },
    "ReplayTool": {
      "additionalProperties": false,
      "description": "Provider/adapter identity, including the immutable tool digest.",
      "properties": {
        "adapter_version": {
          "minLength": 1,
          "title": "Adapter Version",
          "type": "string"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "executable_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executable Path"
        },
        "executable_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executable Sha256"
        },
        "license_spdx": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Spdx"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Commit"
        },
        "tool_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tool Sha256",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "adapter_version",
        "tool_sha256"
      ],
      "title": "ReplayTool",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema-valid, digest-bound declaration for one replay.",
  "properties": {
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Sha256",
      "type": "string"
    },
    "autoware": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReplayAutowareRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "baseline": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReplayInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "budgets": {
      "$ref": "#/$defs/ReplayBudgets"
    },
    "candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReplayInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "capture_manifest": {
      "$ref": "#/$defs/ReplayInput"
    },
    "config": {
      "$ref": "#/$defs/ReplayInput"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "environment": {
      "$ref": "#/$defs/ReplayEnvironment"
    },
    "holdout": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReplayInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/ReplayInput"
      },
      "title": "Inputs",
      "type": "array"
    },
    "known_bad": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReplayInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "protocol": {
      "$ref": "#/$defs/ReplayProtocol"
    },
    "provenance": {
      "$ref": "#/$defs/ReplayProvenance"
    },
    "registry": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReplayRegistryRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "replay_id": {
      "minLength": 1,
      "title": "Replay Id",
      "type": "string"
    },
    "schema_version": {
      "const": "slac.raw_replay_definition/v0.1",
      "default": "slac.raw_replay_definition/v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "tool": {
      "$ref": "#/$defs/ReplayTool"
    }
  },
  "required": [
    "replay_id",
    "capture_manifest",
    "config",
    "protocol",
    "tool",
    "environment",
    "provenance",
    "artifact_sha256"
  ],
  "title": "ReplayDefinition",
  "type": "object"
}
