{
  "$defs": {
    "ContinuousTimeArtifactProvenance": {
      "additionalProperties": false,
      "description": "Generator and immutable input lineage.",
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "generator": {
          "title": "Generator",
          "type": "string"
        },
        "generator_version": {
          "title": "Generator Version",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "generator",
        "generator_version",
        "source_sha256"
      ],
      "title": "ContinuousTimeArtifactProvenance",
      "type": "object"
    },
    "ContinuousTimeEvaluationArtifact": {
      "additionalProperties": false,
      "description": "Schema-valid uncertainty-normalized evaluation.",
      "properties": {
        "mean_mahalanobis_error": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Mahalanobis Error"
        },
        "objective": {
          "title": "Objective",
          "type": "number"
        },
        "skipped_correspondence_count": {
          "minimum": 0,
          "title": "Skipped Correspondence Count",
          "type": "integer"
        },
        "valid_correspondence_count": {
          "minimum": 0,
          "title": "Valid Correspondence Count",
          "type": "integer"
        },
        "weighted_reprojection_rmse_px": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weighted Reprojection Rmse Px"
        }
      },
      "required": [
        "objective",
        "valid_correspondence_count",
        "skipped_correspondence_count"
      ],
      "title": "ContinuousTimeEvaluationArtifact",
      "type": "object"
    },
    "ContinuousTimeIterationArtifact": {
      "additionalProperties": false,
      "description": "One retained optimizer candidate.",
      "properties": {
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "delta_rotation_deg_xyz": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Delta Rotation Deg Xyz",
          "type": "array"
        },
        "delta_translation_m_xyz": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Delta Translation M Xyz",
          "type": "array"
        },
        "evaluation": {
          "exclusiveMinimum": 0,
          "title": "Evaluation",
          "type": "integer"
        },
        "objective": {
          "title": "Objective",
          "type": "number"
        },
        "time_offset_sec": {
          "title": "Time Offset Sec",
          "type": "number"
        }
      },
      "required": [
        "evaluation",
        "delta_rotation_deg_xyz",
        "delta_translation_m_xyz",
        "time_offset_sec",
        "objective",
        "accepted"
      ],
      "title": "ContinuousTimeIterationArtifact",
      "type": "object"
    },
    "CovarianceInfo": {
      "additionalProperties": false,
      "properties": {
        "matrix": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Matrix",
          "type": "array"
        },
        "order": {
          "items": {
            "type": "string"
          },
          "title": "Order",
          "type": "array"
        }
      },
      "required": [
        "order",
        "matrix"
      ],
      "title": "CovarianceInfo",
      "type": "object"
    },
    "TransformEstimateProvenance": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Version"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "evidence_level": {
          "default": "unknown",
          "enum": [
            "synthetic_truth",
            "independently_measured",
            "dataset_provided",
            "factory_provided",
            "algorithmically_refined",
            "imported_without_documented_derivation",
            "unknown"
          ],
          "title": "Evidence Level",
          "type": "string"
        },
        "execution_mode": {
          "default": "unknown",
          "enum": [
            "offline_batch",
            "sliding_window",
            "online_stream",
            "manual",
            "imported",
            "dataset_reference",
            "unknown"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "license_spdx": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Spdx"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "producer": {
          "default": "unknown",
          "enum": [
            "slac_native",
            "external_tool",
            "human",
            "dataset_provider",
            "factory",
            "unknown"
          ],
          "title": "Producer",
          "type": "string"
        },
        "role_in_comparison": {
          "anyOf": [
            {
              "enum": [
                "initial",
                "candidate",
                "selected_reference",
                "output",
                "comparison_baseline"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role In Comparison"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "source_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Commit"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Path"
        },
        "tool_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Name"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        }
      },
      "title": "TransformEstimateProvenance",
      "type": "object"
    },
    "TransformQuality": {
      "additionalProperties": false,
      "properties": {
        "grade": {
          "default": "warn",
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "title": "Grade",
          "type": "string"
        },
        "std_rotation_deg": {
          "items": {
            "type": "number"
          },
          "title": "Std Rotation Deg",
          "type": "array"
        },
        "std_translation_m": {
          "items": {
            "type": "number"
          },
          "title": "Std Translation M",
          "type": "array"
        }
      },
      "title": "TransformQuality",
      "type": "object"
    },
    "TransformResult": {
      "additionalProperties": false,
      "properties": {
        "child": {
          "title": "Child",
          "type": "string"
        },
        "convention": {
          "const": "T_parent_child",
          "default": "T_parent_child",
          "title": "Convention",
          "type": "string"
        },
        "covariance": {
          "anyOf": [
            {
              "$ref": "#/$defs/CovarianceInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "estimate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimate Id"
        },
        "parent": {
          "title": "Parent",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/TransformEstimateProvenance"
        },
        "quality": {
          "$ref": "#/$defs/TransformQuality"
        },
        "rotation_quat_xyzw": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Rotation Quat Xyzw",
          "type": "array"
        },
        "translation_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Translation M",
          "type": "array"
        }
      },
      "required": [
        "parent",
        "child",
        "translation_m",
        "rotation_quat_xyzw"
      ],
      "title": "TransformResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema-valid joint extrinsic/time result and disjoint evidence.",
  "properties": {
    "clock_convention": {
      "const": "lidar_sensor_time + dt_lidar = camera_reference_time",
      "default": "lidar_sensor_time + dt_lidar = camera_reference_time",
      "title": "Clock Convention",
      "type": "string"
    },
    "estimated_time_offset_sec": {
      "title": "Estimated Time Offset Sec",
      "type": "number"
    },
    "final_holdout_evaluation": {
      "$ref": "#/$defs/ContinuousTimeEvaluationArtifact"
    },
    "final_rotation_error_deg": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Rotation Error Deg"
    },
    "final_time_offset_error_sec": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Time Offset Error Sec"
    },
    "final_train_evaluation": {
      "$ref": "#/$defs/ContinuousTimeEvaluationArtifact"
    },
    "final_translation_error_m": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Translation Error M"
    },
    "holdout_capture_ids": {
      "items": {
        "type": "string"
      },
      "title": "Holdout Capture Ids",
      "type": "array"
    },
    "initial_holdout_evaluation": {
      "$ref": "#/$defs/ContinuousTimeEvaluationArtifact"
    },
    "initial_rotation_error_deg": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initial Rotation Error Deg"
    },
    "initial_time_offset_error_sec": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initial Time Offset Error Sec"
    },
    "initial_time_offset_sec": {
      "title": "Initial Time Offset Sec",
      "type": "number"
    },
    "initial_train_evaluation": {
      "$ref": "#/$defs/ContinuousTimeEvaluationArtifact"
    },
    "initial_transform_camera_lidar": {
      "$ref": "#/$defs/TransformResult"
    },
    "initial_translation_error_m": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initial Translation Error M"
    },
    "method": {
      "const": "continuous_time_probabilistic_camera_lidar/v0.1",
      "default": "continuous_time_probabilistic_camera_lidar/v0.1",
      "title": "Method",
      "type": "string"
    },
    "options": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "title": "Options",
      "type": "object"
    },
    "provenance": {
      "$ref": "#/$defs/ContinuousTimeArtifactProvenance"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "reference_time_offset_sec": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Time Offset Sec"
    },
    "reference_transform_camera_lidar": {
      "anyOf": [
        {
          "$ref": "#/$defs/TransformResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "result_id": {
      "title": "Result Id",
      "type": "string"
    },
    "schema_version": {
      "const": "slac.continuous_time_camera_lidar_result/v0.1",
      "default": "slac.continuous_time_camera_lidar_result/v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "converged",
        "max_evaluations",
        "insufficient_correspondences",
        "missing_holdout",
        "degenerate_motion",
        "at_bound"
      ],
      "title": "Status",
      "type": "string"
    },
    "time_observability_rank": {
      "maximum": 1,
      "minimum": 0,
      "title": "Time Observability Rank",
      "type": "integer"
    },
    "time_sensitivity_px_per_sec": {
      "minimum": 0.0,
      "title": "Time Sensitivity Px Per Sec",
      "type": "number"
    },
    "trace": {
      "items": {
        "$ref": "#/$defs/ContinuousTimeIterationArtifact"
      },
      "title": "Trace",
      "type": "array"
    },
    "train_capture_ids": {
      "items": {
        "type": "string"
      },
      "title": "Train Capture Ids",
      "type": "array"
    },
    "trajectory_model": {
      "default": "constant_body_twist",
      "enum": [
        "constant_body_twist",
        "piecewise_se3"
      ],
      "title": "Trajectory Model",
      "type": "string"
    },
    "transform_camera_lidar": {
      "$ref": "#/$defs/TransformResult"
    }
  },
  "required": [
    "result_id",
    "status",
    "reason",
    "initial_transform_camera_lidar",
    "transform_camera_lidar",
    "initial_time_offset_sec",
    "estimated_time_offset_sec",
    "train_capture_ids",
    "holdout_capture_ids",
    "initial_train_evaluation",
    "final_train_evaluation",
    "initial_holdout_evaluation",
    "final_holdout_evaluation",
    "time_sensitivity_px_per_sec",
    "time_observability_rank",
    "trace",
    "options",
    "provenance"
  ],
  "title": "ContinuousTimeCameraLidarResultArtifact",
  "type": "object"
}
