{
  "$defs": {
    "Kitti360IntegrationFileReference": {
      "additionalProperties": false,
      "description": "Content-addressed regular file consumed by the integration.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Kitti360IntegrationFileReference",
      "type": "object"
    },
    "Kitti360LidarIntegratedWindow": {
      "additionalProperties": false,
      "description": "Input coverage, point accounting, and output for one center frame.",
      "properties": {
        "center_frame_id": {
          "pattern": "^[0-9]{10}$",
          "title": "Center Frame Id",
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/Kitti360LidarScanReference"
        },
        "range_discarded_point_count": {
          "minimum": 0,
          "title": "Range Discarded Point Count",
          "type": "integer"
        },
        "range_retained_point_count": {
          "exclusiveMinimum": 0,
          "title": "Range Retained Point Count",
          "type": "integer"
        },
        "source_frame_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Frame Ids",
          "type": "array"
        },
        "source_point_count": {
          "exclusiveMinimum": 0,
          "title": "Source Point Count",
          "type": "integer"
        },
        "voxel_discarded_point_count": {
          "minimum": 0,
          "title": "Voxel Discarded Point Count",
          "type": "integer"
        }
      },
      "required": [
        "center_frame_id",
        "source_frame_ids",
        "source_point_count",
        "range_discarded_point_count",
        "range_retained_point_count",
        "voxel_discarded_point_count",
        "output"
      ],
      "title": "Kitti360LidarIntegratedWindow",
      "type": "object"
    },
    "Kitti360LidarScanReference": {
      "additionalProperties": false,
      "description": "One float32 XYZI scan bound to a numeric KITTI-360 frame.",
      "properties": {
        "encoding": {
          "const": "little_endian_float32_xyzi",
          "default": "little_endian_float32_xyzi",
          "title": "Encoding",
          "type": "string"
        },
        "frame_id": {
          "pattern": "^[0-9]{10}$",
          "title": "Frame Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "point_count": {
          "exclusiveMinimum": 0,
          "title": "Point Count",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "frame_id",
        "point_count"
      ],
      "title": "Kitti360LidarScanReference",
      "type": "object"
    },
    "Kitti360LidarWindowIntegrationParameters": {
      "additionalProperties": false,
      "description": "Frozen geometric and filtering policy for window integration.",
      "properties": {
        "maximum_pose_extrapolation_frames": {
          "default": 0,
          "minimum": 0,
          "title": "Maximum Pose Extrapolation Frames",
          "type": "integer"
        },
        "minimum_range_m": {
          "minimum": 0.0,
          "title": "Minimum Range M",
          "type": "number"
        },
        "motion_compensation": {
          "const": "kitti360_azimuth_weighted_pose_delta/v0.1",
          "default": "kitti360_azimuth_weighted_pose_delta/v0.1",
          "title": "Motion Compensation",
          "type": "string"
        },
        "neighbor_radius_frames": {
          "minimum": 0,
          "title": "Neighbor Radius Frames",
          "type": "integer"
        },
        "output_coordinate_frame": {
          "const": "center_velodyne",
          "default": "center_velodyne",
          "title": "Output Coordinate Frame",
          "type": "string"
        },
        "output_encoding": {
          "const": "little_endian_float32_xyzi",
          "default": "little_endian_float32_xyzi",
          "title": "Output Encoding",
          "type": "string"
        },
        "pose_resolution": {
          "default": "official_bracketed_or_bounded_endpoint_translation_lerp_quaternion_slerp/v0.2",
          "enum": [
            "official_or_bracketed_translation_lerp_quaternion_slerp/v0.1",
            "official_bracketed_or_bounded_endpoint_translation_lerp_quaternion_slerp/v0.2"
          ],
          "title": "Pose Resolution",
          "type": "string"
        },
        "range_filter_frame": {
          "const": "source_velodyne_after_motion_compensation",
          "default": "source_velodyne_after_motion_compensation",
          "title": "Range Filter Frame",
          "type": "string"
        },
        "transform_convention": {
          "const": "T_center_velodyne_source_velodyne=inverse(T_world_pose_center*T_pose_velodyne)*(T_world_pose_source*T_pose_velodyne)/v0.1",
          "default": "T_center_velodyne_source_velodyne=inverse(T_world_pose_center*T_pose_velodyne)*(T_world_pose_source*T_pose_velodyne)/v0.1",
          "title": "Transform Convention",
          "type": "string"
        },
        "voxel_reducer": {
          "enum": [
            "none",
            "sorted_voxel_centroid_xyz_mean_intensity/v0.1"
          ],
          "title": "Voxel Reducer",
          "type": "string"
        },
        "voxel_resolution_m": {
          "minimum": 0.0,
          "title": "Voxel Resolution M",
          "type": "number"
        }
      },
      "required": [
        "neighbor_radius_frames",
        "minimum_range_m",
        "voxel_resolution_m",
        "voxel_reducer"
      ],
      "title": "Kitti360LidarWindowIntegrationParameters",
      "type": "object"
    },
    "Kitti360LidarWindowIntegrationProvenance": {
      "additionalProperties": false,
      "description": "Generator identity and immutable input digests.",
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "generator": {
          "title": "Generator",
          "type": "string"
        },
        "generator_version": {
          "title": "Generator Version",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "source_sha256": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 4,
          "title": "Source Sha256",
          "type": "object"
        }
      },
      "required": [
        "generator",
        "generator_version",
        "source_sha256"
      ],
      "title": "Kitti360LidarWindowIntegrationProvenance",
      "type": "object"
    },
    "Kitti360ResolvedPose": {
      "additionalProperties": false,
      "description": "Direct, interpolated, or bounded-extrapolated pose for one frame.",
      "properties": {
        "frame_id": {
          "pattern": "^[0-9]{10}$",
          "title": "Frame Id",
          "type": "string"
        },
        "interpolation_alpha": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interpolation Alpha"
        },
        "left_official_frame_id": {
          "anyOf": [
            {
              "pattern": "^[0-9]{10}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Left Official Frame Id"
        },
        "method": {
          "enum": [
            "official",
            "bracketed_se3_interpolation",
            "bounded_endpoint_se3_extrapolation"
          ],
          "title": "Method",
          "type": "string"
        },
        "right_official_frame_id": {
          "anyOf": [
            {
              "pattern": "^[0-9]{10}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Right Official Frame Id"
        },
        "rotation_quat_xyzw": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Rotation Quat Xyzw",
          "type": "array"
        },
        "translation_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Translation M",
          "type": "array"
        }
      },
      "required": [
        "frame_id",
        "method",
        "translation_m",
        "rotation_quat_xyzw"
      ],
      "title": "Kitti360ResolvedPose",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema-valid lineage for center-frame KITTI-360 LiDAR maps.",
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "calibration_files": {
      "items": {
        "$ref": "#/$defs/Kitti360IntegrationFileReference"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Calibration Files",
      "type": "array"
    },
    "center_frame_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Center Frame Ids",
      "type": "array"
    },
    "dataset_family": {
      "const": "KITTI-360",
      "default": "KITTI-360",
      "title": "Dataset Family",
      "type": "string"
    },
    "dataset_id": {
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_license_spdx": {
      "minLength": 1,
      "title": "Dataset License Spdx",
      "type": "string"
    },
    "output_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Output Set Sha256",
      "type": "string"
    },
    "parameters": {
      "$ref": "#/$defs/Kitti360LidarWindowIntegrationParameters"
    },
    "poses_file": {
      "$ref": "#/$defs/Kitti360IntegrationFileReference"
    },
    "provenance": {
      "$ref": "#/$defs/Kitti360LidarWindowIntegrationProvenance"
    },
    "resolved_poses": {
      "items": {
        "$ref": "#/$defs/Kitti360ResolvedPose"
      },
      "minItems": 1,
      "title": "Resolved Poses",
      "type": "array"
    },
    "schema_version": {
      "default": "slac.kitti360_lidar_window_integration/v0.2",
      "enum": [
        "slac.kitti360_lidar_window_integration/v0.1",
        "slac.kitti360_lidar_window_integration/v0.2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "selection_manifest": {
      "$ref": "#/$defs/Kitti360IntegrationFileReference"
    },
    "sequence_id": {
      "minLength": 1,
      "title": "Sequence Id",
      "type": "string"
    },
    "source_scans": {
      "items": {
        "$ref": "#/$defs/Kitti360LidarScanReference"
      },
      "minItems": 1,
      "title": "Source Scans",
      "type": "array"
    },
    "windows": {
      "items": {
        "$ref": "#/$defs/Kitti360LidarIntegratedWindow"
      },
      "minItems": 1,
      "title": "Windows",
      "type": "array"
    }
  },
  "required": [
    "artifact_id",
    "dataset_id",
    "sequence_id",
    "dataset_license_spdx",
    "selection_manifest",
    "poses_file",
    "calibration_files",
    "center_frame_ids",
    "parameters",
    "source_scans",
    "resolved_poses",
    "windows",
    "output_set_sha256",
    "provenance"
  ],
  "title": "Kitti360LidarWindowIntegrationArtifact",
  "type": "object"
}
