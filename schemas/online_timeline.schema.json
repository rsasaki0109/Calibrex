{
  "$defs": {
    "CovarianceInfo": {
      "additionalProperties": false,
      "properties": {
        "matrix": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Matrix",
          "type": "array"
        },
        "order": {
          "items": {
            "type": "string"
          },
          "title": "Order",
          "type": "array"
        }
      },
      "required": [
        "order",
        "matrix"
      ],
      "title": "CovarianceInfo",
      "type": "object"
    },
    "MetricResult": {
      "additionalProperties": false,
      "properties": {
        "grade": {
          "default": "warn",
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "title": "Grade",
          "type": "string"
        },
        "holdout": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holdout"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "train": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "title": "MetricResult",
      "type": "object"
    },
    "ObservabilityResult": {
      "additionalProperties": false,
      "properties": {
        "condition_number": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition Number"
        },
        "grade": {
          "default": "warn",
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "title": "Grade",
          "type": "string"
        },
        "rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "weak_directions": {
          "items": {
            "type": "string"
          },
          "title": "Weak Directions",
          "type": "array"
        }
      },
      "title": "ObservabilityResult",
      "type": "object"
    },
    "OnlineBatchSnapshot": {
      "additionalProperties": false,
      "description": "Per-batch evidence snapshot for one online calibration session.",
      "properties": {
        "batch_holdout_rmse_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch Holdout Rmse M"
        },
        "batch_index": {
          "minimum": 0,
          "title": "Batch Index",
          "type": "integer"
        },
        "batch_observability": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservabilityResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "correspondence_count": {
          "minimum": 0,
          "title": "Correspondence Count",
          "type": "integer"
        },
        "estimate": {
          "$ref": "#/$defs/TransformResult"
        },
        "estimate_accepted": {
          "title": "Estimate Accepted",
          "type": "boolean"
        },
        "frame_count": {
          "minimum": 0,
          "title": "Frame Count",
          "type": "integer"
        },
        "gate_reason": {
          "title": "Gate Reason",
          "type": "string"
        },
        "gate_status": {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ],
          "title": "Gate Status",
          "type": "string"
        },
        "holdout_correspondence_count": {
          "minimum": 0,
          "title": "Holdout Correspondence Count",
          "type": "integer"
        },
        "holdout_point_count": {
          "minimum": 0,
          "title": "Holdout Point Count",
          "type": "integer"
        },
        "metrics": {
          "additionalProperties": {
            "$ref": "#/$defs/MetricResult"
          },
          "title": "Metrics",
          "type": "object"
        },
        "observability": {
          "$ref": "#/$defs/ObservabilityResult"
        },
        "point_count": {
          "minimum": 0,
          "title": "Point Count",
          "type": "integer"
        },
        "provenance": {
          "additionalProperties": true,
          "title": "Provenance",
          "type": "object"
        },
        "rolling_rmse_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rolling Rmse M"
        },
        "rolling_window_residual_count": {
          "default": 0,
          "minimum": 0,
          "title": "Rolling Window Residual Count",
          "type": "integer"
        },
        "train_point_count": {
          "minimum": 0,
          "title": "Train Point Count",
          "type": "integer"
        }
      },
      "required": [
        "batch_index",
        "frame_count",
        "point_count",
        "train_point_count",
        "holdout_point_count",
        "correspondence_count",
        "holdout_correspondence_count",
        "estimate",
        "estimate_accepted",
        "gate_status",
        "gate_reason"
      ],
      "title": "OnlineBatchSnapshot",
      "type": "object"
    },
    "ReportRunInfo": {
      "additionalProperties": false,
      "description": "Minimal run metadata repeated in report sidecars.",
      "properties": {
        "calibrex_version": {
          "title": "Calibrex Version",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "dataset_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Path"
        },
        "dataset_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Type"
        },
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "success",
            "warning",
            "failed",
            "dry_run"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "status",
        "domain",
        "calibrex_version",
        "created_at"
      ],
      "title": "ReportRunInfo",
      "type": "object"
    },
    "TransformEstimateProvenance": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Version"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "evidence_level": {
          "default": "unknown",
          "enum": [
            "synthetic_truth",
            "independently_measured",
            "dataset_provided",
            "factory_provided",
            "algorithmically_refined",
            "imported_without_documented_derivation",
            "unknown"
          ],
          "title": "Evidence Level",
          "type": "string"
        },
        "execution_mode": {
          "default": "unknown",
          "enum": [
            "offline_batch",
            "sliding_window",
            "online_stream",
            "manual",
            "imported",
            "dataset_reference",
            "unknown"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "license_spdx": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Spdx"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "producer": {
          "default": "unknown",
          "enum": [
            "calibrex_native",
            "external_tool",
            "human",
            "dataset_provider",
            "factory",
            "unknown"
          ],
          "title": "Producer",
          "type": "string"
        },
        "role_in_comparison": {
          "anyOf": [
            {
              "enum": [
                "initial",
                "candidate",
                "selected_reference",
                "output",
                "comparison_baseline"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role In Comparison"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "source_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Commit"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Path"
        },
        "tool_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Name"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        }
      },
      "title": "TransformEstimateProvenance",
      "type": "object"
    },
    "TransformQuality": {
      "additionalProperties": false,
      "properties": {
        "grade": {
          "default": "warn",
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "title": "Grade",
          "type": "string"
        },
        "std_rotation_deg": {
          "items": {
            "type": "number"
          },
          "title": "Std Rotation Deg",
          "type": "array"
        },
        "std_translation_m": {
          "items": {
            "type": "number"
          },
          "title": "Std Translation M",
          "type": "array"
        }
      },
      "title": "TransformQuality",
      "type": "object"
    },
    "TransformResult": {
      "additionalProperties": false,
      "properties": {
        "child": {
          "title": "Child",
          "type": "string"
        },
        "convention": {
          "const": "T_parent_child",
          "default": "T_parent_child",
          "title": "Convention",
          "type": "string"
        },
        "covariance": {
          "anyOf": [
            {
              "$ref": "#/$defs/CovarianceInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "estimate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimate Id"
        },
        "parent": {
          "title": "Parent",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/TransformEstimateProvenance"
        },
        "quality": {
          "$ref": "#/$defs/TransformQuality"
        },
        "rotation_quat_xyzw": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Rotation Quat Xyzw",
          "type": "array"
        },
        "translation_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Translation M",
          "type": "array"
        }
      },
      "required": [
        "parent",
        "child",
        "translation_m",
        "rotation_quat_xyzw"
      ],
      "title": "TransformResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Machine-readable per-batch timeline for one online calibration run.",
  "properties": {
    "accepted_batch_count": {
      "default": 0,
      "minimum": 0,
      "title": "Accepted Batch Count",
      "type": "integer"
    },
    "accumulation_batches": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accumulation Batches"
    },
    "batch_size": {
      "minimum": 1,
      "title": "Batch Size",
      "type": "integer"
    },
    "batches": {
      "items": {
        "$ref": "#/$defs/OnlineBatchSnapshot"
      },
      "title": "Batches",
      "type": "array"
    },
    "final_gate_status": {
      "enum": [
        "pass",
        "fail",
        "inconclusive"
      ],
      "title": "Final Gate Status",
      "type": "string"
    },
    "holdout_ratio": {
      "maximum": 0.9,
      "minimum": 0.0,
      "title": "Holdout Ratio",
      "type": "number"
    },
    "inconclusive_batch_count": {
      "default": 0,
      "minimum": 0,
      "title": "Inconclusive Batch Count",
      "type": "integer"
    },
    "max_accumulated_train_points": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Accumulated Train Points"
    },
    "rejected_batch_count": {
      "default": 0,
      "minimum": 0,
      "title": "Rejected Batch Count",
      "type": "integer"
    },
    "rolling_window": {
      "minimum": 1,
      "title": "Rolling Window",
      "type": "integer"
    },
    "run": {
      "$ref": "#/$defs/ReportRunInfo"
    },
    "schema_version": {
      "const": "calibrex.online_timeline/v0.2",
      "default": "calibrex.online_timeline/v0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "source_sensor": {
      "title": "Source Sensor",
      "type": "string"
    },
    "target_sensor": {
      "title": "Target Sensor",
      "type": "string"
    },
    "variable": {
      "title": "Variable",
      "type": "string"
    }
  },
  "required": [
    "run",
    "variable",
    "source_sensor",
    "target_sensor",
    "batch_size",
    "rolling_window",
    "holdout_ratio",
    "seed",
    "final_gate_status"
  ],
  "title": "OnlineCalibrationTimelineArtifact",
  "type": "object"
}
