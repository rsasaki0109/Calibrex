{
  "$defs": {
    "CameraLidarCorrespondenceFrameQuality": {
      "additionalProperties": false,
      "description": "Pose-dependent quality evidence for one capture frame.",
      "properties": {
        "accepted_camera_depth_m": {
          "$ref": "#/$defs/CameraLidarDistributionSummary"
        },
        "accepted_confidence": {
          "$ref": "#/$defs/CameraLidarDistributionSummary"
        },
        "capture_time_ns": {
          "title": "Capture Time Ns",
          "type": "integer"
        },
        "confidence": {
          "$ref": "#/$defs/CameraLidarDistributionSummary"
        },
        "frame_id": {
          "title": "Frame Id",
          "type": "string"
        },
        "gate_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Gate Reasons",
          "type": "array"
        },
        "gates": {
          "$ref": "#/$defs/CameraLidarCorrespondenceGateCounts"
        },
        "grade": {
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "title": "Grade",
          "type": "string"
        },
        "image_coverage": {
          "$ref": "#/$defs/CameraLidarImageCoverage"
        },
        "lidar_range_m": {
          "$ref": "#/$defs/CameraLidarDistributionSummary"
        },
        "observability": {
          "$ref": "#/$defs/CameraLidarPoseObservability"
        },
        "partition": {
          "enum": [
            "train",
            "holdout"
          ],
          "title": "Partition",
          "type": "string"
        },
        "reprojection_error_px": {
          "$ref": "#/$defs/CameraLidarDistributionSummary"
        }
      },
      "required": [
        "frame_id",
        "capture_time_ns",
        "partition",
        "gates",
        "confidence",
        "accepted_confidence",
        "lidar_range_m",
        "accepted_camera_depth_m",
        "reprojection_error_px",
        "image_coverage",
        "observability",
        "grade"
      ],
      "title": "CameraLidarCorrespondenceFrameQuality",
      "type": "object"
    },
    "CameraLidarCorrespondenceGateCounts": {
      "additionalProperties": false,
      "description": "Mutually exclusive correspondence outcomes at one tested pose.",
      "properties": {
        "accepted_count": {
          "minimum": 0,
          "title": "Accepted Count",
          "type": "integer"
        },
        "behind_camera_count": {
          "minimum": 0,
          "title": "Behind Camera Count",
          "type": "integer"
        },
        "below_confidence_count": {
          "minimum": 0,
          "title": "Below Confidence Count",
          "type": "integer"
        },
        "invalid_projection_count": {
          "minimum": 0,
          "title": "Invalid Projection Count",
          "type": "integer"
        },
        "outside_image_count": {
          "minimum": 0,
          "title": "Outside Image Count",
          "type": "integer"
        },
        "total_count": {
          "minimum": 0,
          "title": "Total Count",
          "type": "integer"
        }
      },
      "required": [
        "total_count",
        "below_confidence_count",
        "behind_camera_count",
        "invalid_projection_count",
        "outside_image_count",
        "accepted_count"
      ],
      "title": "CameraLidarCorrespondenceGateCounts",
      "type": "object"
    },
    "CameraLidarCorrespondenceQualityProvenance": {
      "additionalProperties": false,
      "description": "Digest-bound correspondence and refinement-result lineage.",
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "generator": {
          "default": "calibrex.evaluation.camera_lidar_correspondence_quality",
          "title": "Generator",
          "type": "string"
        },
        "generator_version": {
          "default": "v0.1",
          "title": "Generator Version",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "source_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Source Paths",
          "type": "array"
        },
        "source_sha256": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 2,
          "title": "Source Sha256",
          "type": "object"
        }
      },
      "required": [
        "source_paths",
        "source_sha256"
      ],
      "title": "CameraLidarCorrespondenceQualityProvenance",
      "type": "object"
    },
    "CameraLidarCorrespondenceQualitySummary": {
      "additionalProperties": false,
      "description": "Aggregate support, rejection, and observability statistics.",
      "properties": {
        "accepted_correspondence_count": {
          "minimum": 0,
          "title": "Accepted Correspondence Count",
          "type": "integer"
        },
        "accepted_correspondence_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Accepted Correspondence Rate",
          "type": "number"
        },
        "aggregate_observability": {
          "$ref": "#/$defs/CameraLidarPoseObservability"
        },
        "frame_count": {
          "minimum": 1,
          "title": "Frame Count",
          "type": "integer"
        },
        "frames_meeting_minimum_count": {
          "minimum": 0,
          "title": "Frames Meeting Minimum Count",
          "type": "integer"
        },
        "frames_meeting_minimum_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Frames Meeting Minimum Rate",
          "type": "number"
        },
        "full_rank_frame_count": {
          "minimum": 0,
          "title": "Full Rank Frame Count",
          "type": "integer"
        },
        "gate_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Gate Reasons",
          "type": "array"
        },
        "grade": {
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "title": "Grade",
          "type": "string"
        },
        "holdout_accepted_correspondence_count": {
          "minimum": 0,
          "title": "Holdout Accepted Correspondence Count",
          "type": "integer"
        },
        "holdout_frame_count": {
          "minimum": 0,
          "title": "Holdout Frame Count",
          "type": "integer"
        },
        "minimum_holdout_correspondence_count": {
          "minimum": 0,
          "title": "Minimum Holdout Correspondence Count",
          "type": "integer"
        },
        "minimum_train_correspondence_count": {
          "minimum": 0,
          "title": "Minimum Train Correspondence Count",
          "type": "integer"
        },
        "rejection_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Rejection Counts",
          "type": "object"
        },
        "total_correspondence_count": {
          "minimum": 0,
          "title": "Total Correspondence Count",
          "type": "integer"
        },
        "train_accepted_correspondence_count": {
          "minimum": 0,
          "title": "Train Accepted Correspondence Count",
          "type": "integer"
        },
        "train_frame_count": {
          "minimum": 0,
          "title": "Train Frame Count",
          "type": "integer"
        }
      },
      "required": [
        "frame_count",
        "train_frame_count",
        "holdout_frame_count",
        "total_correspondence_count",
        "accepted_correspondence_count",
        "accepted_correspondence_rate",
        "train_accepted_correspondence_count",
        "holdout_accepted_correspondence_count",
        "minimum_train_correspondence_count",
        "minimum_holdout_correspondence_count",
        "frames_meeting_minimum_count",
        "frames_meeting_minimum_rate",
        "full_rank_frame_count",
        "aggregate_observability",
        "rejection_counts",
        "grade"
      ],
      "title": "CameraLidarCorrespondenceQualitySummary",
      "type": "object"
    },
    "CameraLidarDistributionSummary": {
      "additionalProperties": false,
      "description": "Deterministic scalar distribution summary.",
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean"
        },
        "median": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "p10": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P10"
        },
        "p90": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P90"
        },
        "p95": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P95"
        }
      },
      "required": [
        "count"
      ],
      "title": "CameraLidarDistributionSummary",
      "type": "object"
    },
    "CameraLidarImageCoverage": {
      "additionalProperties": false,
      "description": "Accepted projection coverage on a fixed image grid.",
      "properties": {
        "grid_columns": {
          "minimum": 1,
          "title": "Grid Columns",
          "type": "integer"
        },
        "grid_rows": {
          "minimum": 1,
          "title": "Grid Rows",
          "type": "integer"
        },
        "normalized_bounding_box_area": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Normalized Bounding Box Area",
          "type": "number"
        },
        "occupancy_ratio": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Occupancy Ratio",
          "type": "number"
        },
        "occupied_cell_count": {
          "minimum": 0,
          "title": "Occupied Cell Count",
          "type": "integer"
        }
      },
      "required": [
        "grid_columns",
        "grid_rows",
        "occupied_cell_count",
        "occupancy_ratio",
        "normalized_bounding_box_area"
      ],
      "title": "CameraLidarImageCoverage",
      "type": "object"
    },
    "CameraLidarPoseObservability": {
      "additionalProperties": false,
      "description": "Scale-normalized local six-DoF information diagnostics.",
      "properties": {
        "axis_information_fraction": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Axis Information Fraction",
          "type": "object"
        },
        "condition_number": {
          "anyOf": [
            {
              "minimum": 1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition Number"
        },
        "factor_count": {
          "minimum": 0,
          "title": "Factor Count",
          "type": "integer"
        },
        "parameter_order": {
          "items": {
            "enum": [
              "rx",
              "ry",
              "rz",
              "tx",
              "ty",
              "tz"
            ],
            "type": "string"
          },
          "title": "Parameter Order",
          "type": "array"
        },
        "parameter_scales": {
          "items": {
            "type": "number"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Parameter Scales",
          "type": "array"
        },
        "rank": {
          "maximum": 6,
          "minimum": 0,
          "title": "Rank",
          "type": "integer"
        },
        "singular_values": {
          "items": {
            "type": "number"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Singular Values",
          "type": "array"
        },
        "weak_axes": {
          "items": {
            "enum": [
              "rx",
              "ry",
              "rz",
              "tx",
              "ty",
              "tz"
            ],
            "type": "string"
          },
          "title": "Weak Axes",
          "type": "array"
        }
      },
      "required": [
        "parameter_order",
        "parameter_scales",
        "factor_count",
        "singular_values",
        "rank",
        "axis_information_fraction",
        "weak_axes"
      ],
      "title": "CameraLidarPoseObservability",
      "type": "object"
    },
    "CorrespondenceProviderIdentity": {
      "additionalProperties": false,
      "description": "Identity and redistribution boundary of the external provider.",
      "properties": {
        "checkpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/DepthFileReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "checkpoint_redistribution": {
          "title": "Checkpoint Redistribution",
          "type": "string"
        },
        "license_spdx": {
          "title": "License Spdx",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "source_commit": {
          "title": "Source Commit",
          "type": "string"
        },
        "source_repository": {
          "title": "Source Repository",
          "type": "string"
        },
        "training": {
          "anyOf": [
            {
              "$ref": "#/$defs/CorrespondenceTrainingDeclaration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "version",
        "source_repository",
        "source_commit",
        "license_spdx",
        "checkpoint_redistribution"
      ],
      "title": "CorrespondenceProviderIdentity",
      "type": "object"
    },
    "CorrespondenceTrainingDeclaration": {
      "additionalProperties": false,
      "description": "Training-corpus relationship for a learned correspondence provider.",
      "properties": {
        "evaluation_overlap": {
          "enum": [
            "none",
            "possible",
            "confirmed",
            "unknown"
          ],
          "title": "Evaluation Overlap",
          "type": "string"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        },
        "test_data_used_for_online_refinement": {
          "title": "Test Data Used For Online Refinement",
          "type": "boolean"
        },
        "training_datasets": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Training Datasets",
          "type": "array"
        }
      },
      "required": [
        "training_datasets",
        "evaluation_overlap",
        "test_data_used_for_online_refinement",
        "evidence"
      ],
      "title": "CorrespondenceTrainingDeclaration",
      "type": "object"
    },
    "CovarianceInfo": {
      "additionalProperties": false,
      "properties": {
        "matrix": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Matrix",
          "type": "array"
        },
        "order": {
          "items": {
            "type": "string"
          },
          "title": "Order",
          "type": "array"
        }
      },
      "required": [
        "order",
        "matrix"
      ],
      "title": "CovarianceInfo",
      "type": "object"
    },
    "DepthFileReference": {
      "additionalProperties": false,
      "description": "Content-addressed depth-provider input or output file.",
      "properties": {
        "encoding": {
          "title": "Encoding",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "encoding"
      ],
      "title": "DepthFileReference",
      "type": "object"
    },
    "TransformEstimateProvenance": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Version"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "evidence_level": {
          "default": "unknown",
          "enum": [
            "synthetic_truth",
            "independently_measured",
            "dataset_provided",
            "factory_provided",
            "algorithmically_refined",
            "imported_without_documented_derivation",
            "unknown"
          ],
          "title": "Evidence Level",
          "type": "string"
        },
        "execution_mode": {
          "default": "unknown",
          "enum": [
            "offline_batch",
            "sliding_window",
            "online_stream",
            "manual",
            "imported",
            "dataset_reference",
            "unknown"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "license_spdx": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Spdx"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "producer": {
          "default": "unknown",
          "enum": [
            "slac_native",
            "external_tool",
            "human",
            "dataset_provider",
            "factory",
            "unknown"
          ],
          "title": "Producer",
          "type": "string"
        },
        "role_in_comparison": {
          "anyOf": [
            {
              "enum": [
                "initial",
                "candidate",
                "selected_reference",
                "output",
                "comparison_baseline"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role In Comparison"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "source_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Commit"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Path"
        },
        "tool_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Name"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        }
      },
      "title": "TransformEstimateProvenance",
      "type": "object"
    },
    "TransformQuality": {
      "additionalProperties": false,
      "properties": {
        "grade": {
          "default": "warn",
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "title": "Grade",
          "type": "string"
        },
        "std_rotation_deg": {
          "items": {
            "type": "number"
          },
          "title": "Std Rotation Deg",
          "type": "array"
        },
        "std_translation_m": {
          "items": {
            "type": "number"
          },
          "title": "Std Translation M",
          "type": "array"
        }
      },
      "title": "TransformQuality",
      "type": "object"
    },
    "TransformResult": {
      "additionalProperties": false,
      "properties": {
        "child": {
          "title": "Child",
          "type": "string"
        },
        "convention": {
          "const": "T_parent_child",
          "default": "T_parent_child",
          "title": "Convention",
          "type": "string"
        },
        "covariance": {
          "anyOf": [
            {
              "$ref": "#/$defs/CovarianceInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "estimate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimate Id"
        },
        "parent": {
          "title": "Parent",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/TransformEstimateProvenance"
        },
        "quality": {
          "$ref": "#/$defs/TransformQuality"
        },
        "rotation_quat_xyzw": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Rotation Quat Xyzw",
          "type": "array"
        },
        "translation_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Translation M",
          "type": "array"
        }
      },
      "required": [
        "parent",
        "child",
        "translation_m",
        "rotation_quat_xyzw"
      ],
      "title": "TransformResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Post-hoc, pose-dependent quality report for probabilistic correspondences.",
  "properties": {
    "analysis_scope": {
      "const": "posthoc_all_result_frames",
      "default": "posthoc_all_result_frames",
      "title": "Analysis Scope",
      "type": "string"
    },
    "correspondence_artifact_id": {
      "title": "Correspondence Artifact Id",
      "type": "string"
    },
    "correspondence_artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Correspondence Artifact Sha256",
      "type": "string"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "frames": {
      "items": {
        "$ref": "#/$defs/CameraLidarCorrespondenceFrameQuality"
      },
      "minItems": 1,
      "title": "Frames",
      "type": "array"
    },
    "holdout_used_for_selection": {
      "const": false,
      "default": false,
      "title": "Holdout Used For Selection",
      "type": "boolean"
