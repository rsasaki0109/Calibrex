{
  "$defs": {
    "LidarWheelControl": {
      "additionalProperties": false,
      "description": "Held-out chi-square increase after a known-bad shift.",
      "properties": {
        "amount": {
          "title": "Amount",
          "type": "number"
        },
        "detected": {
          "title": "Detected",
          "type": "boolean"
        },
        "holdout_delta_chi2": {
          "title": "Holdout Delta Chi2",
          "type": "number"
        },
        "unit": {
          "enum": [
            "deg",
            "m",
            "ratio",
            "s"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "unit",
        "holdout_delta_chi2",
        "detected"
      ],
      "title": "LidarWheelControl",
      "type": "object"
    },
    "LidarWheelProvenance": {
      "additionalProperties": false,
      "description": "Inputs and generator lineage.",
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "dataset_family": {
          "title": "Dataset Family",
          "type": "string"
        },
        "dataset_license": {
          "title": "Dataset License",
          "type": "string"
        },
        "generator": {
          "title": "Generator",
          "type": "string"
        },
        "generator_version": {
          "title": "Generator Version",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "sequence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Sequence Ids",
          "type": "array"
        },
        "wheel_source": {
          "title": "Wheel Source",
          "type": "string"
        }
      },
      "required": [
        "generator",
        "generator_version",
        "dataset_family",
        "sequence_ids",
        "wheel_source",
        "input_sha256",
        "dataset_license"
      ],
      "title": "LidarWheelProvenance",
      "type": "object"
    },
    "LidarWheelRecord": {
      "additionalProperties": false,
      "description": "One estimated parameter.",
      "properties": {
        "known_bad_control": {
          "anyOf": [
            {
              "$ref": "#/$defs/LidarWheelControl"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "enum": [
            "roll",
            "pitch",
            "yaw",
            "lever",
            "speed_scale",
            "time_offset"
          ],
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "estimated",
            "unobservable"
          ],
          "title": "Status",
          "type": "string"
        },
        "std_analytic": {
          "minimum": 0.0,
          "title": "Std Analytic",
          "type": "number"
        },
        "std_jackknife": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Std Jackknife"
        },
        "std_reported": {
          "minimum": 0.0,
          "title": "Std Reported",
          "type": "number"
        },
        "unit": {
          "enum": [
            "deg",
            "m",
            "ratio",
            "s"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "unit",
        "value",
        "std_analytic",
        "std_reported",
        "status"
      ],
      "title": "LidarWheelRecord",
      "type": "object"
    },
    "LidarWheelReference": {
      "additionalProperties": false,
      "description": "A reference rotation and the estimate's difference from it.",
      "properties": {
        "difference_deg": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Difference Deg",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "rotation_quat_xyzw": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Rotation Quat Xyzw",
          "type": "array"
        }
      },
      "required": [
        "name",
        "rotation_quat_xyzw",
        "difference_deg"
      ],
      "title": "LidarWheelReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Evidence for one LiDAR-to-wheel-odometry calibration run.",
  "properties": {
    "calibrated_parameters": {
      "items": {
        "enum": [
          "roll",
          "pitch",
          "yaw",
          "lever",
          "speed_scale",
          "time_offset"
        ],
        "type": "string"
      },
      "title": "Calibrated Parameters",
      "type": "array"
    },
    "holdout_median_normalized_residual": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Holdout Median Normalized Residual"
    },
    "holdout_motions": {
      "minimum": 0,
      "title": "Holdout Motions",
      "type": "integer"
    },
    "jackknife_fits": {
      "minimum": 0,
      "title": "Jackknife Fits",
      "type": "integer"
    },
    "lever_m": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lever M"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "method": {
      "const": "wheel_odometry_motion/v0.1",
      "default": "wheel_odometry_motion/v0.1",
      "title": "Method",
      "type": "string"
    },
    "motions": {
      "minimum": 0,
      "title": "Motions",
      "type": "integer"
    },
    "options": {
      "additionalProperties": true,
      "title": "Options",
      "type": "object"
    },
    "parameters": {
      "items": {
        "$ref": "#/$defs/LidarWheelRecord"
      },
      "title": "Parameters",
      "type": "array"
    },
    "policy_reasons": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Policy Reasons",
      "type": "array"
    },
    "policy_status": {
      "enum": [
        "pass",
        "warn",
        "fail",
        "inconclusive"
      ],
      "title": "Policy Status",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/LidarWheelProvenance"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/LidarWheelReference"
      },
      "title": "References",
      "type": "array"
    },
    "rotation_quat_xyzw": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rotation Quat Xyzw"
    },
    "schema_version": {
      "const": "slac.lidar_wheel_odometry/v0.1",
      "default": "slac.lidar_wheel_odometry/v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "solver_status": {
      "enum": [
        "converged",
        "insufficient_motions"
      ],
      "title": "Solver Status",
      "type": "string"
    },
    "speed_scale": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Speed Scale"
    },
    "time_offset_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Time Offset S"
    },
    "train_median_normalized_residual": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Train Median Normalized Residual"
    },
    "train_motions": {
      "minimum": 0,
      "title": "Train Motions",
      "type": "integer"
    }
  },
  "required": [
    "solver_status",
    "policy_status",
    "policy_reasons",
    "calibrated_parameters",
    "parameters",
    "motions",
    "train_motions",
    "holdout_motions",
    "jackknife_fits",
    "options",
    "provenance"
  ],
  "title": "LidarWheelOdometryArtifact",
  "type": "object"
}
