{
  "$defs": {
    "EvidenceBundleSource": {
      "additionalProperties": false,
      "description": "Digest identity of the bundle verified by a verification artifact.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "schema_version",
        "run_id"
      ],
      "title": "EvidenceBundleSource",
      "type": "object"
    },
    "EvidenceMaterializationInfo": {
      "additionalProperties": false,
      "description": "How an evidence artifact was materialized for this report.",
      "properties": {
        "computed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Computed At"
        },
        "data_verified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Verified"
        },
        "metrics_origin": {
          "default": "unknown",
          "enum": [
            "recomputed",
            "cached",
            "unknown"
          ],
          "title": "Metrics Origin",
          "type": "string"
        },
        "report_generated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Generated At"
        }
      },
      "title": "EvidenceMaterializationInfo",
      "type": "object"
    },
    "VerificationClaim": {
      "additionalProperties": false,
      "description": "One machine-readable verification check performed on a bundle.",
      "properties": {
        "expected": {
          "additionalProperties": true,
          "title": "Expected",
          "type": "object"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "observed": {
          "additionalProperties": true,
          "title": "Observed",
          "type": "object"
        },
        "scope": {
          "enum": [
            "bundle_manifest",
            "artifact_digest",
            "artifact_schema",
            "run_consistency",
            "assessment_source",
            "source_evidence_link",
            "input_file_digest",
            "raw_recomputed_requirement"
          ],
          "title": "Scope",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "subject",
        "status",
        "method"
      ],
      "title": "VerificationClaim",
      "type": "object"
    },
    "VerificationClaimSummary": {
      "additionalProperties": false,
      "description": "Rollup counts for verification claims.",
      "properties": {
        "by_scope": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Scope",
          "type": "object"
        },
        "failed": {
          "default": 0,
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "ok": {
          "default": 0,
          "minimum": 0,
          "title": "Ok",
          "type": "integer"
        },
        "skipped": {
          "default": 0,
          "minimum": 0,
          "title": "Skipped",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "total"
      ],
      "title": "VerificationClaimSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Machine-readable verification result for an evidence bundle.",
  "properties": {
    "artifact_count": {
      "title": "Artifact Count",
      "type": "integer"
    },
    "checked_artifacts": {
      "items": {
        "type": "string"
      },
      "title": "Checked Artifacts",
      "type": "array"
    },
    "checked_input_file_count": {
      "default": 0,
      "minimum": 0,
      "title": "Checked Input File Count",
      "type": "integer"
    },
    "checked_input_files": {
      "items": {
        "type": "string"
      },
      "title": "Checked Input Files",
      "type": "array"
    },
    "input_file_count": {
      "default": 0,
      "minimum": 0,
      "title": "Input File Count",
      "type": "integer"
    },
    "issue_count": {
      "title": "Issue Count",
      "type": "integer"
    },
    "issues": {
      "items": {
        "type": "string"
      },
      "title": "Issues",
      "type": "array"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "primary_evidence_materialization": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceMaterializationInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "raw_recomputed_required": {
      "default": false,
      "title": "Raw Recomputed Required",
      "type": "boolean"
    },
    "schema_version": {
      "const": "calibrex.evidence_bundle.verification/v0.1",
      "default": "calibrex.evidence_bundle.verification/v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_bundle": {
      "$ref": "#/$defs/EvidenceBundleSource"
    },
    "valid": {
      "title": "Valid",
      "type": "boolean"
    },
    "verification_claims": {
      "items": {
        "$ref": "#/$defs/VerificationClaim"
      },
      "title": "Verification Claims",
      "type": "array"
    },
    "verification_summary": {
      "$ref": "#/$defs/VerificationClaimSummary"
    }
  },
  "required": [
    "path",
    "source_bundle",
    "valid",
    "issue_count",
    "issues",
    "artifact_count",
    "checked_artifacts",
    "verification_summary"
  ],
  "title": "EvidenceBundleVerification",
  "type": "object"
}
