{
  "$defs": {
    "ContinuousTimeLidarPairOptionsArtifact": {
      "additionalProperties": false,
      "description": "Profile and fixed-extrinsic solver settings recorded in the result.",
      "properties": {
        "adaptive_max_voxel_size_m": {
          "exclusiveMinimum": 0.0,
          "title": "Adaptive Max Voxel Size M",
          "type": "number"
        },
        "adaptive_min_points_per_voxel": {
          "minimum": 1,
          "title": "Adaptive Min Points Per Voxel",
          "type": "integer"
        },
        "adaptive_min_voxel_size_m": {
          "exclusiveMinimum": 0.0,
          "title": "Adaptive Min Voxel Size M",
          "type": "number"
        },
        "adaptive_range_exponent": {
          "minimum": 0.0,
          "title": "Adaptive Range Exponent",
          "type": "number"
        },
        "adaptive_range_reference_m": {
          "exclusiveMinimum": 0.0,
          "title": "Adaptive Range Reference M",
          "type": "number"
        },
        "adaptive_use_uniform_fallback": {
          "default": true,
          "title": "Adaptive Use Uniform Fallback",
          "type": "boolean"
        },
        "correspondence_refinement_iterations": {
          "minimum": 0,
          "title": "Correspondence Refinement Iterations",
          "type": "integer"
        },
        "fixed_extrinsic_max_iterations": {
          "minimum": 0,
          "title": "Fixed Extrinsic Max Iterations",
          "type": "integer"
        },
        "fixed_extrinsic_robust_loss": {
          "enum": [
            "none",
            "huber"
          ],
          "title": "Fixed Extrinsic Robust Loss",
          "type": "string"
        },
        "holdout_start_fraction": {
          "default": 0.8,
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Holdout Start Fraction",
          "type": "number"
        },
        "initial_time_offset_sec": {
          "title": "Initial Time Offset Sec",
          "type": "number"
        },
        "initial_time_step_sec": {
          "exclusiveMinimum": 0.0,
          "title": "Initial Time Step Sec",
          "type": "number"
        },
        "max_abs_time_offset_sec": {
          "minimum": 0.0,
          "title": "Max Abs Time Offset Sec",
          "type": "number"
        },
        "max_iterations": {
          "minimum": 1,
          "title": "Max Iterations",
          "type": "integer"
        },
        "max_odometry_extrapolation_s": {
          "minimum": 0.0,
          "title": "Max Odometry Extrapolation S",
          "type": "number"
        },
        "max_source_records": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Source Records"
        },
        "max_target_points_per_split": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Target Points Per Split"
        },
        "min_correspondences": {
          "minimum": 1,
          "title": "Min Correspondences",
          "type": "integer"
        },
        "minimum_time_step_sec": {
          "exclusiveMinimum": 0.0,
          "title": "Minimum Time Step Sec",
          "type": "number"
        },
        "outlier_mad_scale": {
          "minimum": 0.0,
          "title": "Outlier Mad Scale",
          "type": "number"
        },
        "outlier_min_inlier_fraction": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Outlier Min Inlier Fraction",
          "type": "number"
        },
        "outlier_min_threshold_m": {
          "minimum": 0.0,
          "title": "Outlier Min Threshold M",
          "type": "number"
        },
        "outlier_policy": {
          "enum": [
            "none",
            "mad"
          ],
          "title": "Outlier Policy",
          "type": "string"
        },
        "sampling_seed": {
          "default": 0,
          "title": "Sampling Seed",
          "type": "integer"
        },
        "voxel_strategy": {
          "enum": [
            "uniform",
            "adaptive"
          ],
          "title": "Voxel Strategy",
          "type": "string"
        }
      },
      "required": [
        "initial_time_offset_sec",
        "max_abs_time_offset_sec",
        "initial_time_step_sec",
        "minimum_time_step_sec",
        "max_iterations",
        "min_correspondences",
        "max_odometry_extrapolation_s",
        "outlier_policy",
        "outlier_mad_scale",
        "outlier_min_threshold_m",
        "outlier_min_inlier_fraction",
        "voxel_strategy",
        "adaptive_range_reference_m",
        "adaptive_range_exponent",
        "adaptive_min_voxel_size_m",
        "adaptive_max_voxel_size_m",
        "adaptive_min_points_per_voxel",
        "correspondence_refinement_iterations",
        "fixed_extrinsic_max_iterations",
        "fixed_extrinsic_robust_loss"
      ],
      "title": "ContinuousTimeLidarPairOptionsArtifact",
      "type": "object"
    },
    "SolidStateFailureAnalysisFinding": {
      "additionalProperties": false,
      "description": "An evidence-backed observation or explicitly labelled causal hypothesis.",
      "properties": {
        "caveat": {
          "title": "Caveat",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "candidate_cause"
          ],
          "title": "Severity",
          "type": "string"
        },
        "supporting_replicates": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Replicates",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "severity",
        "confidence",
        "title",
        "evidence",
        "caveat"
      ],
      "title": "SolidStateFailureAnalysisFinding",
      "type": "object"
    },
    "SolidStateFailureAnalysisProvenance": {
      "additionalProperties": false,
      "description": "Digest-bound inputs used to derive the analysis.",
      "properties": {
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "source_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Paths",
          "type": "array"
        },
        "source_sha256": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Source Sha256",
          "type": "object"
        },
        "tool_name": {
          "default": "calibrex",
          "title": "Tool Name",
          "type": "string"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        }
      },
      "required": [
        "source_paths",
        "source_sha256"
      ],
      "title": "SolidStateFailureAnalysisProvenance",
      "type": "object"
    },
    "SolidStateFailureAnalysisReplicate": {
      "additionalProperties": false,
      "description": "Paired adaptive/uniform diagnostics for one split and sampling seed.",
      "properties": {
        "adaptive": {
          "anyOf": [
            {
              "$ref": "#/$defs/SolidStateFailureAnalysisVariant"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "adaptive_condition_number_minus_uniform": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adaptive Condition Number Minus Uniform"
        },
        "adaptive_correspondence_delta": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adaptive Correspondence Delta"
        },
        "adaptive_generalization_gap_minus_uniform_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adaptive Generalization Gap Minus Uniform M"
        },
        "adaptive_holdout_minus_uniform_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adaptive Holdout Minus Uniform M"
        },
        "adaptive_offset_minus_uniform_sec": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adaptive Offset Minus Uniform Sec"
        },
        "adaptive_outlier_rate_minus_uniform": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adaptive Outlier Rate Minus Uniform"
        },
        "adaptive_train_minus_uniform_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adaptive Train Minus Uniform M"
        },
        "diagnosis": {
          "title": "Diagnosis",
          "type": "string"
        },
        "holdout_improvement_percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holdout Improvement Percent"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "signals": {
          "items": {
            "type": "string"
          },
          "title": "Signals",
          "type": "array"
        },
        "split_id": {
          "title": "Split Id",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "uniform": {
          "anyOf": [
            {
              "$ref": "#/$defs/SolidStateFailureAnalysisVariant"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "winner": {
          "enum": [
            "adaptive",
            "uniform",
            "tie",
            "inconclusive"
          ],
          "title": "Winner",
          "type": "string"
        }
      },
      "required": [
        "id",
        "split_id",
        "seed",
        "status",
        "winner",
        "diagnosis"
      ],
      "title": "SolidStateFailureAnalysisReplicate",
      "type": "object"
    },
    "SolidStateFailureAnalysisSummary": {
      "additionalProperties": false,
      "description": "Aggregate statistics for the selected dataset.",
      "properties": {
        "adaptive_converged_count": {
          "minimum": 0,
