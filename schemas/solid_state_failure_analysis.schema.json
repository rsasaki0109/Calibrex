        "replicate_count": {
          "minimum": 0,
          "title": "Replicate Count",
          "type": "integer"
        },
        "scored_replicate_count": {
          "minimum": 0,
          "title": "Scored Replicate Count",
          "type": "integer"
        },
        "ties": {
          "minimum": 0,
          "title": "Ties",
          "type": "integer"
        },
        "uniform_converged_count": {
          "minimum": 0,
          "title": "Uniform Converged Count",
          "type": "integer"
        },
        "uniform_rank_six_count": {
          "minimum": 0,
          "title": "Uniform Rank Six Count",
          "type": "integer"
        },
        "uniform_wins": {
          "minimum": 0,
          "title": "Uniform Wins",
          "type": "integer"
        }
      },
      "required": [
        "replicate_count",
        "scored_replicate_count",
        "adaptive_wins",
        "uniform_wins",
        "ties",
        "adaptive_rank_six_count",
        "uniform_rank_six_count",
        "adaptive_converged_count",
        "uniform_converged_count"
      ],
      "title": "SolidStateFailureAnalysisSummary",
      "type": "object"
