        "adaptive_rank_six_count": {
          "minimum": 0,
          "title": "Adaptive Rank Six Count",
          "type": "integer"
        },
        "adaptive_win_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adaptive Win Rate"
        },
        "adaptive_wins": {
          "minimum": 0,
          "title": "Adaptive Wins",
          "type": "integer"
