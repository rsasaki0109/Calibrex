    "analysis_scope": {
      "title": "Analysis Scope",
      "type": "string"
    },
    "benchmark_manifest_path": {
      "title": "Benchmark Manifest Path",
      "type": "string"
    },
    "benchmark_manifest_sha256": {
      "pattern": "^[0-9a-fA-F]{64}$",
      "title": "Benchmark Manifest Sha256",
      "type": "string"
    },
    "conclusion": {
      "title": "Conclusion",
      "type": "string"
    },
    "dataset_id": {
