{
  "$defs": {
    "CorrespondenceProviderIdentity": {
      "additionalProperties": false,
      "description": "Identity and redistribution boundary of the external provider.",
      "properties": {
        "checkpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/DepthFileReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "checkpoint_redistribution": {
          "title": "Checkpoint Redistribution",
          "type": "string"
        },
        "license_spdx": {
          "title": "License Spdx",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "source_commit": {
          "title": "Source Commit",
          "type": "string"
        },
        "source_repository": {
          "title": "Source Repository",
          "type": "string"
        },
        "training": {
          "anyOf": [
            {
              "$ref": "#/$defs/CorrespondenceTrainingDeclaration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "version",
        "source_repository",
        "source_commit",
        "license_spdx",
        "checkpoint_redistribution"
      ],
      "title": "CorrespondenceProviderIdentity",
      "type": "object"
    },
    "CorrespondenceTrainingDeclaration": {
      "additionalProperties": false,
      "description": "Training-corpus relationship for a learned correspondence provider.",
      "properties": {
        "evaluation_overlap": {
          "enum": [
            "none",
            "possible",
            "confirmed",
            "unknown"
          ],
          "title": "Evaluation Overlap",
          "type": "string"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        },
        "test_data_used_for_online_refinement": {
          "title": "Test Data Used For Online Refinement",
          "type": "boolean"
        },
        "training_datasets": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Training Datasets",
          "type": "array"
        }
      },
      "required": [
        "training_datasets",
        "evaluation_overlap",
        "test_data_used_for_online_refinement",
        "evidence"
      ],
      "title": "CorrespondenceTrainingDeclaration",
      "type": "object"
    },
    "CovarianceInfo": {
      "additionalProperties": false,
      "properties": {
        "matrix": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Matrix",
          "type": "array"
        },
        "order": {
          "items": {
            "type": "string"
          },
          "title": "Order",
          "type": "array"
        }
      },
      "required": [
        "order",
        "matrix"
      ],
      "title": "CovarianceInfo",
      "type": "object"
    },
    "DepthFileReference": {
      "additionalProperties": false,
      "description": "Content-addressed depth-provider input or output file.",
      "properties": {
        "encoding": {
          "title": "Encoding",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "encoding"
      ],
      "title": "DepthFileReference",
      "type": "object"
    },
    "ProbabilisticPnpResultProvenance": {
      "additionalProperties": false,
      "description": "Immutable input and execution lineage for a PnP result.",
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "correspondence_artifact_id": {
          "title": "Correspondence Artifact Id",
          "type": "string"
        },
        "correspondence_artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Correspondence Artifact Sha256",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "generator": {
          "title": "Generator",
          "type": "string"
        },
        "generator_version": {
          "title": "Generator Version",
          "type": "string"
        },
        "initialization_artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initialization Artifact Sha256"
        }
      },
      "required": [
        "generator",
        "generator_version",
        "correspondence_artifact_id",
        "correspondence_artifact_sha256"
      ],
      "title": "ProbabilisticPnpResultProvenance",
      "type": "object"
    },
    "ProbabilisticPnpToolIdentity": {
      "additionalProperties": false,
      "description": "External pose-estimator identity and license boundary.",
      "properties": {
        "api_reference": {
          "title": "Api Reference",
          "type": "string"
        },
        "execution_mode": {
          "enum": [
            "optional_import",
            "subprocess",
            "container"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "license_spdx": {
          "title": "License Spdx",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "name",
        "source_url",
        "api_reference",
        "license_spdx",
        "execution_mode"
      ],
      "title": "ProbabilisticPnpToolIdentity",
      "type": "object"
    },
    "TransformEstimateProvenance": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Version"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "evidence_level": {
          "default": "unknown",
          "enum": [
            "synthetic_truth",
            "independently_measured",
            "dataset_provided",
            "factory_provided",
            "algorithmically_refined",
            "imported_without_documented_derivation",
            "unknown"
          ],
          "title": "Evidence Level",
          "type": "string"
        },
        "execution_mode": {
          "default": "unknown",
          "enum": [
            "offline_batch",
            "sliding_window",
            "online_stream",
            "manual",
            "imported",
            "dataset_reference",
            "unknown"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "license_spdx": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Spdx"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "producer": {
          "default": "unknown",
          "enum": [
            "slac_native",
            "external_tool",
            "human",
            "dataset_provider",
            "factory",
            "unknown"
          ],
          "title": "Producer",
          "type": "string"
        },
        "role_in_comparison": {
          "anyOf": [
            {
              "enum": [
                "initial",
                "candidate",
                "selected_reference",
                "output",
                "comparison_baseline"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role In Comparison"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "source_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Commit"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Path"
        },
        "tool_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Name"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        }
      },
      "title": "TransformEstimateProvenance",
      "type": "object"
    },
    "TransformQuality": {
      "additionalProperties": false,
      "properties": {
        "grade": {
          "default": "warn",
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "title": "Grade",
          "type": "string"
        },
        "std_rotation_deg": {
          "items": {
            "type": "number"
          },
          "title": "Std Rotation Deg",
          "type": "array"
        },
        "std_translation_m": {
          "items": {
            "type": "number"
          },
          "title": "Std Translation M",
          "type": "array"
        }
      },
      "title": "TransformQuality",
      "type": "object"
    },
    "TransformResult": {
      "additionalProperties": false,
      "properties": {
        "child": {
          "title": "Child",
          "type": "string"
        },
        "convention": {
          "const": "T_parent_child",
          "default": "T_parent_child",
          "title": "Convention",
          "type": "string"
        },
        "covariance": {
          "anyOf": [
            {
              "$ref": "#/$defs/CovarianceInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "estimate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimate Id"
        },
        "parent": {
          "title": "Parent",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/TransformEstimateProvenance"
        },
        "quality": {
          "$ref": "#/$defs/TransformQuality"
        },
        "rotation_quat_xyzw": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Rotation Quat Xyzw",
          "type": "array"
        },
        "translation_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Translation M",
          "type": "array"
        }
      },
      "required": [
        "parent",
        "child",
        "translation_m",
        "rotation_quat_xyzw"
      ],
      "title": "TransformResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema-valid output of uncertainty-aware robust pose estimation.",
  "properties": {
    "frame_id": {
      "title": "Frame Id",
      "type": "string"
    },
    "initial_transform_camera_lidar": {
      "anyOf": [
        {
          "$ref": "#/$defs/TransformResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mean_mahalanobis_error": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mean Mahalanobis Error"
    },
    "method": {
      "title": "Method",
      "type": "string"
    },
    "options": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "title": "Options",
      "type": "object"
    },
    "probabilistic_inlier_count": {
      "minimum": 0,
      "title": "Probabilistic Inlier Count",
      "type": "integer"
    },
    "provenance": {
      "$ref": "#/$defs/ProbabilisticPnpResultProvenance"
    },
    "provider": {
      "$ref": "#/$defs/CorrespondenceProviderIdentity"
    },
    "ransac_inlier_count": {
      "minimum": 0,
      "title": "Ransac Inlier Count",
      "type": "integer"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "result_id": {
      "title": "Result Id",
      "type": "string"
    },
    "schema_version": {
      "const": "slac.probabilistic_pnp_result/v0.1",
      "default": "slac.probabilistic_pnp_result/v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_correspondence_count": {
      "minimum": 0,
      "title": "Selected Correspondence Count",
      "type": "integer"
    },
    "status": {
      "enum": [
        "converged",
        "unavailable",
        "failed",
        "insufficient_correspondences",
        "unsupported_camera"
      ],
      "title": "Status",
      "type": "string"
    },
    "tool": {
      "$ref": "#/$defs/ProbabilisticPnpToolIdentity"
    },
    "transform_camera_lidar": {
      "anyOf": [
        {
          "$ref": "#/$defs/TransformResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "weighted_reprojection_rmse_px": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Weighted Reprojection Rmse Px"
    }
  },
  "required": [
    "result_id",
    "status",
    "method",
    "frame_id",
    "selected_correspondence_count",
    "ransac_inlier_count",
    "probabilistic_inlier_count",
    "reason",
    "provider",
    "tool",
    "options",
    "provenance"
  ],
  "title": "ProbabilisticPnpResultArtifact",
  "type": "object"
}
