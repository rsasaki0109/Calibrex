{
  "$defs": {
    "CameraIntrinsicsConfig": {
      "additionalProperties": false,
      "properties": {
        "cx": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cx"
        },
        "cy": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cy"
        },
        "distortion": {
          "items": {
            "type": "number"
          },
          "title": "Distortion",
          "type": "array"
        },
        "distortion_model": {
          "default": "none",
          "title": "Distortion Model",
          "type": "string"
        },
        "estimate": {
          "default": false,
          "title": "Estimate",
          "type": "boolean"
        },
        "fx": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fx"
        },
        "fy": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fy"
        }
      },
      "title": "CameraIntrinsicsConfig",
      "type": "object"
    },
    "DatasetConfig": {
      "additionalProperties": false,
      "properties": {
        "odometry_topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "optional nav_msgs/msg/Odometry topic for online motion compensation from rosbag1/rosbag2 replays; unset preserves the static-rig path",
          "title": "Odometry Topic"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sample_limit": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "override the number of frames/files sampled for public-dataset diagnostics (a2d2_lidar, livox_pcd, kitti_raw); unset preserves each dataset type's current default",
          "title": "Sample Limit"
        },
        "time_base": {
          "default": "sensor_time_ns",
          "title": "Time Base",
          "type": "string"
        },
        "type": {
          "enum": [
            "a2d2_lidar",
            "filesystem",
            "kitti_raw",
            "livox_pcd",
            "mcap",
            "nuscenes",
            "rosbag1",
            "rosbag2",
            "tum_rgbd"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "path"
      ],
      "title": "DatasetConfig",
      "type": "object"
    },
    "EvaluationConfig": {
      "additionalProperties": false,
      "properties": {
        "holdout_ratio": {
          "default": 0.2,
          "maximum": 0.9,
          "minimum": 0.0,
          "title": "Holdout Ratio",
          "type": "number"
        },
        "kitti": {
          "$ref": "#/$defs/KITTIEvaluationConfig"
        },
        "metrics": {
          "items": {
            "type": "string"
          },
          "title": "Metrics",
          "type": "array"
        },
        "radar": {
          "$ref": "#/$defs/RadarEvaluationConfig"
        },
        "strict": {
          "default": false,
          "title": "Strict",
          "type": "boolean"
        }
      },
      "title": "EvaluationConfig",
      "type": "object"
    },
    "FactorConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "options": {
          "additionalProperties": true,
          "title": "Options",
          "type": "object"
        },
        "weight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight"
        }
      },
      "title": "FactorConfig",
      "type": "object"
    },
    "FrameConfig": {
      "additionalProperties": false,
      "properties": {
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "root": {
          "default": false,
          "title": "Root",
          "type": "boolean"
        },
        "transform": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransformConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "FrameConfig",
      "type": "object"
    },
    "ImuNoiseConfig": {
      "additionalProperties": false,
      "properties": {
        "accel_noise_density": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accel Noise Density"
        },
        "accel_random_walk": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accel Random Walk"
        },
        "gyro_noise_density": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gyro Noise Density"
        },
        "gyro_random_walk": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gyro Random Walk"
        }
      },
      "title": "ImuNoiseConfig",
      "type": "object"
    },
    "KITTIEvaluationConfig": {
      "additionalProperties": false,
      "properties": {
        "evidence_gate_min_depth_edge_alignment_holdout": {
          "default": 0.2,
          "description": "minimum holdout depth-edge alignment fraction for PASS evidence",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Evidence Gate Min Depth Edge Alignment Holdout",
          "type": "number"
        },
        "evidence_gate_min_edge_alignment_holdout": {
          "default": 0.2,
          "description": "minimum holdout edge-alignment fraction for PASS evidence",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Evidence Gate Min Edge Alignment Holdout",
          "type": "number"
        },
        "evidence_gate_min_mandatory_detectable_count": {
          "default": 8,
          "description": "minimum mandatory \u00b11 deg / \u00b10.10 m perturbation cases that must worsen projection scores",
          "minimum": 0,
          "title": "Evidence Gate Min Mandatory Detectable Count",
          "type": "integer"
        },
        "evidence_gate_min_perturbation_detectable_fraction": {
          "default": 0.5,
          "description": "minimum known-bad perturbation detectable fraction for PASS evidence",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Evidence Gate Min Perturbation Detectable Fraction",
          "type": "number"
        },
        "max_projection_pairs": {
          "default": 3,
          "maximum": 500,
          "minimum": 0,
          "title": "Max Projection Pairs",
          "type": "integer"
        },
        "perturbation_rotation_deg": {
          "items": {
            "type": "number"
          },
          "title": "Perturbation Rotation Deg",
          "type": "array"
        },
        "perturbation_translation_m": {
          "items": {
            "type": "number"
          },
          "title": "Perturbation Translation M",
          "type": "array"
        },
        "projection_sample_points": {
          "default": 800,
          "maximum": 200000,
          "minimum": 1,
          "title": "Projection Sample Points",
          "type": "integer"
        },
        "use_frame_graph_candidate": {
          "default": false,
          "description": "evaluate camera-LiDAR projection evidence from frame-graph candidate extrinsics instead of the dataset calibration file",
          "title": "Use Frame Graph Candidate",
          "type": "boolean"
        }
      },
      "title": "KITTIEvaluationConfig",
      "type": "object"
    },
    "OutputsConfig": {
      "additionalProperties": false,
      "properties": {
        "artifacts_dir": {
          "default": "artifacts",
          "title": "Artifacts Dir",
          "type": "string"
        },
        "report": {
          "default": "report.html",
          "title": "Report",
          "type": "string"
        },
        "result": {
          "default": "result.yaml",
          "title": "Result",
          "type": "string"
        }
      },
      "title": "OutputsConfig",
      "type": "object"
    },
    "PipelineConfig": {
      "additionalProperties": false,
      "properties": {
        "factors": {
          "additionalProperties": {
            "$ref": "#/$defs/FactorConfig"
          },
          "title": "Factors",
          "type": "object"
        },
        "frontends": {
          "items": {
            "type": "string"
          },
          "title": "Frontends",
          "type": "array"
        },
        "type": {
          "default": "multi_sensor_slac",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "PipelineConfig",
      "type": "object"
    },
    "ProjectConfig": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "domain": {
          "default": "robotics",
          "enum": [
            "robotics",
            "autonomous_driving",
            "industrial",
            "research",
            "other"
          ],
          "title": "Domain",
          "type": "string"
        },
        "name": {
          "default": "slac_project",
          "title": "Name",
          "type": "string"
        },
        "output_dir": {
          "default": "outputs/default",
          "title": "Output Dir",
          "type": "string"
        }
      },
      "title": "ProjectConfig",
      "type": "object"
    },
    "RadarEvaluationConfig": {
      "additionalProperties": false,
      "properties": {
        "max_frames_per_sensor": {
          "default": 30,
          "maximum": 10000,
          "minimum": 2,
          "title": "Max Frames Per Sensor",
          "type": "integer"
        },
        "max_holdout_median_abs_residual_mps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Holdout Median Abs Residual Mps"
        },
        "max_holdout_rmse_mps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Holdout Rmse Mps"
        },
        "min_holdout_frames": {
          "default": 5,
          "minimum": 1,
          "title": "Min Holdout Frames",
          "type": "integer"
        },
        "min_holdout_static_returns": {
          "default": 50,
          "minimum": 1,
          "title": "Min Holdout Static Returns",
          "type": "integer"
        },
        "min_mandatory_detectable_fraction": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Mandatory Detectable Fraction",
          "type": "number"
        },
        "min_static_fraction": {
          "default": 0.2,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Static Fraction",
          "type": "number"
        },
        "min_yaw_sensitivity_rms_mps_per_rad": {
          "default": 0.57,
          "minimum": 0.0,
          "title": "Min Yaw Sensitivity Rms Mps Per Rad",
          "type": "number"
        },
        "use_dataset_reference": {
          "default": false,
          "description": "evaluate dataset reference Radar extrinsics instead of configured candidates",
          "title": "Use Dataset Reference",
          "type": "boolean"
        }
      },
      "title": "RadarEvaluationConfig",
      "type": "object"
    },
    "SensorConfig": {
      "additionalProperties": false,
      "properties": {
        "camera_info_topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Camera Info Topic"
        },
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "frame_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Id"
        },
        "intrinsics": {
          "anyOf": [
            {
              "$ref": "#/$defs/CameraIntrinsicsConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model": {
          "default": "generic",
          "title": "Model",
          "type": "string"
        },
        "noise": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImuNoiseConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "point_time_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "optional PointCloud2 field name for per-point capture-time offsets relative to the message stamp (seconds or integer nanoseconds); enables per-point deskew during rosbag2 online motion compensation",
          "title": "Point Time Field"
        },
        "topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic"
        },
        "type": {
          "enum": [
            "camera",
            "lidar",
            "imu",
            "radar"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "SensorConfig",
      "type": "object"
    },
    "SolverConfig": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "scipy",
          "title": "Backend",
          "type": "string"
        },
        "convergence_tolerance": {
          "default": 1e-06,
          "exclusiveMinimum": 0.0,
          "title": "Convergence Tolerance",
          "type": "number"
        },
        "max_iterations": {
          "default": 50,
          "minimum": 0,
          "title": "Max Iterations",
          "type": "integer"
        },
        "robust_loss": {
          "default": "huber",
          "title": "Robust Loss",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "title": "SolverConfig",
      "type": "object"
    },
    "TimeOffsetConfig": {
      "additionalProperties": false,
      "properties": {
        "estimate": {
          "default": false,
          "title": "Estimate",
          "type": "boolean"
        },
        "initial_sec": {
          "default": 0.0,
          "title": "Initial Sec",
          "type": "number"
        },
        "prior_sigma_sec": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prior Sigma Sec"
        }
      },
      "title": "TimeOffsetConfig",
      "type": "object"
    },
    "TransformConfig": {
      "additionalProperties": false,
      "properties": {
        "estimate": {
          "default": true,
          "title": "Estimate",
          "type": "boolean"
        },
        "initial": {
          "$ref": "#/$defs/TransformInitialConfig"
        },
        "prior_sigma": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransformPriorSigmaConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "TransformConfig",
      "type": "object"
    },
    "TransformInitialConfig": {
      "additionalProperties": false,
      "properties": {
        "rotation_quat_xyzw": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Rotation Quat Xyzw",
          "type": "array"
        },
        "translation": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Translation",
          "type": "array"
        }
      },
      "title": "TransformInitialConfig",
      "type": "object"
    },
    "TransformPriorSigmaConfig": {
      "additionalProperties": false,
      "properties": {
        "rotation_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rotation Deg"
        },
        "translation_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Translation M"
        }
      },
      "title": "TransformPriorSigmaConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dataset": {
      "$ref": "#/$defs/DatasetConfig"
    },
    "evaluation": {
      "$ref": "#/$defs/EvaluationConfig"
    },
    "frames": {
      "additionalProperties": {
        "$ref": "#/$defs/FrameConfig"
      },
      "title": "Frames",
      "type": "object"
    },
    "outputs": {
      "$ref": "#/$defs/OutputsConfig"
    },
    "pipeline": {
      "$ref": "#/$defs/PipelineConfig"
    },
    "project": {
      "$ref": "#/$defs/ProjectConfig"
    },
    "schema_version": {
      "const": "slac.config/v0.1",
      "default": "slac.config/v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "sensors": {
      "additionalProperties": {
        "$ref": "#/$defs/SensorConfig"
      },
      "title": "Sensors",
      "type": "object"
    },
    "solver": {
      "$ref": "#/$defs/SolverConfig"
    },
    "time_offsets": {
      "additionalProperties": {
        "$ref": "#/$defs/TimeOffsetConfig"
      },
      "title": "Time Offsets",
      "type": "object"
    }
  },
  "required": [
    "dataset",
    "sensors",
    "frames"
  ],
  "title": "CalibrationConfig",
  "type": "object"
}
