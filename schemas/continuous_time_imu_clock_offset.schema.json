{
  "$defs": {
    "ClockDomainEvidence": {
      "additionalProperties": false,
      "description": "Bounds and rejected candidates; not a constrained-optimality certificate.",
      "properties": {
        "derivative_step_sec": {
          "title": "Derivative Step Sec",
          "type": "number"
        },
        "lower_sec": {
          "title": "Lower Sec",
          "type": "number"
        },
        "opposite_gradient_norm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opposite Gradient Norm"
        },
        "rejected_steps": {
          "minimum": 0,
          "title": "Rejected Steps",
          "type": "integer"
        },
        "upper_sec": {
          "title": "Upper Sec",
          "type": "number"
        }
      },
      "required": [
        "lower_sec",
        "upper_sec",
        "rejected_steps",
        "derivative_step_sec"
      ],
      "title": "ClockDomainEvidence",
      "type": "object"
    },
    "ContinuousTimeImuClockOffsetProvenance": {
      "additionalProperties": false,
      "description": "Seeded synthetic recovery lineage.",
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "generator": {
          "title": "Generator",
          "type": "string"
        },
        "generator_version": {
          "title": "Generator Version",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "generator",
        "generator_version",
        "seed"
      ],
      "title": "ContinuousTimeImuClockOffsetProvenance",
      "type": "object"
    },
    "FitDiagnostics": {
      "additionalProperties": false,
      "description": "Final-state evidence, not an observability or accuracy certificate.\n\nThe gradient is divided by each weighted Jacobian column norm and by\nmax(1, ||weighted residual||). This is invariant to independent linear\nchanges of parameter units, without adding information in weak directions.\nZero columns contribute zero (and must be assessed for observability\nseparately). The stationarity threshold is recorded with the measurement.",
      "properties": {
        "clock_domain": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClockDomainEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gradient_tolerance": {
          "exclusiveMinimum": 0,
          "title": "Gradient Tolerance",
          "type": "number"
        },
        "normalized_gradient_norm": {
          "minimum": 0,
          "title": "Normalized Gradient Norm",
          "type": "number"
        },
        "stationary": {
          "title": "Stationary",
          "type": "boolean"
        },
        "termination_reason": {
          "enum": [
            "gradient_tolerance",
            "stationarity_not_confirmed",
            "small_step",
            "small_cost_change",
            "damping_limit",
            "clock_domain_limit",
            "iteration_limit",
            "singular_system"
          ],
          "title": "Termination Reason",
          "type": "string"
        }
      },
      "required": [
        "termination_reason",
        "normalized_gradient_norm",
        "gradient_tolerance",
        "stationary"
      ],
      "title": "FitDiagnostics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Holdout and known-bad evidence for a shared IMU clock offset.",
  "properties": {
    "fit_diagnostics": {
      "anyOf": [
        {
          "$ref": "#/$defs/FitDiagnostics"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fit_status": {
      "enum": [
        "converged",
        "max_iterations",
        "singular_system",
        "stalled"
      ],
      "title": "Fit Status",
      "type": "string"
    },
    "holdout_imu_rotation_rmse_rad": {
      "minimum": 0.0,
      "title": "Holdout Imu Rotation Rmse Rad",
      "type": "number"
    },
    "holdout_measurement_count": {
      "minimum": 1,
      "title": "Holdout Measurement Count",
      "type": "integer"
    },
    "imu_clock_offset_error_sec": {
      "minimum": 0.0,
      "title": "Imu Clock Offset Error Sec",
      "type": "number"
    },
    "interpolation": {
      "const": "screw_linear",
      "title": "Interpolation",
      "type": "string"
    },
    "knot_count": {
      "minimum": 2,
      "title": "Knot Count",
      "type": "integer"
    },
    "known_bad_holdout_rmse_rad": {
      "minimum": 0.0,
      "title": "Known Bad Holdout Rmse Rad",
      "type": "number"
    },
    "known_bad_imu_clock_offset_sec": {
      "title": "Known Bad Imu Clock Offset Sec",
      "type": "number"
    },
    "known_bad_rmse_delta_rad": {
      "title": "Known Bad Rmse Delta Rad",
      "type": "number"
    },
    "max_knot_rotation_error_rad": {
      "minimum": 0.0,
      "title": "Max Knot Rotation Error Rad",
      "type": "number"
    },
    "policy_reason": {
      "title": "Policy Reason",
      "type": "string"
    },
    "policy_status": {
      "enum": [
        "pass",
        "fail"
      ],
      "title": "Policy Status",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/ContinuousTimeImuClockOffsetProvenance"
    },
    "recovery_id": {
      "title": "Recovery Id",
      "type": "string"
    },
    "schema_version": {
      "const": "slac.continuous_time_imu_clock_offset/v0.1",
      "default": "slac.continuous_time_imu_clock_offset/v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "train_imu_rotation_rmse_rad": {
      "minimum": 0.0,
      "title": "Train Imu Rotation Rmse Rad",
      "type": "number"
    },
    "train_measurement_count": {
      "minimum": 1,
      "title": "Train Measurement Count",
      "type": "integer"
    }
  },
  "required": [
    "recovery_id",
    "interpolation",
    "seed",
    "knot_count",
    "train_measurement_count",
    "holdout_measurement_count",
    "fit_status",
    "max_knot_rotation_error_rad",
    "imu_clock_offset_error_sec",
    "train_imu_rotation_rmse_rad",
    "holdout_imu_rotation_rmse_rad",
    "known_bad_holdout_rmse_rad",
    "known_bad_rmse_delta_rad",
    "known_bad_imu_clock_offset_sec",
    "policy_status",
    "policy_reason",
    "provenance"
  ],
  "title": "ContinuousTimeImuClockOffsetArtifact",
  "type": "object"
}
