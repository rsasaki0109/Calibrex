{
  "$defs": {
    "CaptureAction": {
      "additionalProperties": false,
      "description": "Actionable remediation or evidence-collection step.",
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "command": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "priority": {
          "default": "required",
          "enum": [
            "required",
            "recommended",
            "informational"
          ],
          "title": "Priority",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        }
      },
      "required": [
        "action_id",
        "message"
      ],
      "title": "CaptureAction",
      "type": "object"
    },
    "CaptureCheck": {
      "additionalProperties": false,
      "description": "One deterministic readiness check and its reason.",
      "properties": {
        "action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "observed": {
          "additionalProperties": true,
          "title": "Observed",
          "type": "object"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "status",
        "subject",
        "reason"
      ],
      "title": "CaptureCheck",
      "type": "object"
    },
    "CaptureManifestProvenance": {
