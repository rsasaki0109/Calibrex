{
  "$defs": {
    "DepthCameraIntrinsics": {
      "additionalProperties": false,
      "description": "Camera intrinsics aligned with the depth grid.",
      "properties": {
        "alpha": {
          "anyOf": [
            {
              "exclusiveMaximum": 1.0,
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alpha"
        },
        "cx": {
          "title": "Cx",
          "type": "number"
        },
        "cy": {
          "title": "Cy",
          "type": "number"
        },
        "distortion": {
          "items": {
            "type": "number"
          },
          "title": "Distortion",
          "type": "array"
        },
        "distortion_model": {
          "default": "none",
          "title": "Distortion Model",
          "type": "string"
        },
        "fx": {
          "exclusiveMinimum": 0.0,
          "title": "Fx",
          "type": "number"
        },
        "fy": {
          "exclusiveMinimum": 0.0,
          "title": "Fy",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "projection": {
          "default": "pinhole",
          "enum": [
            "pinhole",
            "double_sphere",
            "mei"
          ],
          "title": "Projection",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "xi": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xi"
        }
      },
      "required": [
        "width",
        "height",
        "fx",
        "fy",
        "cx",
        "cy"
      ],
      "title": "DepthCameraIntrinsics",
      "type": "object"
    },
    "DepthFileReference": {
      "additionalProperties": false,
      "description": "Content-addressed depth-provider input or output file.",
      "properties": {
        "encoding": {
          "title": "Encoding",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "encoding"
      ],
      "title": "DepthFileReference",
      "type": "object"
    },
    "DepthImageTransform": {
      "additionalProperties": false,
      "description": "Declared mapping from the source image grid to the depth grid.",
      "properties": {
        "crop_left_px": {
          "default": 0.0,
          "title": "Crop Left Px",
          "type": "number"
        },
        "crop_top_px": {
          "default": 0.0,
          "title": "Crop Top Px",
          "type": "number"
        },
        "interpolation": {
          "title": "Interpolation",
          "type": "string"
        },
        "output_height": {
          "exclusiveMinimum": 1,
          "title": "Output Height",
          "type": "integer"
        },
        "output_width": {
          "exclusiveMinimum": 1,
          "title": "Output Width",
          "type": "integer"
        },
        "scale_x": {
          "exclusiveMinimum": 0.0,
          "title": "Scale X",
          "type": "number"
        },
        "scale_y": {
          "exclusiveMinimum": 0.0,
          "title": "Scale Y",
          "type": "number"
        },
        "source_height": {
          "exclusiveMinimum": 1,
          "title": "Source Height",
          "type": "integer"
        },
        "source_width": {
          "exclusiveMinimum": 1,
          "title": "Source Width",
          "type": "integer"
        }
      },
      "required": [
        "source_width",
        "source_height",
        "output_width",
        "output_height",
        "scale_x",
        "scale_y",
        "interpolation"
      ],
      "title": "DepthImageTransform",
      "type": "object"
    },
    "DepthMapObservation": {
      "additionalProperties": false,
      "description": "One synchronized, digest-pinned camera depth observation.",
      "properties": {
        "capture_time_ns": {
          "title": "Capture Time Ns",
          "type": "integer"
        },
        "depth": {
          "$ref": "#/$defs/DepthFileReference"
        },
        "frame_id": {
          "title": "Frame Id",
          "type": "string"
        },
        "image": {
          "$ref": "#/$defs/DepthFileReference"
        },
        "image_transform": {
          "$ref": "#/$defs/DepthImageTransform"
        },
        "intrinsics": {
          "$ref": "#/$defs/DepthCameraIntrinsics"
        },
        "invalid_values": {
          "items": {
            "type": "number"
          },
          "title": "Invalid Values",
          "type": "array"
        },
        "scale_convention": {
          "enum": [
            "metric_z",
            "metric_range",
            "relative_depth",
            "disparity"
          ],
          "title": "Scale Convention",
          "type": "string"
        },
        "scale_to_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scale To M"
        },
        "source_frame": {
          "title": "Source Frame",
          "type": "string"
        },
        "uncertainty": {
          "anyOf": [
            {
              "$ref": "#/$defs/DepthFileReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "valid_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Valid Fraction",
          "type": "number"
        }
      },
      "required": [
        "frame_id",
        "capture_time_ns",
        "source_frame",
        "image",
        "depth",
        "intrinsics",
        "image_transform",
        "scale_convention",
        "valid_fraction"
      ],
      "title": "DepthMapObservation",
      "type": "object"
    },
    "DepthPreprocessingStep": {
      "additionalProperties": false,
      "description": "Ordered provider preprocessing/postprocessing operation.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "title": "DepthPreprocessingStep",
      "type": "object"
    },
    "DepthProviderEnvironment": {
      "additionalProperties": false,
      "description": "Pinned external environment used to produce depth maps.",
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "container_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Digest"
        },
        "dependencies": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "object"
        },
        "device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device"
        },
        "execution_mode": {
          "enum": [
            "subprocess",
            "container",
            "imported"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "python_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Python Version"
        }
      },
      "required": [
        "execution_mode"
      ],
      "title": "DepthProviderEnvironment",
      "type": "object"
    },
    "DepthProviderIdentity": {
      "additionalProperties": false,
      "description": "Model/provider identity and redistribution boundary.",
      "properties": {
        "checkpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/DepthFileReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "checkpoint_redistribution": {
          "title": "Checkpoint Redistribution",
          "type": "string"
        },
        "license_spdx": {
          "title": "License Spdx",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "source_commit": {
          "title": "Source Commit",
          "type": "string"
        },
        "source_repository": {
          "title": "Source Repository",
          "type": "string"
        },
        "training": {
          "anyOf": [
            {
              "$ref": "#/$defs/DepthProviderTrainingDeclaration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "version",
        "source_repository",
        "source_commit",
        "license_spdx",
        "checkpoint_redistribution"
      ],
      "title": "DepthProviderIdentity",
      "type": "object"
    },
    "DepthProviderProvenance": {
      "additionalProperties": false,
      "description": "Provenance of the generated provider artifact.",
      "properties": {
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "generator": {
          "title": "Generator",
          "type": "string"
        },
        "generator_version": {
          "title": "Generator Version",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "input_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Manifest Sha256",
          "type": "string"
        },
        "output_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Manifest Sha256",
          "type": "string"
        }
      },
      "required": [
        "generator",
        "generator_version",
        "input_manifest_sha256",
        "output_manifest_sha256"
      ],
      "title": "DepthProviderProvenance",
      "type": "object"
    },
    "DepthProviderTrainingDeclaration": {
      "additionalProperties": false,
      "description": "Declared relationship between provider training data and evaluation.",
      "properties": {
        "evaluation_overlap": {
          "enum": [
            "none",
            "possible",
            "confirmed",
            "unknown"
          ],
          "title": "Evaluation Overlap",
          "type": "string"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        },
        "test_data_used_for_online_refinement": {
          "title": "Test Data Used For Online Refinement",
          "type": "boolean"
        },
        "training_dataset": {
          "title": "Training Dataset",
          "type": "string"
        },
        "training_split": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Split"
        }
      },
      "required": [
        "training_dataset",
        "evaluation_overlap",
        "test_data_used_for_online_refinement",
        "evidence"
      ],
      "title": "DepthProviderTrainingDeclaration",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema-valid manifest for externally generated or imported depth maps.",
  "properties": {
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "environment": {
      "$ref": "#/$defs/DepthProviderEnvironment"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/DepthMapObservation"
      },
      "minItems": 1,
      "title": "Observations",
      "type": "array"
    },
    "preprocessing": {
      "items": {
        "$ref": "#/$defs/DepthPreprocessingStep"
      },
      "title": "Preprocessing",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/DepthProviderProvenance"
    },
    "provider": {
      "$ref": "#/$defs/DepthProviderIdentity"
    },
    "scale_convention": {
      "enum": [
        "metric_z",
        "metric_range",
        "relative_depth",
        "disparity"
      ],
      "title": "Scale Convention",
      "type": "string"
    },
    "schema_version": {
      "const": "slac.depth_provider/v0.1",
      "default": "slac.depth_provider/v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "artifact_id",
    "provider",
    "environment",
    "scale_convention",
    "observations",
    "provenance"
  ],
  "title": "DepthProviderArtifact",
  "type": "object"
}
