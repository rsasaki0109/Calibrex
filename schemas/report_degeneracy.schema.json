      "$ref": "#/$defs/DegeneracyResult"
    },
    "metrics": {
      "additionalProperties": {
        "$ref": "#/$defs/MetricResult"
      },
      "title": "Metrics",
      "type": "object"
    },
    "quality_warnings": {
      "items": {
        "type": "string"
      },
      "title": "Quality Warnings",
      "type": "array"
    },
    "recommendations": {
      "items": {
        "type": "string"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "run": {
      "$ref": "#/$defs/ReportRunInfo"
    },
    "schema_version": {
      "const": "calibrex.report.degeneracy/v0.1",
      "default": "calibrex.report.degeneracy/v0.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run",
    "degeneracy"
  ],
  "title": "ReportDegeneracyArtifact",
  "type": "object"
