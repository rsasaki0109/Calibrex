        },
        "sensors": {
          "items": {
            "type": "string"
          },
          "title": "Sensors",
          "type": "array"
        },
        "status": {
          "enum": [
            "planned",
            "skipped",
            "pass",
            "warn",
            "fail",
            "inconclusive"
          ],
