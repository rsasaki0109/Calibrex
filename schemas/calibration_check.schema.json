{
  "$defs": {
    "CheckAxisJudgement": {
      "additionalProperties": false,
      "description": "One judged axis: candidate error against the estimator's value and uncertainty.\n\n``candidate_error`` is candidate minus estimate: for a rotation axis the\ncomponent of the small rotation ``R_candidate R_estimate^T`` about the axes\nof the compared transform's parent frame (degrees, the convention the\nestimator reports its standard deviation in); for a translation axis the\ndifference of the translation components (metres).\n\n``tolerance = max(sigma_k * std, floor)``. ``status`` is ``pass`` when\n``|candidate_error| <= tolerance``, ``fail`` when it exceeds twice the\ntolerance, else ``warn``.\n\n``detectable_error`` is ``tolerance + |candidate_error|``: a deliberate\nerror larger than this on this axis, of either sign, would have pushed\n``|candidate_error|`` beyond ``tolerance`` and been flagged. It is derived\nfrom the candidate error and uncertainty at hand; no solve is repeated.\n``detects_perturbation`` says whether the probe of\n``detection_probe`` (degrees, rotation axes only) is below that bound.",
      "properties": {
        "candidate_error": {
          "title": "Candidate Error",
          "type": "number"
        },
        "detectable_error": {
          "minimum": 0.0,
          "title": "Detectable Error",
          "type": "number"
        },
        "detection_probe": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detection Probe"
        },
        "detects_perturbation": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detects Perturbation"
        },
        "estimate_std": {
          "minimum": 0.0,
          "title": "Estimate Std",
          "type": "number"
        },
        "name": {
          "enum": [
            "roll",
            "pitch",
            "yaw",
            "x",
            "y",
            "z"
          ],
          "title": "Name",
          "type": "string"
        },
        "ratio": {
          "description": "abs(candidate_error) / tolerance",
          "minimum": 0.0,
          "title": "Ratio",
          "type": "number"
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "title": "Status",
          "type": "string"
        },
        "tolerance": {
          "exclusiveMinimum": 0.0,
          "title": "Tolerance",
          "type": "number"
        },
        "tolerance_source": {
          "enum": [
            "sigma",
            "floor"
          ],
          "title": "Tolerance Source",
          "type": "string"
        },
        "unit": {
          "enum": [
            "deg",
            "m"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "name",
        "unit",
        "candidate_error",
        "estimate_std",
        "tolerance",
        "tolerance_source",
        "ratio",
        "status",
        "detectable_error"
      ],
      "title": "CheckAxisJudgement",
      "type": "object"
    },
    "CheckBagInput": {
      "additionalProperties": false,
      "description": "The bag that was audited.\n\nThe digest follows the repository precedent for tens-of-gigabyte bags:\n``metadata.yaml`` in full, and each storage file by name, size and first\n64 MiB (see ``input_digest_scope``).",
      "properties": {
        "input_digest_scope": {
          "title": "Input Digest Scope",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "storage_identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Storage Identifier"
        },
        "topic_count": {
          "minimum": 0,
          "title": "Topic Count",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "topic_count",
        "input_sha256",
        "input_digest_scope"
      ],
      "title": "CheckBagInput",
      "type": "object"
    },
    "CheckCandidateSource": {
      "additionalProperties": false,
      "description": "One origin of candidate extrinsics.",
      "properties": {
        "frame_count": {
          "minimum": 0,
          "title": "Frame Count",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "bag_tf_static",
            "urdf",
            "frames_yaml",
            "kalibr_camchain",
            "rtk_slam_calib",
            "hilti_sensors"
          ],
          "title": "Kind",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "kind",
        "frame_count"
      ],
      "title": "CheckCandidateSource",
      "type": "object"
    },
    "CheckClosure": {
      "additionalProperties": false,
      "description": "One independent loop of the estimate graph: the product around it should be identity.\n\n``kind`` is ``parallel`` for two estimates of the same frame pair and\n``cycle`` for a longer loop. ``axes`` are judged with the verdict rule of\nthe pairs (``tolerance = max(sigma_k * std, floor)``, fail beyond twice the\ntolerance); a rotation axis is the small rotation about the axes of\n``frames[0]`` (degrees), a translation axis the translation of the loop\nproduct in ``frames[0]`` (metres). ``estimate_std`` is the first-order\npropagation of the members' standard deviations assuming independent\nmembers. ``candidate_error`` of an axis is the loop error (not a\ncandidate-minus-estimate error: a closure involves no candidate).",
      "properties": {
        "axes": {
          "items": {
            "$ref": "#/$defs/CheckAxisJudgement"
          },
          "title": "Axes",
          "type": "array"
        },
        "frames": {
          "description": "the loop's frames in order; the first is its origin",
          "items": {
            "type": "string"
          },
          "title": "Frames",
          "type": "array"
        },
        "kind": {
          "enum": [
            "parallel",
            "cycle"
          ],
          "title": "Kind",
          "type": "string"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/CheckClosureMember"
          },
          "title": "Members",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "unchecked_axes": {
          "items": {
            "$ref": "#/$defs/CheckUncheckedAxis"
          },
          "title": "Unchecked Axes",
          "type": "array"
        },
        "verdict": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "inconclusive"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "frames",
        "members",
        "verdict"
      ],
      "title": "CheckClosure",
      "type": "object"
    },
    "CheckClosureEdge": {
      "additionalProperties": false,
      "description": "One pair estimate considered for the closure graph.",
      "properties": {
        "child_frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Child Frame"
        },
        "pair": {
          "enum": [
            "imu-lidar",
            "lidar-lidar",
            "camera-imu",
            "camera-focal",
            "gnss-lidar",
            "gnss-imu",
            "lidar-vehicle",
            "imu-vehicle",
            "ins-lidar",
            "lidar-wheel_odometry"
          ],
          "title": "Pair",
          "type": "string"
        },
        "parent_frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Frame"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "why a derived or unusable estimate is not in any loop",
          "title": "Reason"
        },
        "role": {
          "enum": [
            "independent",
            "derived",
            "unusable"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "pair",
        "role"
      ],
      "title": "CheckClosureEdge",
      "type": "object"
    },
    "CheckClosureMember": {
      "additionalProperties": false,
      "description": "One estimate traversed by a closure loop.",
      "properties": {
        "child_frame": {
          "title": "Child Frame",
          "type": "string"
        },
        "direction": {
          "description": "forward: the loop goes parent to child (multiplies T_parent_child); reverse: child to parent (multiplies its inverse)",
          "enum": [
            "forward",
            "reverse"
          ],
          "title": "Direction",
          "type": "string"
        },
        "estimator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimator"
        },
        "pair": {
          "enum": [
            "imu-lidar",
            "lidar-lidar",
            "camera-imu",
            "camera-focal",
            "gnss-lidar",
            "gnss-imu",
            "lidar-vehicle",
            "imu-vehicle",
            "ins-lidar",
            "lidar-wheel_odometry"
          ],
          "title": "Pair",
          "type": "string"
        },
        "parent_frame": {
          "title": "Parent Frame",
          "type": "string"
        }
      },
      "required": [
        "pair",
        "parent_frame",
        "child_frame",
        "direction"
      ],
      "title": "CheckClosureMember",
      "type": "object"
    },
    "CheckClosureReport": {
      "additionalProperties": false,
      "description": "Consistency of the independent estimates of one run with each other.\n\nEdges are the run's per-pair estimates (not the candidate); estimates that\nare composed from other pairs' results are ``derived`` and excluded, since\nthey are not independent evidence. ``loops`` are a fundamental cycle basis\nof the remaining graph. A loop that fails says the estimators disagree\nwith each other, so their verdicts on the candidate are less trustworthy;\nit contains no information about the candidate itself.",
      "properties": {
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/CheckClosureEdge"
          },
          "title": "Edges",
          "type": "array"
        },
        "loops": {
          "items": {
            "$ref": "#/$defs/CheckClosure"
          },
          "title": "Loops",
          "type": "array"
        },
        "verdict": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "worst loop verdict (fail > warn > inconclusive > pass); absent without loops",
          "title": "Verdict"
        }
      },
      "title": "CheckClosureReport",
      "type": "object"
    },
    "CheckEvidenceRef": {
      "additionalProperties": false,
      "description": "One estimator artifact written next to the check artifact.",
      "properties": {
        "from_cache": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "true when the estimator artifact was read from the estimator cache instead of being recomputed; absent when the estimator is not cached",
          "title": "From Cache"
        },
        "path": {
          "description": "relative to the check artifact's directory",
          "title": "Path",
          "type": "string"
        },
        "policy_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Status"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "schema_version",
        "role"
      ],
      "title": "CheckEvidenceRef",
      "type": "object"
    },
    "CheckFocalComponent": {
      "additionalProperties": false,
      "description": "One judged focal length: the deployed value against the gyro-implied one.\n\n``scale = estimate / candidate`` (the camera/gyro rate ratio the estimator\nmeasures with features normalized by the candidate focal length) and\n``scale_error = scale - 1``. ``tolerance = max(sigma_k * scale_std, floor)``\nwith the focal-scale floor; ``status`` is ``pass`` when\n``|scale_error| <= tolerance``, ``fail`` beyond twice the tolerance, else\n``warn``. ``detectable_error = tolerance + |scale_error|`` is the smallest\nrelative focal-length error the run would have flagged (no re-solve);\n``detects_perturbation`` says whether ``detection_probe`` (a relative\nerror, 0.01 = 1 %) is above it.",
      "properties": {
        "candidate_px": {
          "exclusiveMinimum": 0.0,
          "title": "Candidate Px",
          "type": "number"
        },
        "detectable_error": {
          "minimum": 0.0,
          "title": "Detectable Error",
          "type": "number"
        },
        "detection_probe": {
          "exclusiveMinimum": 0.0,
          "title": "Detection Probe",
          "type": "number"
        },
        "detects_perturbation": {
          "title": "Detects Perturbation",
          "type": "boolean"
        },
        "estimate_px": {
          "exclusiveMinimum": 0.0,
          "title": "Estimate Px",
          "type": "number"
        },
        "estimate_std_px": {
          "minimum": 0.0,
          "title": "Estimate Std Px",
          "type": "number"
        },
        "name": {
          "enum": [
            "fx",
            "fy"
          ],
          "title": "Name",
          "type": "string"
        },
        "ratio": {
          "description": "abs(scale_error) / tolerance",
          "minimum": 0.0,
          "title": "Ratio",
          "type": "number"
        },
        "scale": {
          "exclusiveMinimum": 0.0,
          "title": "Scale",
          "type": "number"
        },
        "scale_error": {
          "title": "Scale Error",
          "type": "number"
        },
        "scale_std": {
          "minimum": 0.0,
          "title": "Scale Std",
          "type": "number"
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "title": "Status",
          "type": "string"
        },
        "tolerance": {
          "exclusiveMinimum": 0.0,
          "title": "Tolerance",
          "type": "number"
        },
        "tolerance_source": {
          "enum": [
            "sigma",
            "floor"
          ],
          "title": "Tolerance Source",
          "type": "string"
        }
      },
      "required": [
        "name",
        "candidate_px",
        "estimate_px",
        "estimate_std_px",
        "scale",
        "scale_std",
        "scale_error",
        "tolerance",
        "tolerance_source",
        "ratio",
        "status",
        "detectable_error",
        "detection_probe",
        "detects_perturbation"
      ],
      "title": "CheckFocalComponent",
      "type": "object"
    },
    "CheckFocalScale": {
      "additionalProperties": false,
      "description": "Intrinsics record of ``camera-focal``: focal lengths judged as a scale of the candidate.\n\ncamera-focal checks the deployed intrinsics, not an extrinsic, so it has no\nper-axis rotation or translation judgements; this record holds its\njudgements instead. The optical-axis ratio is the estimator's control (it\ndoes not depend on the focal length and should be 1).",
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/CheckFocalComponent"
          },
          "title": "Components",
          "type": "array"
        },
        "floor": {
          "description": "focal-scale floor of the tolerance (relative)",
          "exclusiveMinimum": 0.0,
          "title": "Floor",
          "type": "number"
        },
        "intrinsics_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "where the deployed focal lengths came from",
          "title": "Intrinsics Source"
        },
        "optical_axis_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Optical Axis Ratio"
        },
        "optical_axis_ratio_std": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Optical Axis Ratio Std"
        },
        "unchecked": {
          "items": {
            "$ref": "#/$defs/CheckUncheckedFocal"
          },
          "title": "Unchecked",
          "type": "array"
        }
      },
      "required": [
        "floor"
      ],
      "title": "CheckFocalScale",
      "type": "object"
    },
    "CheckFrameEdge": {
      "additionalProperties": false,
      "description": "One static edge of the candidate tree.",
      "properties": {
        "source": {
          "enum": [
            "bag_tf_static",
            "urdf",
            "frames_yaml",
            "kalibr_camchain",
            "rtk_slam_calib",
            "hilti_sensors"
          ],
          "title": "Source",
          "type": "string"
        },
        "transform": {
          "$ref": "#/$defs/CheckTransform"
        }
      },
      "required": [
        "transform",
        "source"
      ],
      "title": "CheckFrameEdge",
      "type": "object"
    },
    "CheckFrameTree": {
      "additionalProperties": false,
      "description": "The candidate static tree (a forest when several roots exist).",
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/CheckFrameEdge"
          },
          "title": "Edges",
          "type": "array"
        },
        "frames": {
          "items": {
            "type": "string"
          },
          "title": "Frames",
          "type": "array"
        },
        "overrides": {
          "items": {
            "type": "string"
          },
          "title": "Overrides",
          "type": "array"
        },
        "roots": {
          "items": {
            "type": "string"
          },
          "title": "Roots",
          "type": "array"
        }
      },
      "title": "CheckFrameTree",
      "type": "object"
    },
    "CheckOptions": {
      "additionalProperties": false,
      "description": "Verdict thresholds and runtime controls used for a run.",
      "properties": {
        "acceleration_unit": {
          "default": "mps2",
          "enum": [
            "mps2",
            "g"
          ],
          "title": "Acceleration Unit",
          "type": "string"
        },
        "camera": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Camera"
        },
        "detection_probe_deg": {
          "exclusiveMinimum": 0.0,
          "title": "Detection Probe Deg",
          "type": "number"
        },
        "focal_scale_floor": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "relative floor of the camera-focal tolerance (0.005 = 0.5 %); absent in artifacts that predate camera-focal",
          "title": "Focal Scale Floor"
        },
        "gnss_lidar_deskew": {
          "anyOf": [
            {
              "enum": [
                "auto",
                "constant_velocity",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "gnss-lidar deskew selection (LiDAR odometry): auto uses the per-point time field when the cloud has one and rigid scans otherwise",
          "title": "Gnss Lidar Deskew"
        },
        "gnss_max_duration_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "seconds analysed by the GNSS pairs when --gnss-max-duration-s was given; absent means they use max_duration_s",
          "title": "Gnss Max Duration S"
        },
        "imu_lidar_deskew": {
          "anyOf": [
            {
              "enum": [
                "auto",
                "gyro",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "imu-lidar deskew selection: auto uses the per-point time field when the cloud has one and rigid scans otherwise; absent in artifacts that predate the option",
          "title": "Imu Lidar Deskew"
        },
        "imu_lidar_translation": {
          "default": true,
          "title": "Imu Lidar Translation",
          "type": "boolean"
        },
        "lidar_lidar_deskew": {
          "anyOf": [
            {
              "enum": [
                "auto",
                "constant_velocity",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lidar-lidar deskew selection (reference odometry): auto uses the per-point time field when the reference cloud has one and rigid scans otherwise",
          "title": "Lidar Lidar Deskew"
        },
        "max_duration_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Duration S"
        },
        "pairs": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pairs"
        },
        "rigid_scan_rotation_floor_deg": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "rotation floor applied to imu-lidar axes judged on rigid scans (deskew none)",
          "title": "Rigid Scan Rotation Floor Deg"
        },
        "rotation_floor_deg": {
          "exclusiveMinimum": 0.0,
          "title": "Rotation Floor Deg",
          "type": "number"
        },
        "sigma_k": {
          "exclusiveMinimum": 0.0,
          "title": "Sigma K",
          "type": "number"
        },
        "topic_kinds": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "--topic-kind overrides: odometry/twist topic -> wheel or ins",
          "title": "Topic Kinds",
          "type": "object"
        },
        "translation_floor_m": {
