{
  "$defs": {
    "CheckAxisJudgement": {
      "additionalProperties": false,
      "description": "One judged axis: candidate error against the estimator's value and uncertainty.\n\n``candidate_error`` is candidate minus estimate: for a rotation axis the\ncomponent of the small rotation ``R_candidate R_estimate^T`` about the axes\nof the compared transform's parent frame (degrees, the convention the\nestimator reports its standard deviation in); for a translation axis the\ndifference of the translation components (metres).\n\n``tolerance = max(sigma_k * std, floor)``. ``status`` is ``pass`` when\n``|candidate_error| <= tolerance``, ``fail`` when it exceeds twice the\ntolerance, else ``warn``.\n\n``detectable_error`` is ``tolerance + |candidate_error|``: a deliberate\nerror larger than this on this axis, of either sign, would have pushed\n``|candidate_error|`` beyond ``tolerance`` and been flagged. It is derived\nfrom the candidate error and uncertainty at hand; no solve is repeated.\n``detects_perturbation`` says whether the probe of\n``detection_probe`` (degrees, rotation axes only) is below that bound.",
      "properties": {
        "candidate_error": {
          "title": "Candidate Error",
          "type": "number"
        },
        "detectable_error": {
          "minimum": 0.0,
          "title": "Detectable Error",
          "type": "number"
        },
        "detection_probe": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detection Probe"
        },
        "detects_perturbation": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detects Perturbation"
        },
        "estimate_std": {
          "minimum": 0.0,
          "title": "Estimate Std",
          "type": "number"
        },
        "name": {
          "enum": [
            "roll",
            "pitch",
            "yaw",
            "x",
            "y",
            "z"
          ],
          "title": "Name",
          "type": "string"
        },
        "ratio": {
          "description": "abs(candidate_error) / tolerance",
          "minimum": 0.0,
          "title": "Ratio",
          "type": "number"
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "title": "Status",
          "type": "string"
        },
        "tolerance": {
          "exclusiveMinimum": 0.0,
          "title": "Tolerance",
          "type": "number"
        },
        "tolerance_source": {
          "enum": [
            "sigma",
            "floor"
          ],
          "title": "Tolerance Source",
          "type": "string"
        },
        "unit": {
          "enum": [
            "deg",
            "m"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "name",
        "unit",
        "candidate_error",
        "estimate_std",
        "tolerance",
        "tolerance_source",
        "ratio",
        "status",
        "detectable_error"
      ],
      "title": "CheckAxisJudgement",
      "type": "object"
    },
    "CheckBagInput": {
      "additionalProperties": false,
      "description": "The bag that was audited.\n\nThe digest follows the repository precedent for tens-of-gigabyte bags:\n``metadata.yaml`` in full, and each storage file by name, size and first\n64 MiB (see ``input_digest_scope``).",
      "properties": {
        "input_digest_scope": {
          "title": "Input Digest Scope",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "storage_identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Storage Identifier"
        },
        "topic_count": {
          "minimum": 0,
          "title": "Topic Count",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "topic_count",
        "input_sha256",
        "input_digest_scope"
      ],
      "title": "CheckBagInput",
      "type": "object"
    },
    "CheckCandidateSource": {
      "additionalProperties": false,
      "description": "One origin of candidate extrinsics.",
      "properties": {
        "frame_count": {
          "minimum": 0,
          "title": "Frame Count",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "bag_tf_static",
            "urdf",
            "frames_yaml",
            "kalibr_camchain",
            "rtk_slam_calib",
            "hilti_sensors"
          ],
          "title": "Kind",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "kind",
        "frame_count"
      ],
      "title": "CheckCandidateSource",
      "type": "object"
    },
    "CheckEvidenceRef": {
      "additionalProperties": false,
      "description": "One estimator artifact written next to the check artifact.",
      "properties": {
        "path": {
          "description": "relative to the check artifact's directory",
          "title": "Path",
          "type": "string"
        },
        "policy_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Status"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "schema_version",
        "role"
      ],
      "title": "CheckEvidenceRef",
      "type": "object"
    },
    "CheckFrameEdge": {
      "additionalProperties": false,
      "description": "One static edge of the candidate tree.",
      "properties": {
        "source": {
          "enum": [
            "bag_tf_static",
            "urdf",
            "frames_yaml",
            "kalibr_camchain",
            "rtk_slam_calib",
            "hilti_sensors"
          ],
          "title": "Source",
          "type": "string"
        },
        "transform": {
          "$ref": "#/$defs/CheckTransform"
        }
      },
      "required": [
        "transform",
        "source"
      ],
      "title": "CheckFrameEdge",
      "type": "object"
    },
    "CheckFrameTree": {
      "additionalProperties": false,
      "description": "The candidate static tree (a forest when several roots exist).",
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/CheckFrameEdge"
          },
          "title": "Edges",
          "type": "array"
        },
        "frames": {
          "items": {
            "type": "string"
          },
          "title": "Frames",
          "type": "array"
        },
        "overrides": {
          "items": {
            "type": "string"
          },
          "title": "Overrides",
          "type": "array"
        },
        "roots": {
          "items": {
            "type": "string"
          },
          "title": "Roots",
          "type": "array"
        }
      },
      "title": "CheckFrameTree",
      "type": "object"
    },
    "CheckOptions": {
      "additionalProperties": false,
      "description": "Verdict thresholds and runtime controls used for a run.",
      "properties": {
        "acceleration_unit": {
          "default": "mps2",
          "enum": [
            "mps2",
            "g"
          ],
          "title": "Acceleration Unit",
          "type": "string"
        },
        "camera": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Camera"
        },
        "detection_probe_deg": {
          "exclusiveMinimum": 0.0,
          "title": "Detection Probe Deg",
          "type": "number"
        },
        "imu_lidar_translation": {
          "default": true,
          "title": "Imu Lidar Translation",
          "type": "boolean"
        },
        "max_duration_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Duration S"
        },
        "pairs": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pairs"
        },
        "rotation_floor_deg": {
          "exclusiveMinimum": 0.0,
          "title": "Rotation Floor Deg",
          "type": "number"
        },
        "sigma_k": {
          "exclusiveMinimum": 0.0,
          "title": "Sigma K",
          "type": "number"
        },
        "translation_floor_m": {
          "exclusiveMinimum": 0.0,
          "title": "Translation Floor M",
          "type": "number"
        }
      },
      "required": [
        "sigma_k",
        "rotation_floor_deg",
        "translation_floor_m",
        "detection_probe_deg"
      ],
      "title": "CheckOptions",
      "type": "object"
    },
    "CheckPairRecord": {
      "additionalProperties": false,
      "description": "One candidate sensor pair and what was decided for it.",
      "properties": {
        "axes": {
          "items": {
            "$ref": "#/$defs/CheckAxisJudgement"
          },
          "title": "Axes",
          "type": "array"
        },
        "candidate_transform": {
          "anyOf": [
            {
              "$ref": "#/$defs/CheckTransform"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "compared_transform": {
          "anyOf": [
            {
              "$ref": "#/$defs/CheckTransform"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the candidate in the estimator's convention (for example T_lidar_imu for imu-lidar); axes are those of its parent frame"
        },
        "estimator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimator"
        },
        "estimator_policy_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Estimator Policy Reasons",
          "type": "array"
        },
        "estimator_policy_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimator Policy Status"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/CheckEvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "evidence_artifact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Artifact"
        },
        "frames": {
          "items": {
            "type": "string"
          },
          "title": "Frames",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "pair": {
          "enum": [
            "imu-lidar",
            "lidar-lidar",
            "camera-imu",
            "camera-focal",
            "gnss-lidar",
            "gnss-imu",
            "lidar-vehicle",
            "imu-vehicle",
            "ins-lidar",
            "lidar-wheel_odometry"
          ],
          "title": "Pair",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "missing_topic",
                "frame_not_in_tree",
                "frames_not_connected",
                "no_candidate_calibration",
                "no_vehicle_frame",
                "method_not_wired",
                "not_selected",
                "unsupported_sensor",
                "missing_intrinsics",
                "missing_dependency",
                "estimator_error",
                "estimator_failed",
                "no_judgeable_axes"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "runtime_s": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime S"
        },
        "sensors": {
          "items": {
            "type": "string"
          },
          "title": "Sensors",
          "type": "array"
        },
        "status": {
          "enum": [
            "planned",
            "skipped",
            "pass",
            "warn",
            "fail",
            "inconclusive"
          ],
          "title": "Status",
          "type": "string"
        },
        "time_offset": {
          "anyOf": [
            {
              "$ref": "#/$defs/CheckTimeOffset"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "topics": {
          "items": {
            "type": "string"
          },
          "title": "Topics",
          "type": "array"
        },
        "unchecked_axes": {
          "items": {
            "$ref": "#/$defs/CheckUncheckedAxis"
          },
          "title": "Unchecked Axes",
          "type": "array"
        },
        "verdict": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verdict"
        }
      },
      "required": [
        "pair",
        "status"
      ],
      "title": "CheckPairRecord",
      "type": "object"
    },
    "CheckProvenance": {
      "additionalProperties": false,
      "description": "Generator lineage and input digests.",
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "generator": {
          "title": "Generator",
          "type": "string"
        },
        "generator_version": {
          "title": "Generator Version",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "input_digest_scope": {
          "title": "Input Digest Scope",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "generator",
        "generator_version",
        "input_sha256",
        "input_digest_scope",
        "created_at"
      ],
      "title": "CheckProvenance",
      "type": "object"
    },
    "CheckSummary": {
      "additionalProperties": false,
      "description": "Counts derived from the pair records.",
      "properties": {
        "pair_count": {
          "minimum": 0,
          "title": "Pair Count",
          "type": "integer"
        },
        "runnable_count": {
          "minimum": 0,
          "title": "Runnable Count",
          "type": "integer"
        },
        "skipped_by_reason": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Skipped By Reason",
          "type": "object"
        },
        "status_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Status Counts",
          "type": "object"
        }
      },
      "required": [
        "pair_count",
        "runnable_count"
      ],
      "title": "CheckSummary",
      "type": "object"
    },
    "CheckTimeOffset": {
      "additionalProperties": false,
      "description": "The estimator's clock offset; reported, not judged.",
      "properties": {
        "estimate_s": {
          "title": "Estimate S",
          "type": "number"
        },
        "note": {
          "default": "reported only; not judged",
          "title": "Note",
          "type": "string"
        },
        "status": {
          "enum": [
            "estimated",
            "unobservable"
          ],
          "title": "Status",
          "type": "string"
        },
        "std_s": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Std S"
        }
      },
      "required": [
        "estimate_s",
        "status"
      ],
      "title": "CheckTimeOffset",
      "type": "object"
    },
    "CheckTopicRecord": {
      "additionalProperties": false,
      "description": "One bag topic, its role and the tree frame it maps to.",
      "properties": {
        "frame_source": {
          "anyOf": [
            {
              "enum": [
                "override",
                "header",
                "source_topic_hint",
                "role_default"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Source"
        },
        "header_frame_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header Frame Id"
        },
        "mapped_frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mapped Frame"
        },
        "message_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message Count"
        },
        "message_type": {
          "title": "Message Type",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "odometry_kind": {
          "anyOf": [
            {
              "enum": [
                "wheel",
                "ins",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Odometry Kind"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "lidar",
                "imu",
                "camera",
                "gnss",
                "odometry",
                "twist",
                "tf_static"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
