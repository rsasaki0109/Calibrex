        },
        "topic": {
          "title": "Topic",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "message_type"
      ],
      "title": "CheckTopicRecord",
      "type": "object"
    },
    "CheckTransform": {
      "additionalProperties": false,
      "description": "``T_parent_child``: maps ``child_frame`` points into ``parent_frame``.",
      "properties": {
        "child_frame": {
          "title": "Child Frame",
          "type": "string"
        },
        "parent_frame": {
          "title": "Parent Frame",
          "type": "string"
        },
        "rotation_quat_xyzw": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Rotation Quat Xyzw",
          "type": "array"
        },
        "translation_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Translation M",
          "type": "array"
        }
      },
      "required": [
        "parent_frame",
        "child_frame",
        "translation_m",
        "rotation_quat_xyzw"
      ],
      "title": "CheckTransform",
      "type": "object"
    },
    "CheckUncheckedAxis": {
      "additionalProperties": false,
      "description": "An axis the estimator did not constrain, so the candidate is not judged on it.",
      "properties": {
        "name": {
          "enum": [
            "roll",
            "pitch",
            "yaw",
            "x",
            "y",
            "z"
          ],
          "title": "Name",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "std": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Std"
        },
        "unit": {
          "enum": [
            "deg",
            "m"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "name",
        "unit",
        "reason"
      ],
      "title": "CheckUncheckedAxis",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Audit plan (Phase A) and, in later phases, verdicts for a deployed calibration.",
  "properties": {
    "bag": {
      "$ref": "#/$defs/CheckBagInput"
    },
    "candidate_sources": {
      "items": {
        "$ref": "#/$defs/CheckCandidateSource"
      },
      "title": "Candidate Sources",
      "type": "array"
    },
    "evidence_dir": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "evidence directory, relative to the artifact",
      "title": "Evidence Dir"
    },
    "frame_tree": {
      "$ref": "#/$defs/CheckFrameTree"
    },
    "options": {
      "anyOf": [
        {
          "$ref": "#/$defs/CheckOptions"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "overall_verdict": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "worst verdict over the pairs that ran (fail > warn > inconclusive > pass); absent in a plan-only run; inconclusive when no pair ran",
      "title": "Overall Verdict"
    },
    "pairs": {
      "items": {
