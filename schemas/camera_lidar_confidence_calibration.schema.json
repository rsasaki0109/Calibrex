    "calibration_id": {
      "title": "Calibration Id",
      "type": "string"
    },
    "calibration_split_seeds": {
      "items": {
        "type": "integer"
      },
      "minItems": 1,
      "title": "Calibration Split Seeds",
      "type": "array"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/CameraLidarConfidenceCalibrationCandidate"
      },
      "minItems": 2,
      "title": "Candidates",
      "type": "array"
    },
    "correspondence_artifact_id": {
      "title": "Correspondence Artifact Id",
      "type": "string"
    },
    "correspondence_artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Correspondence Artifact Sha256",
      "type": "string"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "development_reprojection_inlier_threshold_px": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Development Reprojection Inlier Threshold Px"
    },
    "evaluation_dataset_ids_excluded": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evaluation Dataset Ids Excluded",
      "type": "array"
    },
    "locked_refinement_options": {
      "anyOf": [
        {
          "$ref": "#/$defs/CameraLidarLockedRefinementOptions"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "minimum_frame_correspondence_count": {
      "minimum": 1,
      "title": "Minimum Frame Correspondence Count",
      "type": "integer"
    },
    "minimum_frame_geometric_inlier_count": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minimum Frame Geometric Inlier Count"
    },
    "minimum_frame_geometric_support_rate": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minimum Frame Geometric Support Rate"
    },
    "minimum_frame_support_rate": {
      "exclusiveMinimum": 0.0,
      "maximum": 1.0,
      "title": "Minimum Frame Support Rate",
      "type": "number"
    },
    "minimum_full_rank_frame_rate": {
      "exclusiveMinimum": 0.0,
      "maximum": 1.0,
      "title": "Minimum Full Rank Frame Rate",
      "type": "number"
    },
    "minimum_geometric_inlier_rate": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minimum Geometric Inlier Rate"
    },
    "problem_id": {
      "title": "Problem Id",
      "type": "string"
    },
    "problem_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Problem Sha256",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/CameraLidarConfidenceCalibrationProvenance"
    },
    "provider": {
      "$ref": "#/$defs/CorrespondenceProviderIdentity"
    },
    "reference_pose_used_for_development_calibration": {
      "const": true,
      "default": true,
      "title": "Reference Pose Used For Development Calibration",
      "type": "boolean"
    },
    "release_sota_claim_allowed": {
      "const": false,
      "default": false,
      "title": "Release Sota Claim Allowed",
      "type": "boolean"
    },
    "runtime_holdout_used_for_pose_selection": {
      "const": false,
      "default": false,
      "title": "Runtime Holdout Used For Pose Selection",
      "type": "boolean"
    },
    "schema_version": {
      "default": "slac.camera_lidar_confidence_calibration/v0.2",
      "enum": [
        "slac.camera_lidar_confidence_calibration/v0.1",
        "slac.camera_lidar_confidence_calibration/v0.2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "selected_minimum_confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Minimum Confidence"
    },
    "selection_rule_id": {
      "default": "highest_threshold_passing_support_and_observability/v0.1",
      "enum": [
        "highest_threshold_passing_support_and_observability/v0.1",
        "highest_threshold_passing_support_observability_and_geometry/v0.2"
      ],
      "title": "Selection Rule Id",
      "type": "string"
    },
    "sequence_id": {
      "title": "Sequence Id",
      "type": "string"
    },
    "split_id": {
      "const": "development",
      "title": "Split Id",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "enum": [
            "locked",
            "rejected"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status"
    }
  },
  "required": [
    "calibration_id",
    "dataset_id",
    "sequence_id",
    "split_id",
    "problem_id",
    "problem_sha256",
    "correspondence_artifact_id",
    "correspondence_artifact_sha256",
    "provider",
    "evaluation_dataset_ids_excluded",
    "calibration_holdout_ratio",
    "calibration_split_seeds",
    "minimum_frame_correspondence_count",
    "minimum_frame_support_rate",
    "minimum_full_rank_frame_rate",
    "candidates",
    "provenance"
  ],
