{
  "$defs": {
    "CameraLidarConfidenceCalibrationCandidate": {
      "additionalProperties": false,
      "description": "Support, geometry, and observability gates for one confidence threshold.",
      "properties": {
        "accepted_correspondence_count": {
          "minimum": 0,
          "title": "Accepted Correspondence Count",
          "type": "integer"
        },
        "accepted_correspondence_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Accepted Correspondence Rate",
          "type": "number"
        },
        "aggregate_observability": {
          "$ref": "#/$defs/CameraLidarPoseObservability"
        },
        "frames_meeting_geometric_minimum_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frames Meeting Geometric Minimum Count"
        },
        "frames_meeting_geometric_minimum_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frames Meeting Geometric Minimum Rate"
        },
        "frames_meeting_minimum_count": {
          "minimum": 0,
          "title": "Frames Meeting Minimum Count",
          "type": "integer"
        },
        "frames_meeting_minimum_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Frames Meeting Minimum Rate",
          "type": "number"
        },
        "full_rank_frame_count": {
          "minimum": 0,
          "title": "Full Rank Frame Count",
          "type": "integer"
        },
        "full_rank_frame_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Full Rank Frame Rate",
          "type": "number"
        },
        "gate_pass": {
          "title": "Gate Pass",
          "type": "boolean"
        },
        "gate_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Gate Reasons",
          "type": "array"
        },
        "geometric_inlier_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Geometric Inlier Count"
        },
        "geometric_inlier_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Geometric Inlier Rate"
        },
        "minimum_confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Minimum Confidence",
          "type": "number"
        },
        "minimum_holdout_correspondence_count_across_seeds": {
          "minimum": 0,
          "title": "Minimum Holdout Correspondence Count Across Seeds",
          "type": "integer"
        },
        "minimum_holdout_geometric_inlier_count_across_seeds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Holdout Geometric Inlier Count Across Seeds"
        },
        "minimum_train_correspondence_count_across_seeds": {
          "minimum": 0,
          "title": "Minimum Train Correspondence Count Across Seeds",
          "type": "integer"
        },
        "minimum_train_geometric_inlier_count_across_seeds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Train Geometric Inlier Count Across Seeds"
        },
        "reprojection_error_px": {
          "anyOf": [
            {
              "$ref": "#/$defs/CameraLidarDistributionSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "minimum_confidence",
        "accepted_correspondence_count",
        "accepted_correspondence_rate",
        "frames_meeting_minimum_count",
        "frames_meeting_minimum_rate",
        "full_rank_frame_count",
        "full_rank_frame_rate",
        "minimum_train_correspondence_count_across_seeds",
        "minimum_holdout_correspondence_count_across_seeds",
        "aggregate_observability",
        "gate_pass"
      ],
      "title": "CameraLidarConfidenceCalibrationCandidate",
      "type": "object"
    },
    "CameraLidarConfidenceCalibrationProvenance": {
      "additionalProperties": false,
      "description": "Inputs and generator identity for a development threshold lock.",
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "generator": {
          "title": "Generator",
          "type": "string"
        },
        "generator_version": {
          "title": "Generator Version",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "source_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Source Paths",
          "type": "array"
        },
        "source_sha256": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 2,
          "title": "Source Sha256",
          "type": "object"
        }
      },
      "required": [
        "generator",
        "generator_version",
        "source_paths",
        "source_sha256"
      ],
      "title": "CameraLidarConfidenceCalibrationProvenance",
      "type": "object"
    },
    "CameraLidarDistributionSummary": {
      "additionalProperties": false,
      "description": "Deterministic scalar distribution summary.",
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean"
        },
        "median": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "p10": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P10"
        },
        "p90": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P90"
        },
        "p95": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P95"
        }
      },
      "required": [
        "count"
      ],
      "title": "CameraLidarDistributionSummary",
      "type": "object"
    },
    "CameraLidarLockedRefinementOptions": {
      "additionalProperties": false,
      "description": "Exact provider and solver thresholds frozen after development selection.",
      "properties": {
        "acceptance_policy_id": {
          "const": "initializer_preserving_fit_only/v0.1",
          "default": "initializer_preserving_fit_only/v0.1",
          "title": "Acceptance Policy Id",
          "type": "string"
        },
        "cauchy_scale": {
          "exclusiveMinimum": 0.0,
          "title": "Cauchy Scale",
          "type": "number"
        },
        "evaluation_split_seeds": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Evaluation Split Seeds",
          "type": "array"
        },
        "holdout_ratio": {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Holdout Ratio",
          "type": "number"
        },
        "initial_rotation_step_deg": {
          "exclusiveMinimum": 0.0,
          "title": "Initial Rotation Step Deg",
          "type": "number"
        },
        "initial_translation_step_m": {
          "exclusiveMinimum": 0.0,
          "title": "Initial Translation Step M",
          "type": "number"
        },
        "max_evaluations": {
          "minimum": 13,
          "title": "Max Evaluations",
          "type": "integer"
        },
        "maximum_accepted_bound_fraction": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Maximum Accepted Bound Fraction",
          "type": "number"
        },
        "maximum_train_correspondence_loss_fraction": {
          "exclusiveMaximum": 1.0,
          "minimum": 0.0,
          "title": "Maximum Train Correspondence Loss Fraction",
          "type": "number"
        },
        "minimum_absolute_train_objective_improvement": {
          "minimum": 0.0,
          "title": "Minimum Absolute Train Objective Improvement",
          "type": "number"
        },
        "minimum_confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Minimum Confidence",
          "type": "number"
        },
        "minimum_holdout_correspondences": {
          "minimum": 4,
          "title": "Minimum Holdout Correspondences",
          "type": "integer"
        },
        "minimum_relative_train_objective_improvement": {
          "minimum": 0.0,
          "title": "Minimum Relative Train Objective Improvement",
          "type": "number"
        },
        "minimum_rotation_step_deg": {
          "exclusiveMinimum": 0.0,
          "title": "Minimum Rotation Step Deg",
          "type": "number"
        },
        "minimum_train_correspondences": {
          "minimum": 4,
          "title": "Minimum Train Correspondences",
          "type": "integer"
        },
        "minimum_translation_step_m": {
          "exclusiveMinimum": 0.0,
          "title": "Minimum Translation Step M",
          "type": "number"
        },
        "rotation_bound_deg": {
          "exclusiveMinimum": 0.0,
          "title": "Rotation Bound Deg",
          "type": "number"
        },
        "translation_bound_m": {
          "exclusiveMinimum": 0.0,
          "title": "Translation Bound M",
          "type": "number"
        },
        "use_covariance": {
          "const": true,
          "default": true,
          "title": "Use Covariance",
          "type": "boolean"
        },
        "use_outlier_probability": {
          "const": true,
          "default": true,
          "title": "Use Outlier Probability",
          "type": "boolean"
        },
        "use_reliability": {
          "const": true,
          "default": true,
          "title": "Use Reliability",
          "type": "boolean"
        }
      },
      "required": [
        "minimum_confidence",
        "holdout_ratio",
        "evaluation_split_seeds",
        "minimum_train_correspondences",
        "minimum_holdout_correspondences",
        "rotation_bound_deg",
        "translation_bound_m",
        "initial_rotation_step_deg",
        "initial_translation_step_m",
        "minimum_rotation_step_deg",
        "minimum_translation_step_m",
        "max_evaluations",
        "cauchy_scale",
        "minimum_absolute_train_objective_improvement",
        "minimum_relative_train_objective_improvement",
        "maximum_train_correspondence_loss_fraction",
        "maximum_accepted_bound_fraction"
      ],
      "title": "CameraLidarLockedRefinementOptions",
      "type": "object"
    },
    "CameraLidarPoseObservability": {
      "additionalProperties": false,
      "description": "Scale-normalized local six-DoF information diagnostics.",
      "properties": {
        "axis_information_fraction": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Axis Information Fraction",
          "type": "object"
        },
        "condition_number": {
          "anyOf": [
            {
              "minimum": 1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition Number"
        },
        "factor_count": {
          "minimum": 0,
          "title": "Factor Count",
          "type": "integer"
        },
        "parameter_order": {
          "items": {
            "enum": [
              "rx",
              "ry",
              "rz",
              "tx",
              "ty",
              "tz"
            ],
            "type": "string"
          },
          "title": "Parameter Order",
          "type": "array"
        },
        "parameter_scales": {
          "items": {
            "type": "number"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Parameter Scales",
          "type": "array"
        },
        "rank": {
          "maximum": 6,
          "minimum": 0,
          "title": "Rank",
          "type": "integer"
        },
        "singular_values": {
          "items": {
            "type": "number"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Singular Values",
          "type": "array"
        },
        "weak_axes": {
          "items": {
            "enum": [
              "rx",
              "ry",
              "rz",
              "tx",
              "ty",
              "tz"
            ],
            "type": "string"
          },
          "title": "Weak Axes",
          "type": "array"
        }
      },
      "required": [
        "parameter_order",
        "parameter_scales",
        "factor_count",
        "singular_values",
        "rank",
        "axis_information_fraction",
        "weak_axes"
      ],
      "title": "CameraLidarPoseObservability",
      "type": "object"
    },
    "CorrespondenceProviderIdentity": {
      "additionalProperties": false,
      "description": "Identity and redistribution boundary of the external provider.",
      "properties": {
        "checkpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/DepthFileReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "checkpoint_redistribution": {
          "title": "Checkpoint Redistribution",
          "type": "string"
        },
        "license_spdx": {
          "title": "License Spdx",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "source_commit": {
          "title": "Source Commit",
          "type": "string"
        },
        "source_repository": {
          "title": "Source Repository",
          "type": "string"
        },
        "training": {
          "anyOf": [
            {
              "$ref": "#/$defs/CorrespondenceTrainingDeclaration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "version",
        "source_repository",
        "source_commit",
        "license_spdx",
        "checkpoint_redistribution"
      ],
      "title": "CorrespondenceProviderIdentity",
      "type": "object"
    },
    "CorrespondenceTrainingDeclaration": {
      "additionalProperties": false,
      "description": "Training-corpus relationship for a learned correspondence provider.",
      "properties": {
        "evaluation_overlap": {
          "enum": [
            "none",
            "possible",
            "confirmed",
            "unknown"
          ],
          "title": "Evaluation Overlap",
          "type": "string"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        },
        "test_data_used_for_online_refinement": {
          "title": "Test Data Used For Online Refinement",
          "type": "boolean"
        },
        "training_datasets": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Training Datasets",
          "type": "array"
        }
      },
      "required": [
        "training_datasets",
        "evaluation_overlap",
        "test_data_used_for_online_refinement",
        "evidence"
      ],
      "title": "CorrespondenceTrainingDeclaration",
      "type": "object"
    },
    "DepthFileReference": {
      "additionalProperties": false,
      "description": "Content-addressed depth-provider input or output file.",
      "properties": {
        "encoding": {
          "title": "Encoding",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "encoding"
      ],
      "title": "DepthFileReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Development-only sweep and immutable runtime option selection.",
  "properties": {
    "calibration_holdout_ratio": {
      "exclusiveMaximum": 1.0,
      "exclusiveMinimum": 0.0,
      "title": "Calibration Holdout Ratio",
      "type": "number"
